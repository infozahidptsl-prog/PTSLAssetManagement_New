@code {
    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = "h-4 w-4";

    private bool IsCategory(params string[] targets)
    {
        if (string.IsNullOrWhiteSpace(Category)) return false;
        var cat = Category.Trim();
        foreach (var t in targets)
        {
            if (string.Equals(cat, t, StringComparison.OrdinalIgnoreCase)) return true;
            if (cat.Contains(t, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }
}
