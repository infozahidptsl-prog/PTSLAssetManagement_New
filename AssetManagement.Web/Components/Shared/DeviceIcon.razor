@using AssetManagement.Core.Enums

@if (IsCategory("Laptop", "Notebook", "MacBook"))
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Laptop"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>
}
else if (IsCategory("Desktop", "PC", "System Unit", "Tower", "Workstation", "Mobile", "Phone", "Smartphone", "Tablet"))
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Desktop"><rect width="14" height="18" x="5" y="3" rx="2" ry="2"/><line x1="9" x2="15" y1="7" y2="7"/><line x1="9" x2="15" y1="11" y2="11"/><line x1="9" x2="11" y1="15" y2="15"/></svg>
}
else if (IsCategory("Monitor", "Display", "Screen"))
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Monitor"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
}
else if (IsCategory("Mobile", "Phone", "Smartphone", "Tablet", "iPad"))
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Mobile"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>
}
else if (IsCategory("Peripheral", "Keyboard", "Mouse", "Headphone", "Headset", "Accessory"))
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Peripheral"><rect width="12" height="18" x="6" y="3" rx="6"/><path d="M12 3v7"/><path d="M6 10h12"/></svg>
}
else
{
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@CssClass" title="Device"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/></svg>
}

@code {
    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = "h-4 w-4";

    private bool IsCategory(params string[] targets)
    {
        if (string.IsNullOrWhiteSpace(Category)) return false;
        return targets.Any(t => string.Equals(Category.Trim(), t, StringComparison.OrdinalIgnoreCase));
    }
}
