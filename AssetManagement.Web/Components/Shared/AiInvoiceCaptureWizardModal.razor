@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Core.Interfaces
@using AssetManagement.Infrastructure.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IOcrService OcrService
@inject IAiDocumentExtractionService AiService
@inject IAiFieldMappingService FieldMappingService
@inject IAiValidationService ValidationService
@inject PurchaseService PurchaseService
@inject DeviceService DeviceService
@inject ISettingsService SettingsService
@inject NotificationService Notifications
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

@if (IsOpen)
{
    <style>
        @@media print {
            body * {
                visibility: hidden !important;
            }
            #wizard-printable-qr-sheet, #wizard-printable-qr-sheet * {
                visibility: visible !important;
            }
            #wizard-printable-qr-sheet {
                position: absolute !important;
                left: 0 !important;
                top: 0 !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 16px !important;
                background: white !important;
                color: black !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>

    <div class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 no-print" 
         style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(6px);">
        
        <div class="w-full flex flex-col rounded-2xl bg-surface shadow-2xl relative mx-auto border border-line-soft overflow-hidden" 
             style="max-width: 980px; height: 92vh; max-height: 900px;">
            
            <!-- Modal Header with Progress Stepper -->
            <div class="px-6 py-4 border-b border-line-soft bg-elevated/40 shrink-0">
                <div class="flex items-center justify-between pb-3">
                    <div class="flex items-center gap-3">
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white shadow-sm"
                             style="background: linear-gradient(135deg, #059669 0%, #0d9488 50%, #0891b2 100%);">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-bold text-txt-hi">AI Invoice Capture &amp; Purchase Entry Wizard</h2>
                                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">
                                    Step @currentStep of 4
                                </span>
                            </div>
                            <p class="text-xs text-txt-mid">Guided journey: Upload invoice document ➔ Verify extracted data ➔ Tag physical units ➔ Enter into inventory</p>
                        </div>
                    </div>
                    <button type="button" @onclick="CloseAsync" class="rounded-lg p-1.5 text-txt-mid hover:bg-elevated hover:text-txt-hi transition-colors border border-line-soft">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>

                <!-- Stepper Bar -->
                <div class="relative flex items-center justify-between pt-2 px-2 sm:px-6">
                    <div class="absolute left-6 right-6 top-6 -translate-y-1/2 h-1 bg-line rounded-full z-0"></div>
                    <div class="absolute left-6 top-6 -translate-y-1/2 h-1 bg-emerald-500 rounded-full transition-all duration-300 z-0" 
                         style="width: calc(@(StepProgressPercent)% * 0.88);"></div>

                    <!-- Step 1 -->
                    <div class="relative z-10 flex flex-col items-center cursor-pointer select-none" @onclick="() => GoToStep(1)">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs transition-all @(currentStep > 1 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 1 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 1) { <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> } else { <span>1</span> }
                        </div>
                        <span class="mt-1 text-[11px] font-bold @(currentStep == 1 ? "text-accent-600" : currentStep > 1 ? "text-emerald-600" : "text-txt-lo")">1. Upload Invoice</span>
                    </div>

                    <!-- Step 2 -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep >= 2 ? "cursor-pointer" : "cursor-not-allowed") select-none" @onclick="() => GoToStep(2)">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs transition-all @(currentStep > 2 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 2 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 2) { <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> } else { <span>2</span> }
                        </div>
                        <span class="mt-1 text-[11px] font-bold @(currentStep == 2 ? "text-accent-600" : currentStep > 2 ? "text-emerald-600" : "text-txt-lo")">2. Review &amp; Verify</span>
                    </div>

                    <!-- Step 3 -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep >= 3 ? "cursor-pointer" : "cursor-not-allowed") select-none" @onclick="() => GoToStep(3)">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs transition-all @(currentStep > 3 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 3 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 3) { <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> } else { <span>3</span> }
                        </div>
                        <span class="mt-1 text-[11px] font-bold @(currentStep == 3 ? "text-accent-600" : currentStep > 3 ? "text-emerald-600" : "text-txt-lo")">3. Tag Asset Serials</span>
                    </div>

                    <!-- Step 4 -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep == 4 ? "cursor-pointer" : "cursor-not-allowed") select-none">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs transition-all @(currentStep == 4 ? "bg-emerald-600 text-white shadow-md ring-4 ring-emerald-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep == 4) { <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg> } else { <span>4</span> }
                        </div>
                        <span class="mt-1 text-[11px] font-bold @(currentStep == 4 ? "text-emerald-600" : "text-txt-lo")">4. Complete &amp; QR Labels</span>
                    </div>
                </div>
            </div>

            <!-- Scrollable Modal Body -->
            <div class="flex-1 overflow-y-auto px-6 py-5">
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 p-3 text-xs text-red-800 flex items-start justify-between">
                        <div class="flex items-center gap-2">
                            <svg class="w-4 h-4 shrink-0 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path d="m15 9-6 6m0-6 6 6" stroke-width="2"/></svg>
                            <span>@errorMessage</span>
                        </div>
                        <button type="button" @onclick="() => errorMessage = null" class="text-red-500 hover:text-red-700">✕</button>
                    </div>
                }

                @* ==========================================
                   STEP 1: UPLOAD INVOICE
                   ========================================== *@
                @if (currentStep == 1)
                {
                    <div class="space-y-6">
                        <!-- Guidance Banner -->
                        <div class="rounded-xl border border-accent-200 bg-accent-soft/40 p-4 flex items-start gap-3">
                            <div class="p-2 rounded-lg bg-accent-100 text-accent-700 shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-accent-800 uppercase tracking-wider">Step 1: Upload Invoice Document</h3>
                                <p class="text-xs text-txt-mid mt-0.5 leading-relaxed">
                                    Drop your supplier invoice or delivery challan (PDF or Image) below. Our dynamic OCR and AI will automatically extract the supplier, invoice number, purchase date, line items, specifications, and costs.
                                </p>
                            </div>
                        </div>

                        @if (isAnalyzing)
                        {
                            <!-- AI Scanning Visualizer -->
                            <div class="rounded-2xl border border-line bg-elevated/40 p-10 flex flex-col items-center justify-center text-center space-y-4">
                                <div class="relative w-16 h-16">
                                    <div class="absolute inset-0 rounded-full border-4 border-accent-200 animate-ping opacity-30"></div>
                                    <div class="w-16 h-16 rounded-full border-4 border-accent-500 border-t-transparent animate-spin flex items-center justify-center"></div>
                                    <div class="absolute inset-0 flex items-center justify-center text-accent-600">
                                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                                    </div>
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-txt-hi">AI Intelligence Engine Processing...</h4>
                                    <p class="text-xs text-txt-mid mt-1">@analyzingStatusText</p>
                                </div>
                                <div class="w-64 h-1.5 bg-line rounded-full overflow-hidden">
                                    <div class="h-full bg-accent-500 rounded-full animate-pulse" style="width: 75%;"></div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Upload Dropzone -->
                            <div class="relative rounded-2xl border-2 border-dashed border-line-strong hover:border-accent-500 bg-canvas/50 hover:bg-accent-soft/10 p-8 sm:p-12 text-center transition-all cursor-pointer group">
                                <InputFile OnChange="HandleFilesSelected" multiple accept=".pdf,.png,.jpg,.jpeg,.webp" 
                                           class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10" />
                                
                                <div class="flex flex-col items-center justify-center pointer-events-none">
                                    <div class="w-14 h-14 rounded-2xl bg-accent-soft text-accent-600 flex items-center justify-center mb-3 group-hover:scale-110 group-hover:bg-accent-100 transition-all shadow-sm">
                                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    </div>
                                    <h4 class="text-sm font-bold text-txt-hi group-hover:text-accent-600 transition-colors">
                                        Click to browse or drag &amp; drop invoice here
                                    </h4>
                                    <p class="text-xs text-txt-mid mt-1">Supports PDF invoices, scanned challans, PNG, JPG (up to 15MB)</p>
                                </div>
                            </div>

                            <!-- Alternate Test Option: Try Sample Invoice -->
                            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 p-4 rounded-xl border border-line bg-elevated/30">
                                <div class="flex items-center gap-2 text-xs text-txt-mid">
                                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span>Don't have an invoice PDF right now? Test with pre-extracted sample data:</span>
                                </div>
                                <button type="button" @onclick="LoadSampleInvoice" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-line hover:border-accent-400 bg-surface hover:bg-elevated text-xs font-semibold text-txt-hi transition-colors shadow-xs">
                                    <svg class="w-3.5 h-3.5 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                                    <span>Load Sample Purchase Invoice</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                @* STEP 2: REVIEW & VERIFY PURCHASE DETAILS *@
                @if (currentStep == 2 && purchaseForm != null)
                {
                    <div class="space-y-6">
                        <!-- Guidance Banner -->
                        <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4 flex items-start gap-3">
                            <div class="p-2 rounded-lg bg-emerald-100 text-emerald-700 shrink-0">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <div>
                                <h3 class="text-xs font-bold text-emerald-800 uppercase tracking-wider">Step 2: Review &amp; Verify AI Extraction</h3>
                                <p class="text-xs text-txt-mid mt-0.5 leading-relaxed">
                                    Verify the vendor, invoice number, items, and quantities below. You can adjust details before committing to the purchase inventory.
                                </p>
                            </div>
                        </div>

                        <!-- Purchase Info Cards -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-txt-lo mb-1">Supplier / Vendor *</label>
                                <input type="text" @bind="purchaseForm.Supplier" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-line bg-surface focus:outline-none focus:border-accent-500" placeholder="e.g. Star Tech Ltd." />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-txt-lo mb-1">Invoice / Challan # *</label>
                                <input type="text" @bind="purchaseForm.InvoiceNumber" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-line bg-surface focus:outline-none focus:border-accent-500" placeholder="e.g. INV-98421" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-txt-lo mb-1">Purchase Date</label>
                                <input type="date" @bind="purchaseForm.PurchaseDate" class="w-full text-xs font-semibold px-3 py-2 rounded-lg border border-line bg-surface focus:outline-none focus:border-accent-500" />
                            </div>
                            <div>
                                <label class="block text-[11px] font-bold uppercase tracking-wider text-txt-lo mb-1">System PO Number</label>
                                <input type="text" @bind="purchaseForm.PurchaseNumber" readonly class="w-full text-xs font-mono font-bold px-3 py-2 rounded-lg border border-line bg-elevated text-txt-mid" />
                            </div>
                        </div>

                        <!-- Extracted Items Table -->
                        <div class="rounded-xl border border-line bg-surface overflow-hidden shadow-xs">
                            <div class="px-4 py-3 bg-elevated/50 border-b border-line flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <h4 class="text-xs font-bold uppercase tracking-wider text-txt-hi">Line Items Extracted (@purchaseForm.Items.Count)</h4>
                                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">
                                        Total Units: @purchaseForm.Items.Sum(i => i.Quantity ?? 0)
                                    </span>
                                </div>
                                <button type="button" @onclick="AddItemRow" class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg bg-surface border border-line hover:bg-elevated text-txt-hi transition-colors">
                                    + Add Item
                                </button>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="border-b border-line bg-canvas/40 text-[10px] uppercase tracking-wider text-txt-lo font-bold">
                                        <tr>
                                            <th class="py-2.5 px-3">Category</th>
                                            <th class="py-2.5 px-3">Brand</th>
                                            <th class="py-2.5 px-3">Model / Specification</th>
                                            <th class="py-2.5 px-3 w-20 text-center">Qty</th>
                                            <th class="py-2.5 px-3 w-28 text-right">Unit Cost</th>
                                            <th class="py-2.5 px-3 w-28 text-right">Subtotal</th>
                                            <th class="py-2.5 px-2 w-10"></th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft">
                                        @foreach (var item in purchaseForm.Items)
                                        {
                                            <tr class="hover:bg-elevated/20 transition-colors">
                                                <td class="py-2 px-3">
                                                    <select @bind="item.Category" class="w-full text-xs py-1 px-2 rounded border border-line bg-surface">
                                                        @foreach (var cat in availableCategoryNames)
                                                        {
                                                            <option value="@cat">@cat</option>
                                                        }
                                                    </select>
                                                </td>
                                                <td class="py-2 px-3">
                                                    <input type="text" @bind="item.Manufacturer" placeholder="Brand" class="w-full text-xs py-1 px-2 rounded border border-line bg-surface" />
                                                </td>
                                                <td class="py-2 px-3">
                                                    <input type="text" @bind="item.ModelName" placeholder="Model or description" class="w-full text-xs font-medium py-1 px-2 rounded border border-line bg-surface" />
                                                </td>
                                                <td class="py-2 px-3 text-center">
                                                    <input type="number" min="1" @bind="item.Quantity" class="w-16 text-center text-xs py-1 px-1 rounded border border-line bg-surface font-bold" />
                                                </td>
                                                <td class="py-2 px-3 text-right">
                                                    <input type="number" step="0.01" min="0" @bind="item.UnitCost" class="w-24 text-right text-xs py-1 px-2 rounded border border-line bg-surface font-mono" />
                                                </td>
                                                <td class="py-2 px-3 text-right font-mono font-bold text-txt-hi">
                                                    @String.Format(new System.Globalization.CultureInfo("bn-BD"), "{0:C0}", (item.Quantity ?? 0) * (item.UnitCost ?? 0m))
                                                </td>
                                                <td class="py-2 px-2 text-center">
                                                    <button type="button" @onclick="() => RemoveItem(item)" class="text-txt-lo hover:text-red-600 transition-colors">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="border-t border-line bg-elevated/40 font-bold">
                                        <tr>
                                            <td colspan="3" class="py-2.5 px-3 text-right text-txt-lo text-[11px] uppercase tracking-wider">Total Purchase Value:</td>
                                            <td class="py-2.5 px-3 text-center text-xs font-bold text-accent-700">@purchaseForm.Items.Sum(i => i.Quantity ?? 0)</td>
                                            <td></td>
                                            <td class="py-2.5 px-3 text-right font-mono text-sm text-emerald-700">
                                                @String.Format(new System.Globalization.CultureInfo("bn-BD"), "{0:C0}", CalculatedSum)
                                            </td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>

                        <!-- Step 2 Bottom Actions -->
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-line-soft">
                            <button type="button" @onclick="() => currentStep = 1" class="w-full sm:w-auto px-4 py-2 rounded-xl border border-line bg-surface hover:bg-elevated text-xs font-semibold text-txt-mid transition-colors">
                                ← Back to Upload
                            </button>
                            <div class="flex items-center gap-2 w-full sm:w-auto">
                                <button type="button" @onclick="SaveDirectToStoreOnly" disabled="@isPosting" class="flex-1 sm:flex-none px-4 py-2 rounded-xl border border-line bg-surface hover:bg-elevated text-xs font-semibold text-txt-hi transition-colors shadow-xs">
                                    Save to Store Only (Skip Tagging)
                                </button>
                                <button type="button" @onclick="SavePurchaseAndProceedToTagging" disabled="@isPosting" class="flex-1 sm:flex-none px-5 py-2 rounded-xl bg-accent-500 hover:bg-accent-600 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center gap-1.5">
                                    @if (isPosting)
                                    {
                                        <div class="w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                                        <span>Saving...</span>
                                    }
                                    else
                                    {
                                        <span>Save &amp; Continue to Tag Assets ➔</span>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @* STEP 3: FAST BULK TAGGING OF PHYSICAL UNITS *@
                @if (currentStep == 3)
                {
                    <div class="space-y-6">
                        <!-- Guidance Banner -->
                        <div class="rounded-xl border border-blue-200 bg-blue-50/50 p-4 flex items-start justify-between gap-3">
                            <div class="flex items-start gap-3">
                                <div class="p-2 rounded-lg bg-blue-100 text-blue-700 shrink-0">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-xs font-bold text-blue-800 uppercase tracking-wider">Step 3: Fast Tag Physical Asset Units</h3>
                                    <p class="text-xs text-txt-mid mt-0.5 leading-relaxed">
                                        Sequential Asset Tags are pre-allocated automatically. Enter serial numbers for physical units, or paste a list of serials. Any untagged units will safely stay in store.
                                    </p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800 shrink-0">
                                @unitTagEntries.Count Units
                            </span>
                        </div>

                        <!-- Batch Defaults & Quick Paste Toolbar -->
                        <div class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl border border-line bg-elevated/40">
                            <div class="flex flex-wrap items-center gap-2">
                                <button type="button" @onclick="() => showBulkSerialModal = true" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-accent-soft hover:bg-accent-100 text-accent-700 border border-accent-300 text-xs font-bold transition-colors shadow-xs">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                    <span>Paste Serials List</span>
                                </button>
                                <div class="h-4 w-px bg-line"></div>
                                <div class="flex items-center gap-1.5 text-xs text-txt-mid">
                                    <span>Default Location:</span>
