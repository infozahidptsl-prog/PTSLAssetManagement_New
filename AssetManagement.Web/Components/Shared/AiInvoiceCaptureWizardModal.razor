                                        @foreach (var loc in officeLocations)
                                        {
                                            <option value="@loc">@loc</option>
                                        }
                                    </select>
                                </div>
                                <div class="flex items-center gap-1.5 text-xs text-txt-mid">
                                    <span>Owner Company:</span>
                                    <select @bind="batchDefaultCompany" @bind:after="ApplyBatchCompany" class="text-xs py-1 px-2 rounded-md border border-line bg-surface text-txt-hi font-medium">
                                        @foreach (var comp in ownerCompanies)
                                        {
                                            <option value="@comp">@comp</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="text-xs text-txt-mid font-medium">
                                <span class="font-bold text-emerald-700">@unitTagEntries.Count(u => !string.IsNullOrWhiteSpace(u.SerialNumber))</span> of @unitTagEntries.Count serials entered
                            </div>
                        </div>

                        <!-- Bulk Unit Tagging Grid -->
                        <div class="rounded-xl border border-line bg-surface overflow-hidden shadow-xs">
                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-xs">
                                    <thead class="border-b border-line bg-canvas/40 text-[10px] uppercase tracking-wider text-txt-lo font-bold">
                                        <tr>
                                            <th class="py-2.5 px-3 w-12 text-center">#</th>
                                            <th class="py-2.5 px-3">Item / Model</th>
