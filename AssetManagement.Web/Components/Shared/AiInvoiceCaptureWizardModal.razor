                                <button type="button" @onclick="SkipAndFinishStep3" disabled="@isRegisteringUnits" class="flex-1 sm:flex-none px-4 py-2 rounded-xl border border-line bg-surface hover:bg-elevated text-xs font-semibold text-txt-hi transition-colors shadow-xs">
