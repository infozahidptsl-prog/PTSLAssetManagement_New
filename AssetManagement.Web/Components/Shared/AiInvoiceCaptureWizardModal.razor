    private static string InferCategory(string? desc, string? model)
    {
        var text = $"{desc} {model}".ToLowerInvariant();
        if (text.Contains("switch") || text.Contains("catalyst") || text.Contains("sfp") || text.Contains("router") || text.Contains("gateway"))
            return "Network Switch";
        if (text.Contains("access point") || text.Contains("wifi") || text.Contains("ap") || text.Contains("cbw"))
            return "Access Point";
        if (text.Contains("laptop") || text.Contains("expertbook") || text.Contains("thinkpad") || text.Contains("latitude") || text.Contains("notebook") || text.Contains("macbook"))
            return "Laptop";
        if (text.Contains("desktop") || text.Contains("workstation") || text.Contains("optiplex") || text.Contains("tower"))
            return "Desktop";
        if (text.Contains("monitor") || text.Contains("display") || text.Contains("screen") || text.Contains("led") || text.Contains("lcd") || text.Contains("k202"))
            return "Monitor";
        if (text.Contains("ssd") || text.Contains("ram") || text.Contains("hdd") || text.Contains("drive") || text.Contains("memory"))
            return "Component";
        if (text.Contains("server"))
            return "Server";
        return "IT Equipment";
    }
