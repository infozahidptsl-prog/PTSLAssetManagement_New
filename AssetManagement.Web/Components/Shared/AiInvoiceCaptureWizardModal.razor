                }

                @* STEP 4: CELEBRATION & READY-TO-PRINT QR LABELS *@
                @if (currentStep == 4)
                {
                    <div class="space-y-6">
                        <!-- Celebration Success Card -->
                        <div class="rounded-2xl border border-emerald-200 bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 p-6 shadow-sm">
                            <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 text-center sm:text-left">
                                <div class="w-14 h-14 rounded-2xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-md">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                </div>
                                <div class="space-y-1">
                                    <h3 class="text-base font-bold text-emerald-950">Purchase Successfully Entered into Inventory!</h3>
                                    <p class="text-xs text-emerald-800 leading-relaxed">
                                        Purchase <strong>#@(savedPurchase?.PurchaseNumber ?? purchaseForm?.PurchaseNumber ?? "—")</strong> from <strong>@(savedPurchase?.Supplier ?? purchaseForm?.Supplier ?? "—")</strong> is committed. Physical asset records have been generated.
                                    </p>
                                    <div class="flex flex-wrap items-center gap-3 pt-2">
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-200/80 text-emerald-900">
                                            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                                            @registeredUnitsList.Count Physical Assets Tagged &amp; Active
                                        </span>
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-200/80 text-slate-800">
                                            @((savedPurchase?.Items.Sum(i => i.RemainingQuantity) ?? 0)) Units Remaining in Store
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Printable QR Labels Sheet -->
                        @if (registeredUnitsList.Any())
                        {
                            <div class="rounded-xl border border-line bg-surface p-5 space-y-4">
                                <div class="flex items-center justify-between pb-3 border-b border-line-soft">
                                    <div>
                                        <h4 class="text-xs font-bold uppercase tracking-wider text-txt-hi">Printable Asset QR Sticker Labels (@registeredUnitsList.Count)</h4>
                                        <p class="text-xs text-txt-mid mt-0.5">High-contrast scannable QR labels ready for physical labeling.</p>
                                    </div>
                                    <button type="button" @onclick="PrintQrLabels" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-accent-500 hover:bg-accent-600 text-white text-xs font-bold shadow-sm transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                                        <span>Print QR Sticker Labels</span>
                                    </button>
                                </div>

                                <div id="wizard-printable-qr-sheet" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
                                    @foreach (var dev in registeredUnitsList)
                                    {
                                        <div class="rounded-xl border border-line p-3 bg-surface text-txt-hi space-y-2 shadow-xs">
                                            <div class="flex items-start justify-between gap-2">
                                                <div>
                                                    <div class="text-[10px] font-bold uppercase tracking-wider text-txt-lo">@dev.OwnerCompany</div>
                                                    <div class="text-xs font-mono font-black text-accent-700">@dev.AssetTag</div>
                                                    <div class="text-xs font-bold text-txt-hi truncate max-w-[140px]">@dev.Brand @dev.DeviceName</div>
                                                    <div class="text-[10px] text-txt-mid font-mono truncate max-w-[140px]">SN: @dev.Serial</div>
                                                    <div class="text-[10px] text-txt-lo">Loc: @dev.Location</div>
                                                </div>
                                                <div class="bg-white p-1 rounded-lg border border-line shrink-0">
                                                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&margin=2&data=@(Uri.EscapeDataString(dev.AssetTag ?? dev.Serial ?? ""))" alt="Asset QR" class="w-14 h-14 object-contain" />
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- Final Completion Button -->
                        <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3 border-t border-line-soft">
                            <button type="button" @onclick="ResetWizard" class="w-full sm:w-auto px-4 py-2 rounded-xl border border-line bg-surface hover:bg-elevated text-xs font-semibold text-txt-mid transition-colors">
                                + Process Another Invoice
                            </button>
                            <button type="button" @onclick="CompleteAndCloseAsync" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-md transition-all flex items-center justify-center gap-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Done &amp; View in Purchases Table</span>
                            </button>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- Quick Paste Serials Modal -->
    @if (showBulkSerialModal)
    {
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
            <div class="w-full max-w-md rounded-2xl bg-surface border border-line shadow-2xl p-6 space-y-4">
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-bold text-txt-hi">Quick Paste Serials List</h3>
                    <button type="button" @onclick="() => showBulkSerialModal = false" class="text-txt-mid hover:text-txt-hi">✕</button>
                </div>
                <p class="text-xs text-txt-mid">Paste a multi-line list of serial numbers. They will be assigned to untagged units from top to bottom.</p>
                <textarea @bind="bulkSerialPasteText" rows="6" class="w-full text-xs font-mono p-3 rounded-xl border border-line bg-surface focus:outline-none focus:border-accent-500" placeholder="SN-100234&#10;SN-100235&#10;SN-100236"></textarea>
                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" @onclick="() => showBulkSerialModal = false" class="px-3 py-1.5 rounded-lg border border-line text-xs font-semibold text-txt-mid">Cancel</button>
                    <button type="button" @onclick="ApplyBulkSerials" class="px-4 py-1.5 rounded-lg bg-accent-500 hover:bg-accent-600 text-white text-xs font-bold">Apply Serials</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public bool IsOpen { get; set; } = false;
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public EventCallback<Purchase?> OnPurchaseCompleted { get; set; }

    private int currentStep = 1;
    private bool isAnalyzing = false;
    private string analyzingStatusText = "Extracting text with OCR...";
    private bool isPosting = false;
    private bool isRegisteringUnits = false;
    private string? errorMessage;

    private int StepProgressPercent => currentStep switch
    {
        1 => 0,
        2 => 33,
        3 => 66,
        4 => 100,
        _ => 0
    };

    private Purchase? purchaseForm;
    private Purchase? savedPurchase;
    private List<UnitTagEntry> unitTagEntries = new();
    private List<Device> registeredUnitsList = new();
    private bool showBulkSerialModal = false;
    private string bulkSerialPasteText = "";

    private string batchDefaultLocation = "TK Bhaban";
    private string batchDefaultCompany = "PrimeTech Solutions Ltd.";
    private List<string> officeLocations = new() { "TK Bhaban", "BSEC Bhaban" };
    private List<string> ownerCompanies = new() { "PrimeTech Solutions Ltd." };
    private List<string> availableCategoryNames = new() { "Laptop", "Desktop", "Monitor", "Network Switch", "Access Point", "Server", "Component", "IT Equipment", "Printer", "UPS" };

    public class UnitTagEntry
    {
        public string UnitKey { get; set; } = Guid.NewGuid().ToString("N");
        public string PurchaseItemId { get; set; } = "";
        public string LineItemDescription { get; set; } = "";
        public int UnitIndex { get; set; }
        public int TotalUnitsForItem { get; set; }
        public string Brand { get; set; } = "";
        public string ModelName { get; set; } = "";
        public string Category { get; set; } = "Laptop";
        public string AssetTag { get; set; } = "";
        public string SerialNumber { get; set; } = "";
        public string Location { get; set; } = "TK Bhaban";
        public string OwnerCompany { get; set; } = "PrimeTech Solutions Ltd.";
        public string Condition { get; set; } = "New";
        public int? WarrantyMonths { get; set; } = 12;
    }

    private class FileUploadInfo
    {
        public string Name { get; set; } = "";
        public byte[] Bytes { get; set; } = Array.Empty<byte>();
        public string ContentType { get; set; } = "";
    }
    private List<FileUploadInfo> uploadedFiles = new();

    private decimal CalculatedSum => purchaseForm?.Items.Sum(i => (i.Quantity ?? 0) * (i.UnitCost ?? 0m)) ?? 0m;

    protected override async Task OnInitializedAsync()
    {
        await LoadLookupDataAsync();
    }

    private async Task LoadLookupDataAsync()
    {
        try
        {
            var locs = await SettingsService.GetLocationsAsync();
            if (locs != null && locs.Any())
            {
                officeLocations = locs.Select(l => l.Name).ToList();
                if (officeLocations.Any()) batchDefaultLocation = officeLocations.First();
            }

            var comps = await SettingsService.GetOwnerCompaniesAsync();
            if (comps != null && comps.Any())
            {
                ownerCompanies = comps.Select(c => c.Name).ToList();
                if (ownerCompanies.Any()) batchDefaultCompany = ownerCompanies.First();
            }

            var cats = await SettingsService.GetCategoriesAsync();
            if (cats != null && cats.Any())
            {
                availableCategoryNames = cats.Select(c => c.Name).Distinct().ToList();
            }
        }
        catch { }
    }

    private void GoToStep(int step)
    {
        if (step < currentStep)
        {
            currentStep = step;
            StateHasChanged();
        }
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task CompleteAndCloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
        await OnPurchaseCompleted.InvokeAsync(savedPurchase ?? purchaseForm);
    }

    private void ResetWizard()
    {
        currentStep = 1;
        purchaseForm = null;
        savedPurchase = null;
        unitTagEntries.Clear();
        registeredUnitsList.Clear();
        uploadedFiles.Clear();
        errorMessage = null;
    }

    private void LoadSampleInvoice()
    {
        purchaseForm = new Purchase
        {
            PurchaseNumber = "PUR-" + DateTime.Now.ToString("yyMMdd") + new Random().Next(100, 999),
            Supplier = "Smart Technologies (BD) Ltd.",
            InvoiceNumber = "STBL-INV-" + new Random().Next(10000, 99999),
            PurchaseDate = DateTime.Today,
            Notes = "Captured via AI Purchase Capture Wizard"
        };

        purchaseForm.Items = new List<PurchaseItem>
        {
            new PurchaseItem
            {
                PurchaseId = purchaseForm.Id,
                Category = "Laptop",
                Manufacturer = "Dell",
                ModelName = "Latitude 5420 Core i5 11th Gen 16GB 512GB SSD",
                Quantity = 3,
                UnitCost = 85000m,
                CandidateSerial = "DELL-LAT-5420-A1, DELL-LAT-5420-A2, DELL-LAT-5420-A3"
            },
            new PurchaseItem
            {
                PurchaseId = purchaseForm.Id,
                Category = "Monitor",
                Manufacturer = "Dell",
                ModelName = "P2422H 24-inch Full HD IPS Monitor",
                Quantity = 2,
                UnitCost = 22000m,
                CandidateSerial = "DELL-MON-P24-01, DELL-MON-P24-02"
            }
        };

        currentStep = 2;
        Notifications.ShowSuccess("Sample invoice loaded successfully. Review line items below.");
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        uploadedFiles.Clear();

        var files = e.GetMultipleFiles(5);
        foreach (var file in files)
        {
            if (file.Size > 15 * 1024 * 1024)
            {
                errorMessage = $"File '{file.Name}' exceeds 15MB limit.";
                continue;
            }

            using var ms = new MemoryStream();
            await file.OpenReadStream(15 * 1024 * 1024).CopyToAsync(ms);
            uploadedFiles.Add(new FileUploadInfo
            {
                Name = file.Name,
                Bytes = ms.ToArray(),
                ContentType = file.ContentType
            });
        }

        if (uploadedFiles.Any())
        {
            await ProcessUploadedDocumentsAsync();
        }
    }

    private async Task ProcessUploadedDocumentsAsync()
    {
        isAnalyzing = true;
        analyzingStatusText = "Extracting text with OCR...";
        StateHasChanged();

        try
        {
            string fullOcrText = "";
            string firstBase64 = "";

            foreach (var file in uploadedFiles)
            {
                using var stream = new MemoryStream(file.Bytes);
                var ocrRes = await OcrService.ExtractTextAsync(stream, file.Name, file.ContentType);
                if (ocrRes.IsSuccess && !string.IsNullOrWhiteSpace(ocrRes.Text))
                {
                    fullOcrText += ocrRes.Text + "\n\n";
                }

                if (string.IsNullOrEmpty(firstBase64) && !file.ContentType.Contains("pdf"))
                {
                    firstBase64 = Convert.ToBase64String(file.Bytes);
                }
            }

            if (string.IsNullOrEmpty(firstBase64) && uploadedFiles.Any())
            {
                firstBase64 = Convert.ToBase64String(uploadedFiles.First().Bytes);
            }

            analyzingStatusText = "AI extracting vendor, line items, and hardware specs...";
            StateHasChanged();

            var aiResult = await AiService.ExtractDocumentAsync(fullOcrText, firstBase64);
            var mapped = await FieldMappingService.MapPurchaseAsync(aiResult);

            purchaseForm = new Purchase
            {
                PurchaseNumber = "PUR-" + DateTime.Now.ToString("yyMMdd") + new Random().Next(100, 999),
                Supplier = !string.IsNullOrWhiteSpace(mapped.Data?.Vendor) ? mapped.Data.Vendor : (!string.IsNullOrWhiteSpace(aiResult.Vendor) ? aiResult.Vendor : "Supplier From Invoice"),
                InvoiceNumber = !string.IsNullOrWhiteSpace(mapped.Data?.InvoiceNumber) ? mapped.Data.InvoiceNumber : (!string.IsNullOrWhiteSpace(aiResult.InvoiceNumber) ? aiResult.InvoiceNumber : ("INV-" + DateTime.Now.ToString("MMdd"))),
                PurchaseDate = mapped.Data?.InvoiceDate ?? aiResult.DocumentDate ?? DateTime.Today,
                Notes = "Captured via AI Purchase Capture Wizard"
            };

            if (mapped.Data?.Items != null && mapped.Data.Items.Any())
            {
                purchaseForm.Items = mapped.Data.Items.Select(i => new PurchaseItem
                {
                    PurchaseId = purchaseForm.Id,
                    Category = InferCategory(i.Description, i.Model),
                    Manufacturer = i.Manufacturer ?? "",
                    ModelName = !string.IsNullOrWhiteSpace(i.Model) ? $"{i.Description} ({i.Model})" : i.Description ?? "Item",
                    Quantity = i.Quantity > 0 ? i.Quantity : 1,
                    UnitCost = i.UnitPrice,
                    CandidateSerial = (i.SerialNumbers != null && i.SerialNumbers.Any()) ? string.Join(", ", i.SerialNumbers) : (i.SerialNumber ?? "")
                }).ToList();
            }
            else
            {
                purchaseForm.Items = new List<PurchaseItem>
                {
                    new PurchaseItem
                    {
                        PurchaseId = purchaseForm.Id,
                        Category = "Laptop",
                        Manufacturer = aiResult.Manufacturer ?? "",
                        ModelName = aiResult.Model ?? "System Item",
                        Quantity = 1,
                        UnitCost = 0m
                    }
                };
            }

            currentStep = 2;
            Notifications.ShowSuccess("Invoice parsed successfully! Please review details.");
        }
        catch (Exception ex)
        {
            errorMessage = $"AI Processing Error: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged();
        }
    }

    private void AddItemRow()
    {
        if (purchaseForm == null) return;
        purchaseForm.Items.Add(new PurchaseItem
        {
            PurchaseId = purchaseForm.Id,
            Category = "Laptop",
            Manufacturer = "",
            ModelName = "",
            Quantity = 1,
            UnitCost = 0m
        });
    }

    private void RemoveItem(PurchaseItem item)
    {
        if (purchaseForm == null) return;
        purchaseForm.Items.Remove(item);
    }

    private async Task SaveDirectToStoreOnly()
    {
        await CommitPurchaseAsync();
        if (errorMessage == null)
        {
            currentStep = 4;
            Notifications.ShowSuccess("Purchase entered into store inventory! Physical units can be tagged later.");
        }
    }

    private async Task SavePurchaseAndProceedToTagging()
    {
        await CommitPurchaseAsync();
        if (errorMessage == null && savedPurchase != null)
        {
            await InitializeUnitTagEntriesAsync(savedPurchase);
            currentStep = 3;
        }
    }

    private async Task CommitPurchaseAsync()
    {
        if (purchaseForm == null) return;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(purchaseForm.Supplier))
        {
            errorMessage = "Supplier / Vendor name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(purchaseForm.InvoiceNumber))
        {
            errorMessage = "Invoice number is required.";
            return;
        }
        if (!purchaseForm.Items.Any())
        {
            errorMessage = "At least one item is required.";
            return;
        }

        isPosting = true;
        StateHasChanged();

        try
        {
            if (uploadedFiles.Any() && string.IsNullOrEmpty(purchaseForm.InvoiceFilePath))
            {
                var uploadsDir = Path.Combine(Env.WebRootPath, "uploads", "invoices");
                Directory.CreateDirectory(uploadsDir);
                var savedPaths = new List<string>();

                foreach (var upFile in uploadedFiles)
                {
                    var ext = Path.GetExtension(upFile.Name);
                    if (string.IsNullOrEmpty(ext)) ext = upFile.ContentType.Contains("pdf") ? ".pdf" : ".png";
                    var safeName = $"{purchaseForm.PurchaseNumber}_{Guid.NewGuid().ToString("N").Substring(0, 8)}{ext}";
                    var fullPath = Path.Combine(uploadsDir, safeName);
                    await File.WriteAllBytesAsync(fullPath, upFile.Bytes);
                    savedPaths.Add($"/uploads/invoices/{safeName}");
                }

                if (savedPaths.Any())
                {
                    purchaseForm.InvoiceFilePath = string.Join("|", savedPaths);
                }
            }

            await PurchaseService.AddPurchaseAsync(purchaseForm);
            savedPurchase = await PurchaseService.GetPurchaseByIdAsync(purchaseForm.Id);
            Notifications.ShowSuccess($"Purchase #{purchaseForm.PurchaseNumber} committed to database.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving purchase: {ex.Message}";
        }
        finally
        {
            isPosting = false;
            StateHasChanged();
        }
    }

    private async Task InitializeUnitTagEntriesAsync(Purchase p)
    {
        unitTagEntries.Clear();
        var usedTagsInBatch = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in p.Items)
        {
            var remainingQty = item.RemainingQuantity;
            if (remainingQty <= 0) continue;

            var candidateList = (item.CandidateSerial ?? "")
                .Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(s => s.Trim())
                .ToList();

            for (int i = 1; i <= remainingQty; i++)
            {
                var dummyDevice = new Device
                {
                    Category = item.Category,
                    OwnerCompany = batchDefaultCompany,
                    Brand = item.Manufacturer,
                    DeviceName = item.ModelName
                };

                string allocatedTag = "";
                try
                {
                    allocatedTag = await DeviceService.GenerateAssetTagAsync(dummyDevice);
                    int bump = 1;
                    while (usedTagsInBatch.Contains(allocatedTag))
                    {
                        var parts = allocatedTag.Split('-');
                        if (parts.Length > 1 && int.TryParse(parts.Last(), out int seq))
                        {
                            var prefix = string.Join("-", parts.Take(parts.Length - 1));
                            allocatedTag = $"{prefix}-{(seq + bump):D3}";
                        }
                        else
                        {
                            allocatedTag = $"{allocatedTag}-{bump}";
                        }
                        bump++;
                    }
                    usedTagsInBatch.Add(allocatedTag);
                }
                catch
                {
                    allocatedTag = $"TAG-{Guid.NewGuid().ToString("N").Substring(0, 6).ToUpper()}";
                }

                string candidateSerial = (i - 1) < candidateList.Count ? candidateList[i - 1] : "";

                unitTagEntries.Add(new UnitTagEntry
                {
                    PurchaseItemId = item.Id,
                    LineItemDescription = $"{item.Manufacturer} {item.ModelName}".Trim(),
                    UnitIndex = i,
                    TotalUnitsForItem = remainingQty,
                    Brand = item.Manufacturer ?? "",
                    ModelName = item.ModelName ?? "",
                    Category = item.Category ?? "Laptop",
                    AssetTag = allocatedTag,
                    SerialNumber = candidateSerial,
                    Location = batchDefaultLocation,
                    OwnerCompany = batchDefaultCompany,
                    Condition = "New",
                    WarrantyMonths = item.WarrantyMonths ?? 12
                });
            }
        }
    }

    private void ApplyBatchLocation()
    {
        foreach (var entry in unitTagEntries)
        {
            entry.Location = batchDefaultLocation;
        }
    }

    private void ApplyBatchCompany()
    {
        foreach (var entry in unitTagEntries)
        {
            entry.OwnerCompany = batchDefaultCompany;
        }
    }

    private void ApplyBulkSerials()
    {
        if (string.IsNullOrWhiteSpace(bulkSerialPasteText))
        {
            showBulkSerialModal = false;
            return;
        }

        var lines = bulkSerialPasteText
            .Split(new[] { '\n', '\r', ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();

        int targetIndex = 0;
        foreach (var serial in lines)
        {
            while (targetIndex < unitTagEntries.Count && !string.IsNullOrWhiteSpace(unitTagEntries[targetIndex].SerialNumber))
            {
                targetIndex++;
            }

            if (targetIndex < unitTagEntries.Count)
            {
                unitTagEntries[targetIndex].SerialNumber = serial;
                targetIndex++;
            }
            else break;
        }

        showBulkSerialModal = false;
        bulkSerialPasteText = "";
        Notifications.ShowSuccess($"Applied {Math.Min(lines.Count, unitTagEntries.Count)} serials to units.");
    }

    private async Task RegisterTaggedUnits()
    {
        var readyEntries = unitTagEntries
            .Where(u => !string.IsNullOrWhiteSpace(u.SerialNumber))
            .ToList();

        if (!readyEntries.Any())
        {
            errorMessage = "No units have a serial number entered. Enter at least one serial number, or click 'Skip Untagged & Keep in Store'.";
            return;
        }

        isRegisteringUnits = true;
        errorMessage = null;
        StateHasChanged();

        int successCount = 0;
        var newRegisteredList = new List<Device>();

        try
        {
            foreach (var entry in readyEntries)
            {
                var dev = new Device
                {
                    Id = Guid.NewGuid().ToString(),
                    AssetTag = entry.AssetTag,
                    Serial = entry.SerialNumber.Trim(),
                    Brand = entry.Brand,
                    DeviceName = entry.ModelName,
                    Category = entry.Category,
                    Location = entry.Location,
                    OwnerCompany = entry.OwnerCompany,
                    Condition = entry.Condition,
                    Status = DeviceStatus.InStore,
                    HasWarranty = (entry.WarrantyMonths ?? 0) > 0,
                    WarrantyMonths = entry.WarrantyMonths ?? 12,
                    ProcurementDate = savedPurchase?.PurchaseDate ?? DateTime.Today,
                    ReceivedDate = DateTime.Today.ToString("yyyy-MM-dd"),
                    PurchaseItemId = entry.PurchaseItemId,
                    Note = $"Purchased under PO #{savedPurchase?.PurchaseNumber} - Inv #{savedPurchase?.InvoiceNumber}"
                };

                try
                {
                    var created = await DeviceService.RegisterPhysicalAssetFromPurchaseAsync(dev, entry.PurchaseItemId);
                    newRegisteredList.Add(created);
                    successCount++;
                }
                catch (Exception ex)
                {
                    Notifications.ShowWarning($"Unit {entry.AssetTag} ({entry.SerialNumber}) skipped: {ex.Message}");
                }
            }

            registeredUnitsList = newRegisteredList;
            if (savedPurchase != null)
            {
                savedPurchase = await PurchaseService.GetPurchaseByIdAsync(savedPurchase.Id);
            }

            currentStep = 4;
            Notifications.ShowSuccess($"Registered {successCount} physical assets! They are now active in inventory.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error registering units: {ex.Message}";
        }
        finally
        {
            isRegisteringUnits = false;
            StateHasChanged();
        }
    }

    private async Task SkipAndFinishStep3()
    {
        if (savedPurchase != null)
        {
            savedPurchase = await PurchaseService.GetPurchaseByIdAsync(savedPurchase.Id);
        }
        currentStep = 4;
        Notifications.ShowInfo("Untagged units kept safely in store inventory.");
        StateHasChanged();
    }

