<section aria-label="Quick actions" class="mt-7">
    <h2 class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">
        Do it in one step
    </h2>
    <ul class="mt-3 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        
        <li>
            <button type="button" @onclick='() => OnActionClicked.InvokeAsync("receive")' class="group flex h-full w-full flex-col gap-3 rounded-2xl border border-line-soft bg-surface p-4 text-left transition-colors duration-150 hover:border-accent-border hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
                <span class="flex items-center justify-between gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent-soft text-accent-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 17V3"/><path d="m6 11 6 6 6-6"/><path d="M19 21H5"/></svg>
                    </span>
                    <span class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">Step 1</span>
                </span>
                <span>
                    <span class="block text-sm font-semibold text-txt-hi">Add new purchase</span>
                    <span class="mt-1 block text-xs leading-relaxed text-txt-mid">New system, component or peripheral — gets an Asset ID and QR tag</span>
                </span>
            </button>
        </li>

        <li>
            <button type="button" @onclick='() => OnActionClicked.InvokeAsync("allocate")' class="group flex h-full w-full flex-col gap-3 rounded-2xl border border-line-soft bg-surface p-4 text-left transition-colors duration-150 hover:border-accent-border hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
                <span class="flex items-center justify-between gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent-soft text-accent-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 9-6-6-6 6"/><path d="M12 3v14"/><path d="M5 21h14"/></svg>
                    </span>
                    <span class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">Step 2</span>
                </span>
                <span>
                    <span class="block text-sm font-semibold text-txt-hi">Issue to employee</span>
                    <span class="mt-1 block text-xs leading-relaxed text-txt-mid">Hand to a new joiner, or swap out an existing machine</span>
                </span>
            </button>
        </li>

        <li>
            <button type="button" @onclick='() => OnActionClicked.InvokeAsync("return")' class="group flex h-full w-full flex-col gap-3 rounded-2xl border border-line-soft bg-surface p-4 text-left transition-colors duration-150 hover:border-accent-border hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
                <span class="flex items-center justify-between gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent-soft text-accent-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                    </span>
                    <span class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">Step 3</span>
                </span>
                <span>
                    <span class="block text-sm font-semibold text-txt-hi">Receive a return</span>
                    <span class="mt-1 block text-xs leading-relaxed text-txt-mid">Leaver hand-back or a fault, with a temporary system if needed</span>
                </span>
            </button>
        </li>

        <li>
            <button type="button" @onclick='() => OnActionClicked.InvokeAsync("repair")' class="group flex h-full w-full flex-col gap-3 rounded-2xl border border-line-soft bg-surface p-4 text-left transition-colors duration-150 hover:border-accent-border hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
                <span class="flex items-center justify-between gap-2">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-accent-soft text-accent-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    </span>
                    <span class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">Step 4</span>
                </span>
                <span>
                    <span class="block text-sm font-semibold text-txt-hi">Send to repair</span>
                    <span class="mt-1 block text-xs leading-relaxed text-txt-mid">Log the fault and vendor, then fix and return — or scrap it</span>
                </span>
            </button>
        </li>

    </ul>
</section>

@code {
    [Parameter]
    public EventCallback<string> OnActionClicked { get; set; }
}
