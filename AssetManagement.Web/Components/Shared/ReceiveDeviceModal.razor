@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Core.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
        <div class="w-full flex flex-col rounded-2xl bg-surface shadow-2xl relative mx-auto" style="max-width: 640px; max-height: 95vh;">
            
            <!-- Fixed Header -->
            <div class="px-6 pb-6 sm:px-8 shrink-0 relative border-b border-line-soft" style="padding-top: 1.5rem;">
                <button type="button" @onclick="CloseAsync" class="absolute right-5 top-5 rounded-lg p-1.5 text-txt-mid hover:bg-elevated hover:text-txt-hi transition-colors border border-line-soft">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
                <h2 class="text-xl font-semibold text-txt-hi pr-10">Add new purchase</h2>
                <p class="mt-2 text-[13px] text-txt-mid leading-relaxed pr-10 mb-0">
                    Systems, components and peripherals all enter here. A smart Asset ID is generated by default based on Category and Company, but you can override it manually if needed.
                </p>
            </div>

            <!-- Scrollable Body -->
            <div class="flex-1 overflow-y-auto px-6 pt-5 pb-6 sm:px-8 sm:pb-8">
                <EditForm Model="@newDevice" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                <div class="space-y-7 mt-2">
                <div>
                    <h3 class="inline-flex items-center rounded bg-blue-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-blue-600 mb-2 border border-blue-100 shadow-sm">General Information</h3>
                    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.5rem;">
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Item kind</label>
                        <select @bind="itemKind" class="@InputClass">
                            <option value="System">System</option>
                            <option value="Component">Component</option>
                            <option value="Peripheral">Peripheral</option>
                        </select>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Asset ID (Auto-generated if empty)</label>
                        <InputText @bind-Value="newDevice.AssetTag" placeholder="Leave empty for auto-generation" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Category</label>
                        <select @bind="newDevice.Category" class="@InputClass">
                            @if (availableCategories != null)
                            {
                                @foreach (var cat in availableCategories.Where(c => c.Type == itemKind))
                                {
                                    <option value="@cat.Name">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Item model</label>
                        <InputText @bind-Value="newDevice.DeviceName" placeholder="Lenovo ThinkPad E14" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Brand</label>
                        <InputText @bind-Value="newDevice.Brand" placeholder="Lenovo" class="@InputClass" />
                    </div>

                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Serial number</label>
                        <InputText @bind-Value="newDevice.Serial" placeholder="PF5DQ426" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Supplier</label>
                        <InputText @bind-Value="newDevice.From" placeholder="Global Brand" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Owner / Company <span class="text-danger-500">*</span></label>
                        <InputSelect @bind-Value="newDevice.OwnerCompany" class="@InputClass">
                            <option value="">Select Owner Company</option>
                            @foreach(var oc in ownerCompanies)
                            {
                                <option value="@oc.Name">@oc.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Office / Location</label>
                        <InputSelect @bind-Value="newDevice.Location" class="@InputClass">
                            <option value="">Select Office Location</option>
                            @foreach(var loc in locations)
                            {
                                <option value="@loc.Name">@loc.Name</option>
                            }
                        </InputSelect>
                    </div>
                    @if (itemKind == "System" || newDevice.DeviceTypeDisplay == "System")
                    {
                        <div>
                            <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Device Name</label>
                            <InputText @bind-Value="newDevice.ComputerName" placeholder="e.g. PTSL-LAPTOP-01" class="@InputClass" />
                        </div>
                    }
                    @if (newDevice.DeviceTypeDisplay == "System" && (newDevice.Category?.ToLowerInvariant().Contains("mobile") == true || newDevice.Category?.ToLowerInvariant().Contains("phone") == true || newDevice.Category?.ToLowerInvariant().Contains("tablet") == true))
                    {
                        <div>
                            <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">IMEI</label>
                            <InputText @bind-Value="newDevice.Imei" placeholder="IMEI number" class="@InputClass" />
                        </div>
                    }
                    else if (newDevice.DeviceTypeDisplay == "System")
                    {
                        <div>
                            <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">MAC Address</label>
                            <InputText @bind-Value="newDevice.MacAddress" placeholder="MAC Address" class="@InputClass" />
                        </div>
                    }
                </div>
                </div>

                <div>
                    <h3 class="inline-flex items-center rounded bg-emerald-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-600 mb-2 border border-emerald-100 shadow-sm">Specifications</h3>
                    <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.5rem;" class="items-end">
                    <div class="flex flex-col justify-end h-full">
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label1</label>
                        <InputText @bind-Value="newDevice.Processor" placeholder="@Placeholder1" class="@InputClass" />
                    </div>
                    <div class="flex flex-col justify-end h-full">
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label2</label>
                        <InputText @bind-Value="RamString" @bind-Value:after="StateHasChanged" placeholder="@Placeholder2" class="@InputClass" />
                    </div>
                    <div class="flex flex-col justify-end h-full">
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label3</label>
                        <InputText @bind-Value="SsdString" @bind-Value:after="StateHasChanged" placeholder="@Placeholder3" class="@InputClass" />
                    </div>
                    <div class="flex flex-col justify-end h-full">
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label4</label>
                        <InputText @bind-Value="HddString" @bind-Value:after="StateHasChanged" placeholder="@Placeholder4" class="@InputClass" />
                    </div>
                    </div>
                </div>

                <div>
                    <h3 class="inline-flex items-center rounded bg-purple-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-purple-600 mb-2 border border-purple-100 shadow-sm">Purchase Details</h3>
                    <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.5rem;">
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Purchase date</label>
                        <InputText type="date" @bind-Value="procDateStr" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Cost (BDT)</label>
                        <InputNumber @bind-Value="newDevice.AssetAmount" placeholder="125000" class="@InputClass" />
                    </div>
                    <div>
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Warranty (Months)</label>
                        <InputNumber @bind-Value="newDevice.WarrantyMonths" placeholder="24" class="@InputClass" />
                    </div>
                    </div>
                    <div class="mt-3">
                        <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Note</label>
                        <InputTextArea @bind-Value="newDevice.Note" rows="3" placeholder="PO number, project, or storage location" class="@InputClass" style="min-height: 80px;" />
                    </div>
                </div>

                <div>
                    <h3 class="inline-flex items-center rounded bg-orange-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-orange-600 mb-2 border border-orange-100 shadow-sm">Invoice Details</h3>
                    <!-- Invoice Upload -->
                <div>
                    <label class="mb-1.5 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Purchase invoice / bill</label>
                    @if (uploadedInvoices.Any())
                    {
                        <div class="mt-2 flex flex-col gap-2">
                            @foreach (var inv in uploadedInvoices)
                            {
                                <div class="flex items-center gap-3 bg-elevated/50 p-2 rounded-lg border border-line-soft">
                                    <div class="relative group shrink-0 overflow-hidden rounded-lg border border-line-soft bg-elevated" style="width: 50px; height: 50px; min-width: 50px;">
                                        @if (inv.IsPdf)
                                        {
                                            <div class="flex h-full w-full flex-col items-center justify-center gap-0.5">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                <span class="text-[8px] font-bold text-red-500">PDF</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <img src="@inv.Path" alt="Invoice preview" style="width: 100%; height: 100%; object-fit: cover;" />
                                        }
                                    </div>
                                    <div class="flex flex-col gap-1 flex-1 min-w-0">
                                        <span class="text-[11px] text-txt-hi truncate">@inv.FileName</span>
                                        <button type="button" @onclick="() => RemoveInvoice(inv)" class="text-[10px] text-red-500 hover:text-red-600 text-left transition-colors">Remove</button>
                                    </div>
                                </div>
                            }
                        </div>
                        <label class="mt-2 flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed border-line-soft bg-elevated/30 px-3 py-2 transition-colors hover:border-accent-border hover:bg-elevated">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-txt-lo"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                            <span class="text-[11px] text-txt-mid">Add another invoice</span>
                            <InputFile OnChange="HandleInvoiceUpload" multiple accept=".jpg,.jpeg,.png,.pdf" class="sr-only" />
                        </label>
                    }
                    else
                    {
                        <label class="mt-1 flex cursor-pointer items-center gap-3 rounded-lg border border-dashed border-line-soft bg-elevated/50 px-4 py-3.5 transition-colors hover:border-accent-border hover:bg-elevated">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-txt-lo"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            <span class="text-[12px] text-txt-mid">Click to upload invoice(s) <span class="text-txt-lo">(JPG, PNG or PDF)</span></span>
                            <InputFile OnChange="HandleInvoiceUpload" multiple accept=".jpg,.jpeg,.png,.pdf" class="sr-only" />
                        </label>
                    }
                </div>
                </div>
                </div>

                <div class="mt-8 flex justify-end gap-3 pt-2">
                    <button type="button" @onclick="CloseAsync" class="rounded-lg border border-line bg-surface px-5 py-2.5 text-[13px] font-medium text-txt-hi hover:bg-elevated transition-colors">
                        Cancel
                    </button>
                    <button type="submit" class="rounded-lg bg-[#8b8cf8] px-5 py-2.5 text-[13px] font-medium text-white shadow-sm transition-colors duration-150 hover:bg-[#7879f1] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#8b8cf8]">
                        Add to inventory
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>
}

@code {
    private string Label1 => newDevice.DeviceTypeDisplay == "System" ? "Processor" : (newDevice.DeviceTypeDisplay == "Component" ? "Component Type" : (newDevice.Category == "Monitor" ? "Panel/Display Type" : "Interface/Type"));
    private string Placeholder1 => newDevice.DeviceTypeDisplay == "System" ? "Intel i5 (13th Gen)" : (newDevice.DeviceTypeDisplay == "Component" ? "DDR4 / NVMe" : (newDevice.Category == "Monitor" ? "IPS / LED" : "USB / Wireless"));

    private string Label2 => newDevice.DeviceTypeDisplay == "System" ? "RAM" : (newDevice.DeviceTypeDisplay == "Component" ? "Capacity/Speed" : (newDevice.Category == "Monitor" ? "Size (e.g. 24\")" : "Key Spec (e.g. Layout)"));
    private string Placeholder2 => newDevice.DeviceTypeDisplay == "System" ? "16GB" : (newDevice.DeviceTypeDisplay == "Component" ? "16GB 3200MHz" : (newDevice.Category == "Monitor" ? "24\"" : "Mechanical / 1000 DPI"));

    private string Label3 => newDevice.DeviceTypeDisplay == "System" ? "SSD" : (newDevice.DeviceTypeDisplay == "Component" ? "Form Factor" : (newDevice.Category == "Monitor" ? "Resolution/Refresh" : "Color/Material"));
    private string Placeholder3 => newDevice.DeviceTypeDisplay == "System" ? "512GB" : (newDevice.DeviceTypeDisplay == "Component" ? "M.2 / 2.5\"" : (newDevice.Category == "Monitor" ? "1080p / 75Hz" : "Black / ABS"));

    private string Label4 => newDevice.DeviceTypeDisplay == "System" ? "HDD" : (newDevice.DeviceTypeDisplay == "Component" ? "Generation/Extra" : (newDevice.Category == "Monitor" ? "Mounting" : "Weight/Extra"));
    private string Placeholder4 => newDevice.DeviceTypeDisplay == "System" ? "1TB" : (newDevice.DeviceTypeDisplay == "Component" ? "Gen4 / RGB" : (newDevice.Category == "Monitor" ? "VESA" : "Extra"));
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<Device> OnReceived { get; set; }

    private IEnumerable<DeviceCategoryModel>? availableCategories;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            availableCategories = await SettingsService.GetCategoriesAsync();
        }
    }

    private string _itemKind = "System";
    private string itemKind
    {
        get => _itemKind;
        set
        {
            if (_itemKind != value)
            {
                _itemKind = value;
                if (value == "System") newDevice.Category = "Laptop";
                else if (value == "Component") newDevice.Category = "RAM";
                else if (value == "Peripheral") newDevice.Category = "Monitor";
            }
        }
    }
    
    private string procDateStr
    {
        get => newDevice.ProcurementDate?.ToString("yyyy-MM-dd") ?? "";
        set 
        {
            if (DateTime.TryParse(value, out var d))
                newDevice.ProcurementDate = d.Date.Add(DateTime.Now.TimeOfDay);
            else
                newDevice.ProcurementDate = null;
        }
    }

    private Device newDevice = new Device 
    { 
        Category = "Laptop",
        Status = DeviceStatus.InStore,
        OwnerCompany = "PrimeTech Solutions Ltd.",
        ProcurementDate = DateTime.Now
    };

    private class UploadedInvoice
    {
        public string Path { get; set; } = "";
        public string FileName { get; set; } = "";
        public bool IsPdf { get; set; }
    }
    
    private List<UploadedInvoice> uploadedInvoices = new();

    private string InputClass = "w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200";

    private IEnumerable<OwnerCompany> ownerCompanies = new List<OwnerCompany>();
    private IEnumerable<Location> locations = new List<Location>();

    private AssetManagement.Web.Helpers.MonitorSpec monitorSpec = new AssetManagement.Web.Helpers.MonitorSpec();

    private string MonitorBrand { get => monitorSpec.Brand; set => monitorSpec.Brand = value; }
    private string MonitorModel { get => monitorSpec.Model; set => monitorSpec.Model = value; }
    private string MonitorSize { get => monitorSpec.Size; set => monitorSpec.Size = value; }
    private string MonitorSerial { get => monitorSpec.Serial; set => monitorSpec.Serial = value; }

    private void UpdateMonitorDisplay()
    {
        newDevice.MonitorDisplay = AssetManagement.Web.Helpers.MonitorSpecHelper.Build(monitorSpec);
        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        ownerCompanies = await SettingsService.GetOwnerCompaniesAsync();
        locations = await SettingsService.GetLocationsAsync();
        var defaultCompany = ownerCompanies.FirstOrDefault(c => c.Name.Contains("Prime", StringComparison.OrdinalIgnoreCase))?.Name 
            ?? ownerCompanies.FirstOrDefault()?.Name 
            ?? "PrimeTech Solutions Ltd.";
        if (string.IsNullOrWhiteSpace(newDevice.OwnerCompany) || newDevice.OwnerCompany == "PTSL")
        {
            newDevice.OwnerCompany = defaultCompany;
        }
    }

    private async Task HandleInvoiceUpload(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            var isPdf = file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

            // Save to disk
            var uploadsDir = Path.Combine(Env.WebRootPath, "uploads", "invoices");
            Directory.CreateDirectory(uploadsDir);
            var uniqueName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var fullPath = Path.Combine(uploadsDir, uniqueName);
            await using var fs = new FileStream(fullPath, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
            
            uploadedInvoices.Add(new UploadedInvoice
            {
                Path = $"/uploads/invoices/{uniqueName}",
                FileName = file.Name,
                IsPdf = isPdf
            });
        }
    }

    private void RemoveInvoice(UploadedInvoice inv)
    {
        uploadedInvoices.Remove(inv);
    }

    private void ClearInvoice()
    {
        uploadedInvoices.Clear();
    }

    private async Task HandleSubmit()
    {
        newDevice.IsComponent = itemKind == "Component";
        if (itemKind != "System" && newDevice.DeviceTypeDisplay != "System")
        {
            newDevice.ComputerName = null;
        }
        if (newDevice.WarrantyMonths > 0) newDevice.HasWarranty = true;
        
        newDevice.InvoiceFilePath = uploadedInvoices.Any() 
            ? string.Join("|", uploadedInvoices.Select(i => i.Path)) 
            : null;

        if (!newDevice.ProcurementDate.HasValue)
        {
            newDevice.ProcurementDate = DateTime.Now;
        }
        
        await OnReceived.InvokeAsync(newDevice);
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
        var defaultCompany = ownerCompanies.FirstOrDefault(c => c.Name.Contains("Prime", StringComparison.OrdinalIgnoreCase))?.Name 
            ?? ownerCompanies.FirstOrDefault()?.Name 
            ?? "PrimeTech Solutions Ltd.";
        newDevice = new Device 
        { 
            Category = "Laptop",
            Status = DeviceStatus.InStore,
            OwnerCompany = defaultCompany,
            ProcurementDate = DateTime.Now
        };
        monitorSpec = new AssetManagement.Web.Helpers.MonitorSpec();
        itemKind = "System";
        ClearInvoice();
    }

    private string RamString
    {
        get => newDevice.Ram ?? "";
        set => newDevice.Ram = FormatStorage(value, newDevice.Category == "Monitor");
    }

    private string SsdString
    {
        get => newDevice.Ssd ?? "";
        set => newDevice.Ssd = FormatStorage(value, false);
    }

    private string HddString
    {
        get => newDevice.Hdd ?? "";
        set => newDevice.Hdd = FormatStorage(value, false);
    }

    private string FormatStorage(string input, bool isSize)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        var trimmed = input.Trim();
        if (trimmed.All(c => char.IsDigit(c) || c == '.'))
        {
            if (isSize) return trimmed + "\"";
            if (newDevice.Category != "Monitor") return trimmed + " GB";
        }
        return input;
    }
}




