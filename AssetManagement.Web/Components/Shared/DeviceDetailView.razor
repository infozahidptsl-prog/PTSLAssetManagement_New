                                <InputText @bind-Value="device.DeviceName" placeholder="e.g. FB10CS, ThinkPad E14" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
