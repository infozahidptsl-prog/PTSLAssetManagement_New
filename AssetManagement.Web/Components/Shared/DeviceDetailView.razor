    private string GetCleanItemModel(Device d)
    {
        if (string.IsNullOrWhiteSpace(d.DeviceName)) return "N/A";
        var model = d.DeviceName.Trim();
        if (!string.IsNullOrWhiteSpace(d.Brand))
        {
            var brand = d.Brand.Trim();
            if (model.StartsWith(brand, StringComparison.OrdinalIgnoreCase))
            {
                var stripped = model.Substring(brand.Length).TrimStart(' ', '-', ':', '/');
                if (!string.IsNullOrWhiteSpace(stripped)) return stripped;
            }
        }
        return model;
    }

    private string GetDeviceDisplayName(Device d)
    {
        if (string.IsNullOrWhiteSpace(d.Brand)) return string.IsNullOrWhiteSpace(d.DeviceName) ? "Unknown Asset" : d.DeviceName;
        if (string.IsNullOrWhiteSpace(d.DeviceName)) return d.Brand;
        if (d.DeviceName.Trim().StartsWith(d.Brand.Trim(), StringComparison.OrdinalIgnoreCase))
            return d.DeviceName.Trim();
        return $"{d.Brand} {d.DeviceName}".Trim();
    }

    private void OpenEditModal()
    {
        if (device != null)
        {
            editItemKind = device.IsComponent ? "Component" : (device.DeviceTypeDisplay == "System" ? "System" : "Peripheral");
            var defaultCompany = availableOwnerCompanies.FirstOrDefault(c => c.Name.Contains("Prime", StringComparison.OrdinalIgnoreCase))?.Name 
                ?? availableOwnerCompanies.FirstOrDefault()?.Name 
                ?? "PrimeTech Solutions Ltd.";
            if (string.IsNullOrWhiteSpace(device.OwnerCompany) || device.OwnerCompany.Equals("PTSL", StringComparison.OrdinalIgnoreCase))
            {
                device.OwnerCompany = defaultCompany;
            }
            var compPrefix = availableOwnerCompanies.FirstOrDefault(c => c.Name == device.OwnerCompany)?.Prefix?.Trim() 
                ?? (device.OwnerCompany.Contains("Prime", StringComparison.OrdinalIgnoreCase) ? "PSL" : "");
            if (!string.IsNullOrEmpty(compPrefix) && !string.IsNullOrEmpty(device.AssetTag) && !device.AssetTag.StartsWith($"{compPrefix}-", StringComparison.OrdinalIgnoreCase))
            {
                device.AssetTag = $"{compPrefix}-{device.AssetTag}";
            }
            originalDeviceJson = System.Text.Json.JsonSerializer.Serialize(device, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles });
        }
        showEditModal = true;
    }

