    private bool markOldUserLeft = false;

    private async Task SubmitTransfer()
    {
        if (device == null) return;
        
        string oldUserName = !string.IsNullOrEmpty(device.UserName) 
            ? device.UserName 
            : (!string.IsNullOrEmpty(device.From) ? device.From : "IT inventory");

        // If they want to offboard the old user, do it first, excluding this device so it is transferred cleanly
        if (markOldUserLeft && !string.IsNullOrEmpty(device.UserName))
        {
            string? employeeDbId = null;
            var emp = employees?.FirstOrDefault(e => e.Name == device.UserName);
            if (emp != null) 
            {
                employeeDbId = emp.Id;
            }
            else if (!string.IsNullOrEmpty(device.EmployeeId))
            {
                employeeDbId = device.EmployeeId;
            }
            
            if (!string.IsNullOrEmpty(employeeDbId))
            {
                await EmployeeService.OffboardEmployeeAsync(employeeDbId, device.Id);
            }
        }

        // Proceed with the actual device transfer/unassign
        await DeviceService.TransferDeviceAsync(device.Id, transferAction, newAssignmentData, oldUserName);
        
        CloseTransferModal();
        await OnInitializedAsync();
        if (OnStateChanged.HasDelegate) await OnStateChanged.InvokeAsync();
    }

