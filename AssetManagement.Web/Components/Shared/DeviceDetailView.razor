    private string FormatStorage(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return input;
        var trimmed = input.Trim();
        if (trimmed.All(c => char.IsDigit(c) || c == '.'))
        {
            return trimmed + " GB";
        }
        return input;
    }

    private readonly Dictionary<string, string> _deviceQrCache = new();

    private string GetDeviceQrImageUrl(Device d)
    {
        if (string.IsNullOrEmpty(d.Id)) return string.Empty;
        
        if (!_deviceQrCache.TryGetValue(d.Id, out var token))
        {
            token = AssetManagement.Web.Helpers.SecurityHelper.GenerateSecureRandomToken();
            var hash = AssetManagement.Web.Helpers.SecurityHelper.HashToken(token);
            d.QrTokenHash = hash;
            d.QrTokenCreatedAt = DateTime.UtcNow;
            d.QrTokenRevokedAt = null;
            d.QrTokenVersion++;
            _ = DeviceService.UpdateDeviceAsync(d);
            _deviceQrCache[d.Id] = token;
        }
        var deepLink = AssetManagement.Web.Helpers.NetworkHelper.ToScannableUri(NavigationManager.BaseUri, "/a/" + token);
        return $"https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=2&data={Uri.EscapeDataString(deepLink)}";
    }

    private static (string badgeClass, string dotClass) GetConditionBadgeClass(string? condition)
    {
        var cond = string.IsNullOrWhiteSpace(condition) ? "Good" : condition.Trim();
        var lower = cond.ToLowerInvariant();
        if (lower.Contains("new")) return ("bg-teal-50 text-teal-700 ring-1 ring-inset ring-teal-600/20", "bg-teal-500");
        if (lower.Contains("problem") || lower.Contains("issue")) return ("bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-600/20", "bg-amber-500");
        if (lower.Contains("good") || lower.Contains("excellent")) return ("bg-emerald-50 text-emerald-700 ring-1 ring-inset ring-emerald-600/20", "bg-emerald-500");
        if (lower.Contains("fair") || lower.Contains("moderate") || lower.Contains("average")) return ("bg-amber-50 text-amber-800 ring-1 ring-inset ring-amber-600/20", "bg-amber-500");
        if (lower.Contains("poor") || lower.Contains("bad") || lower.Contains("worn") || lower.Contains("slow") || lower.Contains("old")) return ("bg-rose-50 text-rose-700 ring-1 ring-inset ring-rose-600/20", "bg-rose-600");
        if (lower.Contains("fault") || lower.Contains("damage") || lower.Contains("broken") || lower.Contains("dead") || lower.Contains("defect") || lower.Contains("fail")) return ("bg-red-50 text-red-700 ring-1 ring-inset ring-red-200", "bg-red-600");
        return ("bg-blue-50 text-blue-700 ring-1 ring-inset ring-blue-600/20", "bg-accent-500");
    }
