                            <div class="flex items-center">
                                <label class="flex items-center gap-2 mt-4 text-[11px] font-semibold uppercase tracking-widest text-txt-lo cursor-pointer">
                                    <InputCheckbox @bind-Value="device.HasWarranty" class="rounded text-accent-500 focus:ring-accent-500 h-4 w-4 border-line" />
                                    Device has warranty
                                </label>
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">MAC Address</label>
                                <InputText @bind-Value="device.MacAddress" placeholder="e.g. 00:1B:44:11:3A:B7" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">IMEI</label>
                                <InputText @bind-Value="device.Imei" placeholder="e.g. 352099001761482" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                        </div>
                    </div>

                    <!-- Specifications -->
                    <div class="mb-10">
                        <h3 class="inline-flex items-center rounded bg-emerald-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1 border border-emerald-100 shadow-sm">Specifications</h3>
                        
                        <!-- Removed native datalists to fix styling issues -->

                        <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.25rem;" class="items-end">
                            <div class="flex flex-col justify-end h-full">
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label1</label>
                                <InputText @bind-Value="device.Processor" placeholder="@Placeholder1" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div class="flex flex-col justify-end h-full">
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label2</label>
                                <InputText @bind-Value="RamString" placeholder="@Placeholder2" @bind-Value:after="StateHasChanged" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div class="flex flex-col justify-end h-full">
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label3</label>
                                <InputText @bind-Value="SsdString" placeholder="@Placeholder3" @bind-Value:after="StateHasChanged" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            @if (device.DeviceTypeDisplay == "System" || device.DeviceTypeDisplay == "Component" || !string.IsNullOrEmpty(device.Hdd))
                            {
                                <div class="flex flex-col justify-end h-full">
                                    <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">@Label4</label>
                                    <InputText @bind-Value="HddString" placeholder="@Placeholder4" @bind-Value:after="StateHasChanged" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                                </div>
                            }
                            @if (device.Category != null && device.Category.Equals("Desktop", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="col-span-1 sm:col-span-2 mt-2 flex flex-col justify-end h-full">
                                    <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo leading-tight">Monitor Display / Specifications</label>
                                    <InputText @bind-Value="device.MonitorDisplay" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" placeholder="Dell 24 inch, Serial: XYZ..." />
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Assignment -->
                    <div class="mb-10">
                        <h3 class="inline-flex items-center rounded bg-purple-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-purple-600 mb-1 border border-purple-100 shadow-sm">Assignment Details</h3>
                        <div class="mb-2">
                            <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Auto-fill from Employee (Search)</label>
                            <div class="relative">
                                <input type="text" autocomplete="off" @bind="searchTermEdit" @bind:event="oninput" @onfocus="() => showEditDropdown = true" @onblur="HideEditDropdown" placeholder="Search by name or ID..." class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                                @if (showEditDropdown)
                                {
                                    <div class="absolute z-50 w-full mt-1 bg-surface border border-line rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                        @if (FilteredEditEmployees.Any())
                                        {
                                            @foreach (var emp in FilteredEditEmployees)
                                            {
                                                <div @onmousedown="() => SelectEditEmployee(emp)" class="px-3 py-2 text-sm text-txt-hi hover:bg-elevated cursor-pointer border-b border-line-soft last:border-0 transition-colors">
                                                    @emp.Name (@emp.EmployeeId)
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="px-3 py-2 text-sm text-txt-mid italic">No employees found...</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.25rem;">
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">User Name</label>
                                <InputText @bind-Value="device.UserName" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Employee ID</label>
                                <InputText @bind-Value="device.EmployeeId" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Designation</label>
                                <InputText @bind-Value="device.Designation" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Email</label>
                                <InputText @bind-Value="device.Email" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Contact</label>
                                <InputText @bind-Value="device.Contact" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                        </div>
                    </div>

                    <!-- Movement Record -->
                    <div class="mb-10">
                        <h3 class="inline-flex items-center rounded bg-orange-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-orange-600 mb-1 border border-orange-100 shadow-sm">Movement Record</h3>
                        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1rem; row-gap: 0.25rem;">
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Received Date</label>
                                <InputText type="date" @bind-Value="device.ReceivedDate" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Return Date</label>
                                <InputText type="date" @bind-Value="device.ReturnDate" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Condition</label>
                                <InputSelect @bind-Value="device.Condition" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200">
                                    <option value="">-- Select Condition --</option>
                                    <option value="New">New</option>
                                    <option value="Good">Good</option>
                                    <option value="Fair">Fair</option>
                                    <option value="Poor">Poor</option>
                                    <option value="Faulty">Faulty</option>
                                </InputSelect>
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Released</label>
                                <InputText type="date" @bind-Value="device.Released" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Handover From</label>
                                <InputText @bind-Value="device.From" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Handover To</label>
                                <InputText @bind-Value="device.To" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                            <div class="sm:col-span-2">
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Note</label>
                                <InputTextArea @bind-Value="device.Note" rows="2" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
                            </div>
                        </div>
                    </div>

                    <!-- Purchase Invoice -->
                    <div>
                        <h3 class="inline-flex items-center rounded bg-amber-50 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-700 mb-1 border border-amber-100 shadow-sm">Purchase Invoice / Bill</h3>
                        @if (!string.IsNullOrEmpty(device.InvoiceFilePath))
                        {
                            var invoicePaths = device.InvoiceFilePath.Split('|', StringSplitOptions.RemoveEmptyEntries);
                            <div class="flex flex-wrap items-center gap-4">
                                @foreach (var path in invoicePaths)
                                {
                                    var isPdf = path.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                    var fileName = System.IO.Path.GetFileName(path);
                                    <div class="flex items-center gap-3 bg-elevated/50 p-2 rounded-lg border border-line-soft">
                                        <button type="button" @onclick="() => { showEditInvoiceViewer = true; currentViewerPath = device.InvoiceFilePath; }" 
                                                class="group relative shrink-0 overflow-hidden rounded-lg border border-line-soft bg-elevated hover:border-accent-border hover:shadow-md transition-all" style="width: 50px; height: 50px; min-width: 50px; display: block; padding: 0;">
                                            @if (isPdf)
                                            {
                                                <div class="flex h-full w-full flex-col items-center justify-center gap-0.5">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                    <span class="text-[8px] font-bold text-red-500">PDF</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <img src="@path" alt="Invoice" style="width: 100%; height: 100%; object-fit: cover;" />
                                            }
                                            <div class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity rounded-lg">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                            </div>
                                        </button>
                                        <div class="flex flex-col gap-1 flex-1 min-w-0">
                                            <span class="text-[11px] text-txt-hi truncate max-w-[120px]">@fileName</span>
                                            <button type="button" @onclick="() => RemoveInvoicePath(path)"
                                                    class="text-[10px] text-red-500 hover:text-red-600 text-left transition-colors">
                                                Remove
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            <label class="mt-3 flex cursor-pointer items-center justify-center gap-2 rounded-lg border border-dashed border-line-soft bg-elevated/30 px-3 py-2 transition-colors hover:border-accent-border hover:bg-elevated">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-txt-lo"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                                <span class="text-[11px] text-txt-mid">Add another invoice</span>
                                <InputFile OnChange="HandleEditInvoiceUpload" multiple accept=".jpg,.jpeg,.png,.pdf" class="sr-only" />
                            </label>
                        }
                        else
                        {
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-dashed border-line-soft bg-elevated/50 px-4 py-3.5 transition-colors hover:border-accent-border hover:bg-elevated">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-txt-lo"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                <span class="text-[12px] text-txt-mid">Click to upload invoice(s) <span class="text-txt-lo">(JPG, PNG or PDF)</span></span>
                                <InputFile OnChange="HandleEditInvoiceUpload" multiple accept=".jpg,.jpeg,.png,.pdf" class="sr-only" />
                            </label>
                        }
                    </div>

                    <div class="pt-4 mt-6 border-t border-line-soft flex justify-end gap-3">
                        <button type="button" @onclick="CloseEditModal" class="rounded-lg px-4 py-2 text-sm font-medium text-txt-mid hover:bg-elevated hover:text-txt-hi transition-colors">Cancel</button>
                        <button type="submit" class="rounded-lg bg-accent-500 px-4 py-2 text-sm font-medium text-accent-on hover:bg-accent-600 transition-colors">Save changes</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

<InvoiceViewerModal @bind-IsOpen="showEditInvoiceViewer" FilePath="@currentViewerPath" />

@if (showTransferModal && device != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 whitespace-normal text-left">
        <div class="w-full rounded-xl border border-line bg-surface p-6 shadow-xl" style="max-width: 32rem;">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-txt-hi">@(device.Status == DeviceStatus.InUse ? "Transfer Device" : "Assign Device")</h2>
                <button type="button" @onclick="CloseTransferModal" class="text-txt-lo hover:text-txt-hi">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <div class="space-y-6">
                @if (!string.IsNullOrEmpty(device?.UserName))
                {
                    <div class="mb-4 flex items-start gap-3 rounded-lg border border-warn-200 bg-warn-50 px-3 py-2">
                        <div class="pt-0.5 shrink-0">
                            <input type="checkbox" id="markOldUserLeft" @bind="markOldUserLeft" class="h-4 w-4 rounded border-warn-300 text-warn-600 focus:ring-warn-500" />
                        </div>
                        <label for="markOldUserLeft" class="text-sm font-medium text-warn-800 flex-1 leading-snug">
                            Mark previous user <span class="font-bold">@device.UserName</span> as left the job (Move to Ex-Employees)
                        </label>
                    </div>
                }

                @if (device.Status == DeviceStatus.InUse)
                {
                    <div>
                        <label class="block text-sm font-medium text-txt-hi mb-2">What happened to the current user (@device.UserName)?</label>
                        <div class="mb-4">
                            <label class="block text-xs font-medium text-txt-mid">Action</label>
                            <select @bind="transferAction" class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500">
                                <option value="TransferToUser">Transfer device to a new user</option>
                                <option value="ReturnToStore">Unassign (Return to store)</option>
                            </select>
                        </div>
                    </div>
                }

                @if (transferAction == "TransferToUser")
                {
                    <div class="@(device.Status == DeviceStatus.InUse ? "pt-4 border-t border-line-soft" : "")">
                        <h3 class="text-sm font-semibold text-txt-hi mb-3">@(device.Status == DeviceStatus.InUse ? "New Assignment Details" : "Assignment Details")</h3>
                        <div class="mb-4">
                            <label class="block text-xs font-medium text-txt-mid">Search Employee</label>
                            <div class="relative">
                                <input type="text" autocomplete="off" @bind="searchTermTransfer" @bind:event="oninput" @onfocus="() => showTransferDropdown = true" @onblur="HideTransferDropdown" placeholder="Search by name or ID..." class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" />
                                @if (showTransferDropdown)
                                {
                                    <div class="absolute z-50 w-full mt-1 bg-surface border border-line rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                        @if (FilteredTransferEmployees.Any())
                                        {
                                            @foreach (var emp in FilteredTransferEmployees)
                                            {
                                                <div @onmousedown="() => SelectTransferEmployee(emp)" class="px-3 py-2 text-sm text-txt-hi hover:bg-elevated cursor-pointer border-b border-line-soft last:border-0 transition-colors">
                                                    @emp.Name (@emp.EmployeeId)
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="px-3 py-2 text-sm text-txt-mid italic">No employees found...</div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                            <div>
                                <label class="block text-xs font-medium text-txt-mid">User Name</label>
                                <input type="text" @bind="newAssignmentData.UserName" class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" />
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-txt-mid">Employee ID</label>
                                <input type="text" @bind="newAssignmentData.EmployeeId" class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" />
                            </div>
                        </div>
                    </div>
                }
                else if (transferAction == "ReturnToStore")
                {
                    <div class="pt-4 border-t border-line-soft">
                        <p class="text-[13px] text-txt-mid">The device will be unassigned from @device.UserName and moved to the store. Their employee record will remain active.</p>
                    </div>
                }

                <div class="pt-4 border-t border-line-soft flex justify-end gap-3">
                    <button type="button" @onclick="CloseTransferModal" class="rounded-lg px-4 py-2 text-sm font-medium text-txt-mid hover:bg-elevated hover:text-txt-hi transition-colors">Cancel</button>
                    <button type="button" @onclick="SubmitTransfer" class="rounded-lg bg-accent-500 px-4 py-2 text-sm font-medium text-accent-on hover:bg-accent-600 transition-colors">@(device.Status == DeviceStatus.InUse ? "Confirm Transfer" : "Confirm Assignment")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditHandoverModal && editingHandover != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4 whitespace-normal text-left">
        <div class="w-full rounded-xl border border-line bg-surface p-6 shadow-xl" style="max-width: 450px;">
            <div class="flex items-center justify-between mb-5">
                <h2 class="text-lg font-semibold text-txt-hi">Edit Handover Record</h2>
                <button type="button" @onclick="CloseEditHandoverModal" class="text-txt-lo hover:text-txt-hi">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>
            
            <EditForm Model="editingHandover" OnValidSubmit="SaveHandover">
                <div class="space-y-4">
                    <div class="relative">
                        <label class="block text-xs font-medium text-txt-mid">From</label>
                        <input type="text" autocomplete="off" @bind="editingHandover.From" @bind:event="oninput" @onfocus="() => showFromDropdown = true" @onblur="HideFromDropdown" class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="Search employee..." />
                        @if (showFromDropdown)
                        {
                            <div class="absolute z-50 w-full mt-1 bg-surface border border-line rounded-lg shadow-lg max-h-48 overflow-y-auto">
                                @if (GetFilteredEmployees(editingHandover.From).Any())
                                {
                                    @foreach (var emp in GetFilteredEmployees(editingHandover.From))
                                    {
                                        <div @onclick="() => { editingHandover.From = emp.Name; showFromDropdown = false; }" class="cursor-pointer px-3 py-2 text-sm text-txt-hi hover:bg-elevated">
                                            <div class="font-medium">@emp.Name</div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="px-3 py-2 text-sm text-txt-mid">No employees found.</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="relative">
                        <label class="block text-xs font-medium text-txt-mid">To</label>
                        <input type="text" autocomplete="off" @bind="editingHandover.To" @bind:event="oninput" @onfocus="() => showToDropdown = true" @onblur="HideToDropdown" class="w-full rounded-lg border border-line bg-elevated px-2 py-1 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="Search employee..." />
