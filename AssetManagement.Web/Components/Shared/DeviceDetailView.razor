<AssetManagement.Web.Components.Shared.AllocateDeviceModal @bind-IsOpen="showAllocateModal" OnAllocated="OnDeviceAllocated" AvailableDevices="availableDeviceList" ActiveEmployees="employees" />

@code {
    private string Label1 => device?.DeviceTypeDisplay == "System" ? "Processor" : (device?.DeviceTypeDisplay == "Component" ? "Component Type" : (device?.Category == "Monitor" ? "Panel/Display Type" : "Interface/Type"));
    private string Placeholder1 => device?.DeviceTypeDisplay == "System" ? "Intel i5 (13th Gen)" : (device?.DeviceTypeDisplay == "Component" ? "DDR4 / NVMe" : (device?.Category == "Monitor" ? "IPS / LED" : "USB / Wireless"));

    private string Label2 => device?.DeviceTypeDisplay == "System" ? "RAM" : (device?.DeviceTypeDisplay == "Component" ? "Capacity/Speed" : (device?.Category == "Monitor" ? "Size (e.g. 24\\\")" : "Key Spec (e.g. Layout)"));
    private string Placeholder2 => device?.DeviceTypeDisplay == "System" ? "16GB" : (device?.DeviceTypeDisplay == "Component" ? "16GB 3200MHz" : (device?.Category == "Monitor" ? "24\\\"" : "Mechanical / 1000 DPI"));

    private string Label3 => device?.DeviceTypeDisplay == "System" ? "SSD" : (device?.DeviceTypeDisplay == "Component" ? "Form Factor" : (device?.Category == "Monitor" ? "Resolution/Refresh" : "Color/Material"));
    private string Placeholder3 => device?.DeviceTypeDisplay == "System" ? "512GB" : (device?.DeviceTypeDisplay == "Component" ? "M.2 / 2.5\\\"" : (device?.Category == "Monitor" ? "1080p / 75Hz" : "Black / ABS"));

    private string Label4 => device?.DeviceTypeDisplay == "System" ? "HDD" : (device?.DeviceTypeDisplay == "Component" ? "Generation/Extra" : (device?.Category == "Monitor" ? "Mounting" : "Weight/Extra"));
    private string Placeholder4 => device?.DeviceTypeDisplay == "System" ? "1TB" : (device?.DeviceTypeDisplay == "Component" ? "Gen4 / RGB" : (device?.Category == "Monitor" ? "VESA" : "Extra"));

    [Parameter]
    public string DeviceId { get; set; }

    [Parameter]
    public bool IsInline { get; set; } = false;

    [Parameter]
    public bool HideEmployeeProfileLink { get; set; } = false;

    [Parameter]
    public EventCallback OnStateChanged { get; set; }

    private Device? device;
    private IEnumerable<AssetManagement.Core.Entities.DeviceCategoryModel> availableCategories = new List<AssetManagement.Core.Entities.DeviceCategoryModel>();
    private IEnumerable<AssetManagement.Core.Entities.OwnerCompany> availableOwnerCompanies = new List<AssetManagement.Core.Entities.OwnerCompany>();
    private IEnumerable<AssetManagement.Core.Entities.Location> availableLocations = new List<AssetManagement.Core.Entities.Location>();
    private List<Employee>? employees;
    private List<Handover>? handovers;
    private List<RepairRecord>? repairs;
    private bool isLoading = true;
    private bool showAllocateModal = false;
    private List<Device> availableDeviceList = new();
    
    private void OpenAllocateModal()
    {
        availableDeviceList = new List<Device> { device };
        showAllocateModal = true;
    }
    
    private async Task OnDeviceAllocated(List<Handover> handovers)
    {
        foreach (var handover in handovers)
        {
            if (!string.IsNullOrEmpty(handover.DeviceId))
            {
                var emp = employees?.FirstOrDefault(e => e.Name == handover.To);
                var isTeam = emp?.IsTeamAccount == true || handover.Condition?.Contains("Common") == true || handover.Condition?.Contains("Team") == true || handover.To.Contains("Team") || handover.To.Contains("Pool") || handover.To.Contains("Room") || handover.To.Contains("Lab");

                var newAssignmentData = new Device
                {
                    UserName = handover.To,
                    EmployeeId = emp?.EmployeeId ?? (isTeam ? "TEAM" : null),
                    Email = emp?.Email ?? "",
                    Contact = emp?.Contact ?? "",
                    Designation = emp?.Designation ?? (isTeam ? "Team / Common Use" : "Staff")
                };
                await DeviceService.TransferDeviceAsync(handover.DeviceId, "TransferToUser", newAssignmentData);
            }
        }
        showAllocateModal = false;
        await OnInitializedAsync(); if (OnStateChanged.HasDelegate) await OnStateChanged.InvokeAsync();
    }
    private bool showEditModal = false;
    private bool showTransferModal = false;
    private string transferAction = "TransferToUser";
    private Device newAssignmentData = new Device();
    
    private string searchTermEdit = "";
    private string searchTermTransfer = "";
    private bool showEditDropdown = false;
    private bool showTransferDropdown = false;

    private IEnumerable<Employee> FilteredEditEmployees => 
        string.IsNullOrWhiteSpace(searchTermEdit) 
            ? employees ?? new List<Employee>()
            : employees?.Where(e => e.Name.Contains(searchTermEdit, StringComparison.OrdinalIgnoreCase) || 
                                    (e.EmployeeId != null && e.EmployeeId.Contains(searchTermEdit, StringComparison.OrdinalIgnoreCase))) ?? new List<Employee>();
                                    
    private List<Device> childComponents = new();
    private List<Device> availableComponentsToInstall = new();
    private bool showInstallComponentModal = false;
    private string selectedComponentIdToInstall = "";
    
    private string searchComponentTerm = "";
    private bool showComponentDropdown = false;
    
    private IEnumerable<Device> FilteredComponentsToInstall => 
        string.IsNullOrWhiteSpace(searchComponentTerm) 
            ? availableComponentsToInstall
            : availableComponentsToInstall.Where(c => 
                (c.Brand != null && c.Brand.Contains(searchComponentTerm, StringComparison.OrdinalIgnoreCase)) ||
                (c.DeviceName != null && c.DeviceName.Contains(searchComponentTerm, StringComparison.OrdinalIgnoreCase)) ||
                (c.AssetTag != null && c.AssetTag.Contains(searchComponentTerm, StringComparison.OrdinalIgnoreCase)) ||
                (c.Serial != null && c.Serial.Contains(searchComponentTerm, StringComparison.OrdinalIgnoreCase)));

    private void SelectComponentToInstall(Device comp)
    {
        selectedComponentIdToInstall = comp.Id;
        searchComponentTerm = ""; // Clear search since we show the selected item in a box below
        showComponentDropdown = false;
    }
    
    private async Task HideComponentDropdown()
    {
        await Task.Delay(150);
        showComponentDropdown = false;
    }

    private IEnumerable<Employee> FilteredTransferEmployees => 
        string.IsNullOrWhiteSpace(searchTermTransfer) 
            ? employees ?? new List<Employee>()
            : employees?.Where(e => e.Name.Contains(searchTermTransfer, StringComparison.OrdinalIgnoreCase) || 
                                    (e.EmployeeId != null && e.EmployeeId.Contains(searchTermTransfer, StringComparison.OrdinalIgnoreCase))) ?? new List<Employee>();

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        if (!string.IsNullOrEmpty(DeviceId))
        {
            device = await DeviceService.GetDeviceByIdAsync(DeviceId);
            availableCategories = await SettingsService.GetCategoriesAsync();
            availableOwnerCompanies = await SettingsService.GetOwnerCompaniesAsync();
            availableLocations = await SettingsService.GetLocationsAsync();
            var defaultCompany = availableOwnerCompanies.FirstOrDefault(c => c.Name.Contains("Prime", StringComparison.OrdinalIgnoreCase))?.Name 
                ?? availableOwnerCompanies.FirstOrDefault()?.Name 
                ?? "PrimeTech Solutions Ltd.";
            if (device != null)
            {
                if (string.IsNullOrWhiteSpace(device.OwnerCompany) || device.OwnerCompany.Equals("PTSL", StringComparison.OrdinalIgnoreCase))
                {
                    device.OwnerCompany = defaultCompany;
                }
                var compPrefix = availableOwnerCompanies.FirstOrDefault(c => c.Name == device.OwnerCompany)?.Prefix?.Trim() 
                    ?? (device.OwnerCompany.Contains("Prime", StringComparison.OrdinalIgnoreCase) ? "PSL" : "");
                if (!string.IsNullOrEmpty(compPrefix) && !string.IsNullOrEmpty(device.AssetTag) && !device.AssetTag.StartsWith($"{compPrefix}-", StringComparison.OrdinalIgnoreCase))
                {
                    device.AssetTag = $"{compPrefix}-{device.AssetTag}";
                }
            }
            handovers = (await HandoverService.GetHandoversAsync())
                .Where(h => h.DeviceId == DeviceId)
                .OrderByDescending(h => h.ReturnDate)
                .ToList();
            repairs = (await RepairService.GetRepairsAsync())
                .Where(r => r.DeviceId == DeviceId)
                .OrderByDescending(r => r.SentDate)
                .ToList();
            childComponents = await DeviceService.GetChildComponentsAsync(DeviceId);
            var allDevices = await DeviceService.GetDevicesAsync();
            var systemCategories = availableCategories.Where(c => c.Type == "System").Select(c => c.Name).ToHashSet();
            availableComponentsToInstall = allDevices
                .Where(d => d.Id != DeviceId && string.IsNullOrEmpty(d.ParentDeviceId) && d.Status == DeviceStatus.InStore && !systemCategories.Contains(d.Category))
                .ToList();
        }
        employees = await EmployeeService.GetEmployeesAsync();
        isLoading = false;
    }

