                            <div>
                                <label class="mb-0 block text-[11px] font-semibold uppercase tracking-widest text-txt-lo">Purchase Date</label>
                                <InputDate @bind-Value="device.ProcurementDate" class="w-full rounded-lg border border-line bg-surface px-2 py-1 text-[13px] text-txt-hi placeholder:text-txt-lo focus:border-[#8b8cf8] focus:outline-none focus:ring-2 focus:ring-[#8b8cf8]/20 transition-all duration-200" />
