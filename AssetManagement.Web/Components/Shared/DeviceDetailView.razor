    private void RemoveInvoicePath(string pathToRemove)
    {
        if (device == null || string.IsNullOrEmpty(device.InvoiceFilePath)) return;
        var paths = device.InvoiceFilePath.Split('|', StringSplitOptions.RemoveEmptyEntries).ToList();
        paths.Remove(pathToRemove);
        device.InvoiceFilePath = paths.Any() ? string.Join("|", paths) : null;
    }

    private async Task HandleEditInvoiceUpload(InputFileChangeEventArgs e)
    {
        if (device == null) return;
        
        var newPaths = new List<string>();
        foreach (var file in e.GetMultipleFiles())
        {
            var uploadsDir = Path.Combine(Env.WebRootPath, "uploads", "invoices");
            Directory.CreateDirectory(uploadsDir);
            var uniqueName = $"{Guid.NewGuid()}{Path.GetExtension(file.Name)}";
            var fullPath = Path.Combine(uploadsDir, uniqueName);
            await using var fs = new FileStream(fullPath, FileMode.Create);
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(fs);
            newPaths.Add($"/uploads/invoices/{uniqueName}");
        }

        if (newPaths.Any())
        {
            if (string.IsNullOrEmpty(device.InvoiceFilePath))
            {
                device.InvoiceFilePath = string.Join("|", newPaths);
            }
            else
            {
                device.InvoiceFilePath += "|" + string.Join("|", newPaths);
            }
        }
    }

