@using AssetManagement.Core.Entities
@using AssetManagement.Web.Helpers

<span class="inline-flex items-center gap-1.5 rounded px-2 py-0.5 text-[10.5px] font-semibold tracking-wide ring-1 ring-inset @TypeBadgeClass @Class">
    <span>@Device.DeviceTypeDisplay</span>
    @if (!string.Equals(Device.DeviceTypeDisplay, Device.Category, StringComparison.OrdinalIgnoreCase))
    {
        <span class="border-l border-current opacity-80 pl-1.5 font-medium">@Device.Category</span>
    }
</span>

@code {
    [Parameter, EditorRequired] public Device Device { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "";
    
    private string TypeBadgeClass => CategoryColorHelper.GetCategoryColors(Device.Category).TypeBadgeClass;
}
