@using AssetManagement.Core.Entities

<div class="inline-flex items-center text-xs text-txt-hi @Class">
    <span class="font-medium">@(string.IsNullOrWhiteSpace(Device.Category) ? Device.DeviceTypeDisplay : Device.Category)</span>
</div>

@code {
    [Parameter, EditorRequired] public Device Device { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "";
}
