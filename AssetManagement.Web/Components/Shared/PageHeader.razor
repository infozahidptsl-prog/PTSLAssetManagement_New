<header class="px-6 pb-2 pt-4 lg:px-9">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="min-w-0 flex-1 flex items-center gap-3">
            @if (ShowBackButton)
            {
                <button type="button" onclick="window.history.length > 1 ? window.history.back() : window.location.href='/'" class="inline-flex items-center gap-1.5 rounded-lg border border-line bg-surface hover:bg-elevated px-2.5 py-1.5 text-xs font-medium text-txt-mid hover:text-txt-hi transition-all shadow-2xs hover:border-line-strong active:scale-95 cursor-pointer shrink-0" title="Go back to previous page" aria-label="Go back">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    <span>Back</span>
                </button>
            }
            <div>
                <h1 class="text-xl font-semibold leading-tight tracking-tightest text-txt-hi outline-none whitespace-nowrap" tabindex="-1">
                    @Title
                </h1>
                @if (!string.IsNullOrWhiteSpace(Description))
                {
                    <p class="mt-0.5 text-xs text-txt-mid">@Description</p>
                }
            </div>
        </div>
        
        @if (Actions != null)
        {
            <div class="flex flex-wrap items-center gap-2">
                @Actions
            </div>
        }
    </div>
    @ChildContent
</header>

@code {
    [Parameter]
    public bool ShowBackButton { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

