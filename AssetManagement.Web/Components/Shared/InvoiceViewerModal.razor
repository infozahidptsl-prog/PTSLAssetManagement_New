@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color: rgba(0,0,0,0.85); backdrop-filter: blur(6px);" @onclick="Close">
        <div class="relative w-full rounded-2xl bg-white shadow-2xl overflow-hidden flex flex-col" style="max-width: 860px; max-height: 92vh;" @onclick:stopPropagation>

            <!-- Header -->
            <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100 shrink-0" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 24px; border-bottom: 1px solid #f3f4f6; flex-shrink: 0;">
                <div class="flex items-center gap-3 mr-4" style="display: flex; align-items: center; gap: 12px; margin-right: 16px; min-width: 0; overflow: hidden;">
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50" style="display: flex; align-items: center; justify-content: center; height: 36px; width: 36px; border-radius: 8px; background-color: #eff6ff; flex-shrink: 0;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div style="min-width: 0; overflow: hidden;">
                        <p class="text-[14px] font-semibold text-gray-900" style="font-size: 14px; font-weight: 600; color: #111827; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Purchase Invoice</p>
                        <p class="text-[11px] text-gray-400" style="font-size: 11px; color: #9ca3af; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@HeaderFileName</p>
                    </div>
                </div>
                <div class="flex items-center gap-2" style="flex-shrink: 0; display: flex; align-items: center; justify-content: flex-end;">
                    @if (IsPdf)
                    {
                        <div style="display: block; margin-right: 12px; flex-shrink: 0;">
                            <a href="@CurrentPath" download="@CurrentFileName" target="_blank" class="rounded-lg text-[13px] font-medium text-white transition-opacity shadow-sm hover:opacity-90" style="background-color: #ef4444; border: none; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; min-width: 140px; cursor: pointer;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                <span>Export PDF</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div style="display: block; margin-right: 12px; flex-shrink: 0;">
                            <a href="@CurrentPath" download="@CurrentFileName" target="_blank" class="rounded-lg text-[13px] font-medium text-white transition-opacity shadow-sm hover:opacity-90" style="background-color: #0ea5e9; border: none; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; min-width: 140px; cursor: pointer;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                <span>Export Image</span>
                            </a>
                        </div>
                        <div style="display: block; margin-right: 12px; flex-shrink: 0;">
                            <button type="button" @onclick="PrintInvoice" class="rounded-lg text-[13px] font-medium text-white transition-opacity shadow-sm hover:opacity-90" style="background-color: #ef4444; border: none; white-space: nowrap; display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; min-width: 140px; cursor: pointer;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                <span>Export PDF</span>
                            </button>
                        </div>
                    }
                    <div style="display: block; flex-shrink: 0;">
                        <button type="button" @onclick="Close" class="flex h-9 w-9 items-center justify-center rounded-lg border border-gray-200 bg-white text-gray-500 hover:bg-gray-50 transition-colors" style="display: flex; align-items: center; justify-content: center; height: 36px; width: 36px; border-radius: 8px; border: 1px solid #e5e7eb; background-color: #ffffff; color: #6b7280; cursor: pointer;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Content -->
            <div id="invoice-viewer-content" class="relative flex-1 bg-gray-50 flex items-center justify-center p-6" style="flex: 1; overflow: hidden; background-color: #f9fafb; display: flex; align-items: center; justify-content: center; padding: 24px;">
                @if (HasMultipleFiles)
                {
                    <!-- Previous Button -->
                    <button type="button" @onclick="PrevImage" disabled="@IsFirst" class="absolute left-4 top-1/2 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md border border-gray-200 text-gray-700 transition-all hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; height: 40px; width: 40px; border-radius: 9999px; background-color: white; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); cursor: pointer; z-index: 10; opacity: @(IsFirst ? "0.5" : "1"); cursor: @(IsFirst ? "not-allowed" : "pointer");">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                }

                <div class="h-full w-full flex items-center justify-center" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; overflow: auto;">
                    @if (!string.IsNullOrEmpty(CurrentPath))
                    {
                        if (IsPdf)
                        {
                            <iframe src="@CurrentPath" class="w-full rounded-lg shadow-md border border-gray-200" style="width: 100%; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; min-height: 70vh; height: 75vh;" title="Invoice PDF"></iframe>
                        }
                        else
                        {
                            <img src="@CurrentPath" alt="Invoice" class="max-w-full rounded-lg shadow-md border border-gray-200 object-contain" style="max-width: 100%; max-height: 75vh; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); border: 1px solid #e5e7eb; display: block;" />
                        }
                    }
                </div>

                @if (HasMultipleFiles)
                {
                    <!-- Next Button -->
                    <button type="button" @onclick="NextImage" disabled="@IsLast" class="absolute right-4 top-1/2 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-md border border-gray-200 text-gray-700 transition-all hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed" style="position: absolute; right: 16px; top: 50%; transform: translateY(-50%); display: flex; align-items: center; justify-content: center; height: 40px; width: 40px; border-radius: 9999px; background-color: white; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); cursor: pointer; z-index: 10; opacity: @(IsLast ? "0.5" : "1"); cursor: @(IsLast ? "not-allowed" : "pointer");">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string? FilePath { get; set; }

    private int currentIndex = 0;
    private string _lastFilePath = "";
    
    protected override void OnParametersSet()
    {
        if (FilePath != _lastFilePath)
        {
            _lastFilePath = FilePath ?? "";
            currentIndex = 0;
        }
    }

    private List<string> Paths => string.IsNullOrEmpty(FilePath) ? new List<string>() : FilePath.Split('|', StringSplitOptions.RemoveEmptyEntries).ToList();

    private bool HasMultipleFiles => Paths.Count > 1;
    private bool IsFirst => currentIndex <= 0;
    private bool IsLast => currentIndex >= Paths.Count - 1;

    private string CurrentPath => Paths.Any() && currentIndex >= 0 && currentIndex < Paths.Count ? Paths[currentIndex] : "";

    private string HeaderFileName => HasMultipleFiles ? $"Page {currentIndex + 1} of {Paths.Count}" : System.IO.Path.GetFileName(CurrentPath);
    private string CurrentFileName => System.IO.Path.GetFileName(CurrentPath);

    private bool IsPdf => CurrentPath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);

    private void NextImage()
    {
        if (!IsLast) currentIndex++;
    }

    private void PrevImage()
    {
        if (!IsFirst) currentIndex--;
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task PrintInvoice()
    {
        await JS.InvokeVoidAsync("printInvoice", IsPdf, FilePath);
    }
}
