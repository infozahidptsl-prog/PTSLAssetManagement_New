@using AssetManagement.Core.Entities
@using AssetManagement.Web.Helpers

<div class="inline-flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @Class">
    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@IconClass shrink-0 opacity-90"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/></svg>
    <span class="tnum font-mono font-semibold text-xs text-txt-hi uppercase group-hover:text-accent-600 transition-colors">@(string.IsNullOrEmpty(Device.AssetTag) ? Device.Id.ToString() : Device.AssetTag)</span>
    @if (!string.IsNullOrWhiteSpace(Device.OwnerCompany))
    {
        <span class="inline-flex items-center justify-center whitespace-nowrap rounded px-1.5 py-[2px] text-[9px] leading-none font-medium bg-elevated text-txt-mid border border-line-soft ml-0.5">@GetCompanyDisplayName(Device.OwnerCompany)</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public Device Device { get; set; } = default!;
    [Parameter] public string Class { get; set; } = "";
    
    private string IconClass => CategoryColorHelper.GetCategoryColors(Device.Category).IconClass;

    private string GetCompanyDisplayName(string company)
    {
        if (string.IsNullOrWhiteSpace(company)) return "";
        var normalized = company.Trim();
        if (normalized.Contains("prime", StringComparison.OrdinalIgnoreCase) || normalized.Equals("ptsl", StringComparison.OrdinalIgnoreCase))
        {
            return "PrimeTech";
        }
        return normalized;
    }
}
