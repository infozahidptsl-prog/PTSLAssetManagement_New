@page "/warranty"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AssetManagement.Core.Security.Permissions.Devices.View)]
@using AssetManagement.Core.Entities
@using AssetManagement.Infrastructure.Services
@inject DeviceService DeviceService
@inject EmployeeService EmployeeService
@inject IJSRuntime JS

<PageTitle>Warranty tracker - PrimeTech Asset Manager</PageTitle>

<PageHeader Title="Warranty tracker">
    <ChildContent>
        <dl class="mt-6 flex flex-wrap gap-x-10 gap-y-3">
            <div>
                <dt class="text-xs uppercase tracking-widest text-txt-lo">In warranty</dt>
                <dd class="tnum mt-1 text-2xl font-semibold tracking-tightest text-ok-400">@activeCount</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-widest text-txt-lo">Expiring (90 days)</dt>
                <dd class="tnum mt-1 text-2xl font-semibold tracking-tightest text-warn-400">@expiringCount</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-widest text-txt-lo">Expired</dt>
                <dd class="tnum mt-1 text-2xl font-semibold tracking-tightest text-danger-400">@expiredCount</dd>
            </div>
            <div>
                <dt class="text-xs uppercase tracking-widest text-txt-lo">No cover</dt>
                <dd class="tnum mt-1 text-2xl font-semibold tracking-tightest text-txt-mid">@noneCount</dd>
            </div>
        </dl>
    </ChildContent>
</PageHeader>

<div class="flex flex-wrap items-center gap-2.5 border-y border-line-soft bg-surface px-6 py-3 lg:px-9">
    <div role="tablist" aria-label="Warranty state" class="flex flex-wrap items-center gap-0.5 rounded-lg border border-line-soft bg-elevated p-0.5">
        <button type="button" @onclick='() => SetStateFilter("all")' aria-selected="@(stateFilter == "all" ? "true" : "false")" class="whitespace-nowrap rounded-[0.4rem] px-2.5 py-1.5 text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(stateFilter == "all" ? "bg-surface font-medium text-txt-hi shadow-sm" : "text-txt-mid hover:text-txt-hi")">
            All items
        </button>
        <button type="button" @onclick='() => SetStateFilter("expiring")' aria-selected="@(stateFilter == "expiring" ? "true" : "false")" class="whitespace-nowrap rounded-[0.4rem] px-2.5 py-1.5 text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(stateFilter == "expiring" ? "bg-surface font-medium text-txt-hi shadow-sm" : "text-txt-mid hover:text-txt-hi")">
            Expiring in 90 days
        </button>
        <button type="button" @onclick='() => SetStateFilter("active")' aria-selected="@(stateFilter == "active" ? "true" : "false")" class="whitespace-nowrap rounded-[0.4rem] px-2.5 py-1.5 text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(stateFilter == "active" ? "bg-surface font-medium text-txt-hi shadow-sm" : "text-txt-mid hover:text-txt-hi")">
            In warranty
        </button>
        <button type="button" @onclick='() => SetStateFilter("expired")' aria-selected="@(stateFilter == "expired" ? "true" : "false")" class="whitespace-nowrap rounded-[0.4rem] px-2.5 py-1.5 text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(stateFilter == "expired" ? "bg-surface font-medium text-txt-hi shadow-sm" : "text-txt-mid hover:text-txt-hi")">
            Expired
        </button>
        <button type="button" @onclick='() => SetStateFilter("none")' aria-selected="@(stateFilter == "none" ? "true" : "false")" class="whitespace-nowrap rounded-[0.4rem] px-2.5 py-1.5 text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(stateFilter == "none" ? "bg-surface font-medium text-txt-hi shadow-sm" : "text-txt-mid hover:text-txt-hi")">
            No warranty
        </button>
    </div>

    <select @bind="kindFilter" @bind:after="ApplyFilters" class="rounded-lg border border-line bg-elevated py-2 pl-2.5 pr-8 text-sm text-txt-mid transition-colors duration-150 hover:border-line-strong hover:text-txt-hi focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
        <option value="all">All kinds</option>
        <option value="system">Systems</option>
        <option value="component">Components</option>
        <option value="peripheral">Peripherals</option>
    </select>

    <span class="tnum ml-auto text-xs text-txt-lo">@filteredDevices.Count items</span>
</div>

<div class="overflow-x-auto">
    <table class="w-full min-w-[62rem] border-collapse text-sm">
        <caption class="sr-only">Warranty position by item</caption>
        <thead>
            <tr class="border-b border-line-soft text-left text-[11px] font-medium uppercase tracking-widest text-txt-lo">
                <th scope="col" class="py-2 pl-6 pr-3 font-semibold lg:pl-9 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Item")'>
                    <div class="flex items-center gap-1.5">Item @RenderSortIcon("Item")</div>
                </th>
                <th scope="col" class="px-3 py-2 font-semibold cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Type")'>
                    <div class="flex items-center gap-1.5">Type @RenderSortIcon("Type")</div>
                </th>
                <th scope="col" class="px-3 py-2 font-semibold cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Purchased")'>
                    <div class="flex items-center gap-1.5">Purchased @RenderSortIcon("Purchased")</div>
                </th>
                <th scope="col" class="px-3 py-2 font-semibold cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Ends")'>
                    <div class="flex items-center gap-1.5">Warranty ends @RenderSortIcon("Ends")</div>
                </th>
                <th scope="col" class="px-3 py-2 font-semibold cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Remaining")'>
                    <div class="flex items-center gap-1.5">Remaining @RenderSortIcon("Remaining")</div>
                </th>
                <th scope="col" class="px-3 py-2 font-semibold cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Status")'>
                    <div class="flex items-center gap-1.5">Status @RenderSortIcon("Status")</div>
                </th>
                <th scope="col" class="py-2 pl-3 pr-6 font-semibold lg:pr-9 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("HeldBy")'>
                    <div class="flex items-center gap-1.5">Held by @RenderSortIcon("HeldBy")</div>
                </th>
                <th scope="col" class="py-2 pl-3 pr-6 font-semibold lg:pr-9"><span class="sr-only">Expand</span></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-line-soft">
            @foreach (var item in filteredDevices)
            {
                var daysLeft = GetWarrantyDaysLeft(item);
                var isNoCover = !item.HasWarranty || item.WarrantyEndDate == null;
                var tone = isNoCover ? "text-txt-lo" : (daysLeft < 0 ? "text-danger-400" : (daysLeft <= 90 ? "text-warn-400" : "text-ok-400"));
                
                <tr class="bg-surface transition-colors duration-150 hover:bg-slate-50 cursor-pointer" @onclick="async () => await ToggleExpand(item.Id)">
                    <th scope="row" class="py-2 pl-6 pr-3 text-left lg:pl-9">
                        <AssetManagement.Web.Components.Shared.AssetIdentityCell Device="item" />
                    </th>
                    <td class="px-3 py-3">
                        <AssetManagement.Web.Components.Shared.AssetTypeBadge Device="item" />
                    </td>
                    <td class="tnum whitespace-nowrap px-3 py-3 font-mono text-xs text-txt-mid">
                        @(item.EffectiveStartDate?.ToString("d MMM yyyy") ?? "-")
                    </td>
                    <td class="tnum whitespace-nowrap px-3 py-3 font-mono text-xs text-txt-mid">
                        @(GetWarrantyEndDate(item)?.ToString("d MMM yyyy") ?? "-")
                    </td>
                    <td class="tnum whitespace-nowrap px-3 py-3 text-xs font-semibold text-txt-hi">
                        @if (isNoCover)
                        {
                            <span class="font-medium text-txt-lo">No cover</span>
                        }
                        else if (daysLeft < 0)
                        {
                            <span class="text-danger-500">@($"{Math.Abs(daysLeft.Value)} days ago")</span>
                        }
                        else
                        {
                            @($"{daysLeft.Value} days")
                        }
                    </td>
                    <td class="px-3 py-3">
                        <StatusBadge Status="item.Status" />
                    </td>
                    <td class="whitespace-nowrap py-3 pl-3 pr-6 text-txt-mid lg:pr-9">
                        @(string.IsNullOrEmpty(item.UserName) ? "IT inventory" : item.UserName)
                    </td>
                    <td class="py-3 px-3 text-right pr-6 lg:pr-9">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-txt-lo transition-transform duration-200 @(expandedDeviceId == item.Id ? "rotate-180" : "")" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </td>
                </tr>
                @if (expandedDeviceId == item.Id)
                {
                    <tr>
                        <td colspan="8" class="p-0 border-b-4 border-accent-500 bg-canvas shadow-inner overflow-hidden">
                            <div class="px-2 lg:px-3">
                                <AssetManagement.Web.Components.Shared.DeviceDetailView DeviceId="@item.Id" OnStateChanged="OnInitializedAsync" IsInline="true" HideEmployeeProfileLink="false" />
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private string? expandedDeviceId = null;

    private async Task ToggleExpand(string deviceId)
    {
        try
        {
            var selection = await JS.InvokeAsync<string>("eval", "window.getSelection().toString()");
            if (!string.IsNullOrWhiteSpace(selection)) return;
        }
        catch { }
        
        expandedDeviceId = expandedDeviceId == deviceId ? null : deviceId;
    }

    private List<Device> allDevices = new();
    private List<Device> filteredDevices = new();
    
    private int activeCount = 0;
    private int expiringCount = 0;
    private int expiredCount = 0;
    private int noneCount = 0;

    private string stateFilter = "expiring";
    private string kindFilter = "all";

    protected override async Task OnInitializedAsync()
    {
        allDevices = await DeviceService.GetDevicesAsync();
        
        // Calculate counts
        foreach (var device in allDevices)
        {
            var state = GetWarrantyState(device);
            if (state == "active") activeCount++;
            else if (state == "expiring") expiringCount++;
            else if (state == "expired") expiredCount++;
            else noneCount++;
        }

        ApplyFilters();
    }

    private void SetStateFilter(string state)
    {
        stateFilter = state;
        ApplyFilters();
    }

    private string SortColumn { get; set; } = "Remaining";
    private bool SortAscending { get; set; } = true;

    private void SortBy(string column)
    {
        if (SortColumn == column) SortAscending = !SortAscending;
        else { SortColumn = column; SortAscending = true; }
        ApplyFilters();
    }

    private RenderFragment RenderSortIcon(string column) => __builder =>
    {
        if (SortColumn == column)
        {
            if (SortAscending)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m5 15 7-7 7 7"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m19 9-7 7-7-7"/></svg>
            }
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-line-strong opacity-40 group-hover:opacity-100 transition-opacity"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
        }
    };

    private void ApplyFilters()
    {
        var q = allDevices
            .Where(d => stateFilter == "all" || GetWarrantyState(d) == stateFilter)
            .Where(d => kindFilter == "all" || GetItemKind(d) == kindFilter);

        filteredDevices = (SortColumn switch
        {
            "Item" => SortAscending ? q.OrderBy(d => d.Brand).ThenBy(d => d.DeviceName).ThenBy(d => d.AssetTag) : q.OrderByDescending(d => d.Brand).ThenByDescending(d => d.DeviceName).ThenByDescending(d => d.AssetTag),
            "Type" => SortAscending ? q.OrderBy(d => d.Category).ThenBy(d => d.IsComponent) : q.OrderByDescending(d => d.Category).ThenByDescending(d => d.IsComponent),
            "Purchased" => SortAscending ? q.OrderBy(d => d.ProcurementDate ?? DateTime.MinValue) : q.OrderByDescending(d => d.ProcurementDate ?? DateTime.MinValue),
            "Ends" => SortAscending ? q.OrderBy(d => GetWarrantyEndDate(d) ?? DateTime.MaxValue) : q.OrderByDescending(d => GetWarrantyEndDate(d) ?? DateTime.MinValue),
            "Remaining" => SortAscending ? q.OrderBy(d => GetWarrantyDaysLeft(d) ?? 999999) : q.OrderByDescending(d => GetWarrantyDaysLeft(d) ?? -999999),
            "Status" => SortAscending ? q.OrderBy(d => GetWarrantyState(d)) : q.OrderByDescending(d => GetWarrantyState(d)),
            "HeldBy" => SortAscending ? q.OrderBy(d => d.UserName ?? string.Empty).ThenBy(d => d.EmployeeId ?? string.Empty) : q.OrderByDescending(d => d.UserName ?? string.Empty).ThenByDescending(d => d.EmployeeId ?? string.Empty),
            _ => q.OrderBy(d => GetWarrantyDaysLeft(d) ?? 999999)
        }).ToList();
    }

    private string GetItemKind(Device device)
    {
        var category = device.Category?.ToLower() ?? "";
        if (category.Contains("laptop") || category.Contains("desktop") || category.Contains("server") || category.Contains("macbook"))
            return "system";
        if (device.IsComponent)
            return "component";
        return "peripheral";
    }

    private DateTime? GetWarrantyEndDate(Device device)
    {
        return device.WarrantyEndDate;
    }

    private int? GetWarrantyDaysLeft(Device device)
    {
        var endDate = GetWarrantyEndDate(device);
        if (endDate == null) return null;
        return (int)Math.Floor((endDate.Value - DateTime.Now).TotalDays);
    }

    private string GetWarrantyState(Device device)
    {
        var daysLeft = GetWarrantyDaysLeft(device);
        if (daysLeft == null) return "none";
        if (daysLeft < 0) return "expired";
        if (daysLeft <= 90) return "expiring";
        return "active";
    }
}




