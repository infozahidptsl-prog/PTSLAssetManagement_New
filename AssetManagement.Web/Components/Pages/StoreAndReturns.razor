@page "/store"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AssetManagement.Core.Security.Permissions.Devices.Return)]
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Infrastructure.Services
@using AssetManagement.Web.Models
@inject DeviceService DeviceService
@inject HandoverService HandoverService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject NotificationService Notifications

<PageTitle>Receive returns - PrimeTech Asset Manager</PageTitle>

<div class="bg-surface pb-4 border-b border-line-soft">
<PageHeader Title="Receive returns">
    <Actions>
        <button type="button" @onclick="ShowReturnModal" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-accent-on shadow-sm transition-colors duration-150 hover:bg-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            Record return
        </button>
    </Actions>
    <ChildContent>
        <div class="mt-5 flex flex-row gap-3">
            <div class="flex-1 group relative overflow-hidden rounded-xl border border-amber-500/30 bg-amber-50/50 dark:bg-amber-900/20 text-left shadow-sm">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-amber-800 dark:text-amber-400">Total returns</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@totalReturns</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Devices in store</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </span>
                </div>
            </div>

            <div class="flex-1 group relative overflow-hidden rounded-xl border border-blue-200 bg-blue-50/50 dark:bg-blue-900/20 text-left">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-blue-800 dark:text-blue-400">From leavers</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@fromLeavers</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Offboarded employees</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:text-blue-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                    </span>
                </div>
            </div>

            <div class="flex-1 group relative overflow-hidden rounded-xl border border-purple-200 bg-purple-50/50 dark:bg-purple-900/20 text-left">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-purple-800 dark:text-purple-400">Returned with an issue</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@returnedWithIssue</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Requires repair</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-purple-600 dark:text-purple-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                    </span>
                </div>
            </div>
        </div>
    </ChildContent>
</PageHeader>
</div>

<section aria-label="Returned stock" class="bg-surface">
    <div class="px-6 pb-3 pt-5 lg:px-9">
        <form class="relative max-w-md" @onsubmit:preventDefault="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-txt-lo"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" @bind="QuerySearch" @bind:event="oninput" placeholder="Search returned items..." aria-label="Search returned stock" class="w-full rounded-lg border border-line bg-elevated py-2 pl-9 pr-3 text-sm text-txt-hi placeholder:text-txt-lo transition-colors duration-150 hover:border-line-strong focus:border-accent-border focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500" />
        </form>
    </div>
    <AppTable TItem="Device" Items="filteredReturnedStock" OnRowClick="@(async (Device device) => await ToggleExpand(device.Id))" IsRowExpanded="@((Device d) => d.Id == expandedDeviceId)">
        <HeaderContent>
            <th scope="col" class="py-2 pl-6 pr-3 font-semibold text-[10px] uppercase tracking-widest text-txt-mid lg:pl-9 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Asset")'>
                <div class="flex items-center gap-1.5">Asset ID &amp; Item @RenderSortIcon("Asset")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Type")'>
                <div class="flex items-center gap-1.5">Type @RenderSortIcon("Type")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Specification")'>
                <div class="flex items-center gap-1.5">Specification @RenderSortIcon("Specification")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Status")'>
                <div class="flex items-center gap-1.5">Status @RenderSortIcon("Status")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("ReturnedBy")'>
                <div class="flex items-center gap-1.5">Returned By @RenderSortIcon("ReturnedBy")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("ReturnedOn")'>
                <div class="flex items-center gap-1.5">Returned On @RenderSortIcon("ReturnedOn")</div>
            </th>
            <th scope="col" class="relative py-2 pl-3 pr-6 lg:pr-9"><span class="sr-only">Expand</span></th>
        </HeaderContent>
        <RowTemplate Context="device">
            <th scope="row" class="py-2 pl-6 pr-3 text-left lg:pl-9 relative">
                <AssetManagement.Web.Components.Shared.AssetIdentityCell Device="device" />
            </th>
            <td class="px-3 py-3">
                <AssetManagement.Web.Components.Shared.AssetTypeBadge Device="device" />
            </td>
            <td class="px-3 py-3 text-xs text-txt-mid">
                @if (device.IsComponent)
                {
                    <span class="block max-w-[16rem] truncate text-txt-hi">@device.DeviceName</span>
                }
                else
                {
                    <span class="block max-w-[16rem] truncate text-txt-hi">@device.Processor &bull; @device.Ram &bull; @device.Ssd</span>
                }
                <span class="mt-0.5 block max-w-[16rem] truncate text-xs text-txt-lo">@device.Condition</span>
            </td>
            <td class="px-3 py-3">
                <StatusBadge Status="device.Status" />
            </td>
            <td class="px-3 py-3 text-xs text-txt-hi font-medium">@(returnerMap.TryGetValue(device.Id, out var returner) ? returner : "Unknown")</td>
            <td class="px-3 py-3 text-xs text-txt-mid">@(returnDateMap.TryGetValue(device.Id, out var date) ? date : (device.ReturnDate ?? "-"))</td>
            <td class="py-3 px-3 text-right pr-6 lg:pr-9">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-txt-lo transition-transform duration-200 @(expandedDeviceId == device.Id ? "rotate-180" : "")" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </td>
        </RowTemplate>
        <ExpandedRowTemplate Context="device">
            <td colspan="7" class="p-0 border-b-4 border-accent-500 bg-canvas shadow-inner overflow-hidden">
                <div class="px-2 lg:px-3">
                    <AssetManagement.Web.Components.Shared.DeviceDetailView DeviceId="@device.Id" OnStateChanged="LoadData" IsInline="true" HideEmployeeProfileLink="false" />
                </div>
            </td>
        </ExpandedRowTemplate>
    </AppTable>
    @if (TotalItems > 0)
    {
        <div class="px-6 py-4 flex items-center justify-between border-t border-line-soft">
            <div class="flex items-center gap-4">
                <div class="text-xs text-txt-mid">
                    Showing @(TotalItems == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1) to @(Math.Min(CurrentPage * PageSize, TotalItems)) of @TotalItems results
                </div>
                <div class="flex items-center gap-2 text-xs text-txt-mid">
                    <span>Rows per page:</span>
                    <select class="bg-elevated border border-line rounded px-2 py-1 focus:outline-none focus:border-accent-500" @bind="PageSize" @bind:after="() => { CurrentPage = 1; StateHasChanged(); }">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>
            <div class="flex gap-1">
                <button type="button" class="px-3 py-1 rounded border border-line bg-surface text-xs font-medium hover:bg-elevated disabled:opacity-50 transition-colors" @onclick="() => ChangePage(CurrentPage - 1)" disabled="@(CurrentPage == 1)">Previous</button>
                <button type="button" class="px-3 py-1 rounded border border-line bg-surface text-xs font-medium hover:bg-elevated disabled:opacity-50 transition-colors" @onclick="() => ChangePage(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages || TotalPages == 0)">Next</button>
            </div>
        </div>
    }
</section>

<AssetManagement.Web.Components.Shared.ReturnDeviceModal @bind-IsOpen="showReturnModal" OnReturned="OnDeviceReturned" AssignedDevices="assignedDevices" />

@code {
    private string? expandedDeviceId = null;

    private async Task ToggleExpand(string deviceId)
    {
        try
        {
            var selection = await JS.InvokeAsync<string>("eval", "window.getSelection().toString()");
            if (!string.IsNullOrWhiteSpace(selection)) return;
        }
        catch { }
        
        expandedDeviceId = expandedDeviceId == deviceId ? null : deviceId;
    }
    private List<Device> returnedStock = new();
    private Dictionary<string, string> returnerMap = new();
    private Dictionary<string, string> returnDateMap = new();

    private string? _querySearch;
    [SupplyParameterFromQuery(Name = "search")]
    public string? QuerySearch 
    {
        get => _querySearch;
        set
        {
            if (_querySearch != value)
            {
                _querySearch = value;
                CurrentPage = 1;
            }
        }
    }

    private int CurrentPage = 1;
    private int PageSize = 50;
    private int TotalItems = 0;
    private int TotalPages => (int)Math.Ceiling((double)TotalItems / PageSize);

    private void ChangePage(int pageNumber)
    {
        if (pageNumber >= 1 && pageNumber <= TotalPages)
        {
            CurrentPage = pageNumber;
        }
    }

    private List<Device> filteredReturnedStock 
    {
        get
        {
            var result = returnedStock.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(QuerySearch))
            {
                var cleanSearch = QuerySearch.Replace("(", "").Replace(")", "").Replace("+", "").ToLower();
                var terms = cleanSearch.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                
                result = result.Where(d => terms.All(term =>
                    (d.AssetTag != null && d.AssetTag.ToLower().Contains(term)) ||
                    (d.Serial != null && d.Serial.ToLower().Contains(term)) ||
                    (d.DeviceName != null && d.DeviceName.ToLower().Contains(term)) ||
                    (d.Brand != null && d.Brand.ToLower().Contains(term)) ||
                    (d.Processor != null && d.Processor.ToLower().Contains(term)) ||
                    (d.Ram != null && d.Ram.ToLower().Contains(term))
                ));
            }

            TotalItems = result.Count();

            result = SortColumn switch
            {
                "Asset" => SortAscending 
                    ? result.OrderBy(d => d.Brand).ThenBy(d => d.DeviceName).ThenBy(d => d.AssetTag) 
                    : result.OrderByDescending(d => d.Brand).ThenByDescending(d => d.DeviceName).ThenByDescending(d => d.AssetTag),
                "Type" => SortAscending 
                    ? result.OrderBy(d => d.Category).ThenBy(d => d.IsComponent) 
                    : result.OrderByDescending(d => d.Category).ThenByDescending(d => d.IsComponent),
                "Specification" => SortAscending 
                    ? result.OrderBy(d => d.Processor).ThenBy(d => d.Ram) 
                    : result.OrderByDescending(d => d.Processor).ThenByDescending(d => d.Ram),
                "Status" => SortAscending 
                    ? result.OrderBy(d => d.Status.ToString()) 
                    : result.OrderByDescending(d => d.Status.ToString()),
                "ReturnedBy" => SortAscending 
                    ? result.OrderBy(d => returnerMap.GetValueOrDefault(d.Id, "")) 
                    : result.OrderByDescending(d => returnerMap.GetValueOrDefault(d.Id, "")),
                "ReturnedOn" => SortAscending 
                    ? result.OrderBy(d => returnDateMap.GetValueOrDefault(d.Id, "")) 
                    : result.OrderByDescending(d => returnDateMap.GetValueOrDefault(d.Id, "")),
                _ => result
            };

            return result
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
    }

    private string SortColumn { get; set; } = "Asset";
    private bool SortAscending { get; set; } = true;

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = true;
        }
        CurrentPage = 1;
    }

    private RenderFragment RenderSortIcon(string column) => __builder =>
    {
        if (SortColumn == column)
        {
            if (SortAscending)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m5 15 7-7 7 7"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m19 9-7 7-7-7"/></svg>
            }
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-line-strong opacity-40 group-hover:opacity-100 transition-opacity"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
        }
    };
    
    private int totalReturns = 0;
    private int fromLeavers = 0;
    private int returnedWithIssue = 0;
    
    private bool showReturnModal = false;
    private List<Device> assignedDevices = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var allDevices = await DeviceService.GetDevicesAsync();
        var allHandovers = (await HandoverService.GetHandoversAsync()).OrderByDescending(h => h.ReturnDate ?? h.Released).ToList();
        
        var returnedHandovers = allHandovers.Where(h => !string.IsNullOrEmpty(h.ReturnDate)).ToList();
        
        var devicesWithHistoryIds = allHandovers.Select(h => h.DeviceId).ToHashSet();
        returnedStock = allDevices.Where(d => (d.Status == DeviceStatus.InStore || d.Status == DeviceStatus.Returned) && devicesWithHistoryIds.Contains(d.Id)).ToList();
        
        var latestReturnsForStock = returnedStock
            .Select(d => returnedHandovers.FirstOrDefault(h => h.DeviceId == d.Id))
            .Where(h => h != null)
            .ToList();

        returnerMap = latestReturnsForStock.ToDictionary(h => h.DeviceId, h => h.From ?? "Unknown");
        returnDateMap = latestReturnsForStock.ToDictionary(h => h.DeviceId, h => h.ReturnDate ?? "");
        totalReturns = returnedStock.Count;
        fromLeavers = latestReturnsForStock.Count(h => !string.IsNullOrEmpty(h.Condition) && h.Condition.Contains("left", StringComparison.OrdinalIgnoreCase));
        returnedWithIssue = latestReturnsForStock.Count(h => !string.IsNullOrEmpty(h.Condition) && (h.Condition.Contains("issue", StringComparison.OrdinalIgnoreCase) || h.Condition.Contains("fault", StringComparison.OrdinalIgnoreCase) || h.Condition.Contains("broken", StringComparison.OrdinalIgnoreCase) || h.Condition.Contains("slow", StringComparison.OrdinalIgnoreCase) || h.Condition.Contains("damage", StringComparison.OrdinalIgnoreCase)));
        
        assignedDevices = allDevices.Where(d => d.Status == DeviceStatus.InUse).ToList();
    }

    private void ShowReturnModal()
    {
        showReturnModal = true;
    }

    private async Task OnDeviceReturned(AssetManagement.Web.Components.Shared.ReturnDeviceModal.ReturnModel returnedModel)
    {
        if (string.IsNullOrEmpty(returnedModel.DeviceId)) return;
        
        var device = await DeviceService.GetDeviceByIdAsync(returnedModel.DeviceId);
        if (device != null)
        {
            device.Status = DeviceStatus.InStore;
            await DeviceService.UpdateDeviceAsync(device);

            var conditionStr = string.IsNullOrEmpty(returnedModel.Note) ? returnedModel.Reason : $"{returnedModel.Reason} - {returnedModel.Note}";
            var newHandover = new Handover
            {
                Id = Guid.NewGuid().ToString(),
                DeviceId = device.Id,
                Device = device,
                From = device.UserName ?? device.From ?? string.Empty,
                To = "IT inventory",
                ReturnDate = DateTime.Now.ToString("d MMM yyyy"),
                Condition = conditionStr
            };
            await HandoverService.AddHandoverAsync(newHandover);
        }

        showReturnModal = false;
        if (device != null)
        {
            Notifications.ShowSuccess($"Asset {device.AssetTag ?? device.Id} returned to IT inventory successfully.");
        }
        await LoadData();
    }
}
















