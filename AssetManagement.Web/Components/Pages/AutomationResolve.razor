@page "/automation/resolve/{Id:int}"
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Infrastructure.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@inject NavigationManager NavigationManager

<PageTitle>Resolve Finding - PrimeTech Asset Manager</PageTitle>

<div class="bg-surface pb-2 border-b border-line-soft">
    <PageHeader Title="Resolve Automation Finding">
        <Actions>
            <button type="button" @onclick="GoBack" class="inline-flex items-center justify-center gap-2 rounded-lg border border-line-strong bg-surface px-4 py-2 text-sm font-semibold text-txt-hi shadow-sm transition-colors duration-150 hover:bg-elevated">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                Back to Center
            </button>
        </Actions>
    </PageHeader>
</div>

<div class="p-6 lg:p-9 max-w-4xl mx-auto">
    @if (finding == null)
    {
        <div class="text-center py-12">
            <p class="text-txt-mid">Loading finding details...</p>
        </div>
    }
    else
    {
        <div class="rounded-xl border border-line overflow-hidden bg-surface shadow-sm">
            <!-- Header section with severity color -->
            <div class="p-6 border-b border-line-soft @GetSeverityBgColor(finding.Severity)">
                <div class="flex items-center gap-3 mb-2">
                    @GetSeverityIcon(finding.Severity)
                    <h2 class="text-xl font-bold text-txt-hi">@finding.Title</h2>
                </div>
                <div class="flex items-center gap-2 mt-4">
                    <span class="inline-flex items-center rounded-md px-2 py-1 text-xs font-medium ring-1 ring-inset @GetStatusClasses(finding.Status)">
                        @finding.Status.ToString()
                    </span>
                    <span class="text-sm text-txt-mid flex items-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                        Detected: @finding.CreatedAt.ToString("MMM d, yyyy h:mm tt")
                    </span>
                </div>
            </div>

            <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Details -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider text-txt-lo mb-4">Finding Details</h3>
                    <div class="space-y-4">
                        <div>
                            <p class="text-sm font-medium text-txt-hi">Description</p>
                            <p class="text-sm text-txt-mid mt-1">@finding.Description</p>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(finding.RecommendedAction))
                        {
                            <div class="bg-elevated p-3 rounded-lg border border-line-soft">
                                <p class="text-sm font-medium text-accent-600 flex items-center gap-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/><path d="m9 12 2 2 4-4"/></svg>
                                    Recommended Action
                                </p>
                                <p class="text-sm text-txt-hi mt-1">@finding.RecommendedAction</p>
                            </div>
                        }

                        <div>
                            <p class="text-sm font-medium text-txt-hi">Rule Engine</p>
                            <p class="text-sm text-txt-mid mt-1"><code class="px-1.5 py-0.5 bg-elevated rounded border border-line-soft text-xs font-mono">@finding.RuleType.ToString()</code></p>
                        </div>
                    </div>
                </div>

                <!-- References & Actions -->
                <div>
                    <h3 class="text-sm font-bold uppercase tracking-wider text-txt-lo mb-4">Affected References</h3>
                    <div class="space-y-3 mb-8">
                        @if (finding.Device != null)
                        {
                            <div class="flex items-center justify-between p-3 border border-line-soft rounded-lg bg-surface hover:bg-elevated transition-colors">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="text-txt-mid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
                                    <div>
                                        <p class="text-sm font-medium text-txt-hi">@finding.Device.AssetTag</p>
                                        <p class="text-xs text-txt-mid">@finding.Device.DeviceName</p>
                                    </div>
                                </div>
                                <a href="/device/@finding.DeviceId" class="text-xs font-semibold text-accent-600 hover:text-accent-700">View Asset</a>
                            </div>
                        }
                        
                        @if (finding.Employee != null)
                        {
                            <div class="flex items-center justify-between p-3 border border-line-soft rounded-lg bg-surface hover:bg-elevated transition-colors">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="text-txt-mid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    <div>
                                        <p class="text-sm font-medium text-txt-hi">@finding.Employee.Name</p>
                                        <p class="text-xs text-txt-mid">@finding.Employee.EmployeeId</p>
                                    </div>
                                </div>
                                <a href="/employee/@finding.EmployeeId" class="text-xs font-semibold text-accent-600 hover:text-accent-700">View Employee</a>
                            </div>
                        }
                        
                        @if (finding.Purchase != null)
                        {
                            <div class="flex items-center justify-between p-3 border border-line-soft rounded-lg bg-surface hover:bg-elevated transition-colors">
                                <div class="flex items-center gap-3">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" class="text-txt-mid" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                    <div>
                                        <p class="text-sm font-medium text-txt-hi">Purchase @finding.Purchase.InvoiceNumber</p>
                                        <p class="text-xs text-txt-mid">@finding.Purchase.Supplier</p>
                                    </div>
                                </div>
                                <a href="/inventory-in" class="text-xs font-semibold text-accent-600 hover:text-accent-700">View Purchase</a>
                            </div>
                        }

                        @if (finding.Device == null && finding.Employee == null && finding.Purchase == null)
                        {
                            <p class="text-sm text-txt-mid italic">No specific records attached.</p>
                        }
                    </div>

                    <h3 class="text-sm font-bold uppercase tracking-wider text-txt-lo mb-4">Resolution</h3>
                    @if (finding.Status == FindingStatus.Open)
                    {
                        <div class="space-y-4">
                            <div>
                                <label for="resolutionNote" class="block text-sm font-medium text-txt-hi mb-1">Resolution Note (Optional)</label>
                                <textarea id="resolutionNote" @bind="resolutionNote" rows="3" class="w-full rounded-lg border border-line bg-elevated px-3 py-2 text-sm text-txt-hi focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500" placeholder="How was this fixed?"></textarea>
                            </div>
                            <div class="flex gap-3">
                                <button type="button" @onclick="MarkResolved" class="flex-1 inline-flex justify-center items-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                    Mark as Resolved
                                </button>
                                <button type="button" @onclick="MarkDismissed" class="inline-flex justify-center items-center gap-2 rounded-lg bg-surface border border-line-strong px-4 py-2.5 text-sm font-semibold text-txt-mid hover:text-txt-hi shadow-sm hover:bg-elevated focus:outline-none">
                                    Dismiss
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="bg-elevated p-4 rounded-lg border border-line-soft">
                            <p class="text-sm font-medium text-txt-hi mb-2">
                                @if (finding.Status == FindingStatus.Resolved) { <span>Resolved</span> } else { <span>Dismissed</span> }
                                by System/User
                            </p>
                            @if (!string.IsNullOrEmpty(finding.ResolutionNote) || !string.IsNullOrEmpty(finding.DismissalReason))
                            {
                                <p class="text-sm text-txt-mid italic border-l-2 border-line-strong pl-3 mt-2">
                                    @(finding.ResolutionNote ?? finding.DismissalReason)
                                </p>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    
    private AutomationFinding finding;
    private string resolutionNote = "";

    protected override async Task OnInitializedAsync()
    {
        finding = await DbContext.AutomationFindings
            .Include(f => f.Device)
            .Include(f => f.Employee)
            .Include(f => f.Purchase)
            .FirstOrDefaultAsync(f => f.Id == Id);
    }

    private async Task MarkResolved()
    {
        if (finding != null)
        {
            finding.Status = FindingStatus.Resolved;
            finding.ResolvedAt = DateTime.UtcNow;
            finding.ResolutionNote = string.IsNullOrWhiteSpace(resolutionNote) ? "Manually resolved." : resolutionNote;
            finding.ResolvedBy = "Admin"; // Hardcoded for now, should use Auth state
            
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo("/automation");
        }
    }

    private async Task MarkDismissed()
    {
        if (finding != null)
        {
            finding.Status = FindingStatus.Dismissed;
            finding.DismissedAt = DateTime.UtcNow;
            finding.DismissalReason = string.IsNullOrWhiteSpace(resolutionNote) ? "Dismissed by user." : resolutionNote;
            finding.DismissedBy = "Admin";
            
            await DbContext.SaveChangesAsync();
            NavigationManager.NavigateTo("/automation");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/automation");
    }

    private string GetSeverityBgColor(FindingSeverity severity) => severity switch
    {
        FindingSeverity.Critical => "bg-red-50",
        FindingSeverity.Warning => "bg-amber-50",
        _ => "bg-blue-50"
    };

    private string GetStatusClasses(FindingStatus status) => status switch
    {
        FindingStatus.Resolved => "bg-green-50 text-green-700 ring-green-600/20",
        FindingStatus.Dismissed => "bg-gray-50 text-gray-600 ring-gray-500/10",
        _ => "bg-blue-50 text-blue-700 ring-blue-700/10"
    };

    private RenderFragment GetSeverityIcon(FindingSeverity severity) => builder =>
    {
        var (colorClass, iconSvg) = severity switch
        {
            FindingSeverity.Critical => ("text-red-600", "<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/>"),
            FindingSeverity.Warning => ("text-amber-600", "<path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/>"),
            _ => ("text-blue-600", "<circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 16v-4\"/><path d=\"M12 8h.01\"/>")
        };

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "xmlns", "http://www.w3.org/2000/svg");
        builder.AddAttribute(2, "width", "24");
        builder.AddAttribute(3, "height", "24");
        builder.AddAttribute(4, "viewBox", "0 0 24 24");
        builder.AddAttribute(5, "fill", "none");
        builder.AddAttribute(6, "stroke", "currentColor");
        builder.AddAttribute(7, "stroke-width", "2");
        builder.AddAttribute(8, "stroke-linecap", "round");
        builder.AddAttribute(9, "stroke-linejoin", "round");
        builder.AddAttribute(10, "class", colorClass);
        builder.AddMarkupContent(11, iconSvg);
        builder.CloseElement();
    };
}
