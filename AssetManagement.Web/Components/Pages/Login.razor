@page "/login"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout AssetManagement.Web.Components.Layout.EmptyLayout
@inject NavigationManager NavigationManager

<div class="relative min-h-screen w-full bg-slate-950 font-sans text-slate-200 selection:bg-blue-500/30">
    <!-- Video Background -->
    <video id="login-video" autoplay loop muted playsinline class="absolute inset-0 h-full w-full object-cover opacity-80"></video>
    <script>
        fetch('assets/Login-Bg.webm?v=2')
            .then(r => r.blob())
            .then(blob => {
                var v = document.getElementById('login-video');
                if (v) {
                    v.src = URL.createObjectURL(blob);
                    v.play().catch(function(){});
                }
            });
    </script>
    
    <!-- Overall Gradient Overlay for Depth -->
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/30 via-slate-900/60 to-black/80 pointer-events-none"></div>

    <style>
        /* Fix browser autofill styling */
        input:-webkit-autofill,
        input:-webkit-autofill:hover, 
        input:-webkit-autofill:focus, 
        input:-webkit-autofill:active {
            -webkit-box-shadow: 0 0 0 1000px white inset !important;
            -webkit-text-fill-color: black !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        /* Fix text selection visibility */
        input::selection {
            background-color: #0284c7 !important; /* Tailwind blue-600 */
            color: #ffffff !important;
        }
        input::-moz-selection {
            background-color: #0284c7 !important;
            color: #ffffff !important;
        }
    </style>

    <!-- Main Content Container -->
    <div class="relative z-10 flex min-h-screen w-full items-center justify-center px-4">
        
        <div class="relative flex w-full max-w-6xl items-center justify-center gap-8">
            <!-- Login Panel Wrapper -->
            <div class="relative w-full max-w-[420px] shrink-0 rounded-[20px] p-[2px] shadow-[0_0_50px_-12px_rgba(0,100,255,0.3)] backdrop-blur-xl overflow-hidden">
                
                <!-- Animated Spark Border (2 sparks opposite to each other) -->
                <div class="absolute inset-[-100%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,transparent_35%,#0ea5e9_45%,#ffffff_50%,transparent_51%)]"></div>
                <div class="absolute inset-[-100%] animate-[spin_3s_linear_infinite] bg-[conic-gradient(from_270deg_at_50%_50%,transparent_0%,transparent_35%,#0ea5e9_45%,#ffffff_50%,transparent_51%)]"></div>
                
                <!-- Inner Panel -->
                <div class="relative h-full w-full rounded-[18px] bg-[#0a1128]/95 p-10 overflow-hidden">
                <!-- Subtle glow inside the panel -->
                <div class="absolute -top-32 -left-32 h-64 w-64 rounded-full bg-blue-500/20 blur-[80px] pointer-events-none"></div>
                <div class="absolute -bottom-32 -right-32 h-64 w-64 rounded-full bg-cyan-500/10 blur-[80px] pointer-events-none"></div>
                
                <div class="relative z-10">
                    <!-- Logo Area -->
                    <div class="mb-8 flex flex-col items-center justify-center text-center">
                        <div class="mb-5 inline-flex items-center justify-center">
                            <img src="assets/whitelogo.png?v=3" alt="PrimeTech Logo" class="h-14 object-contain" />
                        </div>
                        <h1 class="text-xl font-semibold text-white tracking-wide outline-none focus:outline-none select-none">Asset Management System</h1>
                        <p class="mt-2 text-[13px] text-txt-lo">Asset & Device Management</p>
                    </div>

                    <!-- Form -->
                    <form method="post" action="Account/LoginPost" data-enhance="false" class="space-y-4">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                        
                        <!-- Error Message -->
                        @if (!string.IsNullOrEmpty(Error))
                        {
                            <div class="rounded-lg bg-red-500/10 p-3 text-[13px] text-red-500 border border-red-500/20 text-center">
                                @Error
                            </div>
                        }

                        <!-- Username -->
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-txt-lo">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                            </div>
                            <input type="text" name="email" placeholder="Username / Employee ID" required spellcheck="false" autocomplete="off"
                                style="background-color: white !important; color: black !important;"
                                class="w-full rounded-lg border border-line-soft py-3 pl-11 pr-4 text-[13px] placeholder-slate-500 outline-none transition-all focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50" />
                        </div>

                        <!-- Password -->
                        <div class="relative">
                            <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-txt-lo">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            </div>
                            <input type="@(showPassword ? "text" : "password")" name="password" placeholder="Password" required spellcheck="false" autocomplete="off"
                                style="background-color: white !important; color: black !important;"
                                class="w-full rounded-lg border border-line-soft py-3 pl-11 pr-11 text-[13px] placeholder-slate-500 outline-none transition-all focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50" />
                            <button type="button" @onclick="TogglePassword" class="absolute inset-y-0 right-0 flex items-center pr-4 text-txt-lo hover:text-white transition-colors">
                                @if (showPassword)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                                }
                            </button>
                        </div>

                        <!-- Remember Me -->
                        <div class="flex items-center pt-2 pb-2">
                            <label class="flex cursor-pointer items-center gap-2.5 select-none">
                                <input type="checkbox" name="rememberMe" value="true" id="rememberMeCheck"
                                    style="width:16px;height:16px;accent-color:#0ea5e9;cursor:pointer;" />
                                <span class="text-[13px] text-slate-300">Remember Me</span>
                            </label>
                        </div>

                        <!-- Login Button -->
                        <div class="pt-1">
                            <button type="submit" class="group flex w-full items-center justify-center gap-2 rounded-lg bg-[#0ea5e9] px-4 py-3 text-sm font-medium text-white transition-all hover:bg-[#0284c7] focus:outline-none focus:ring-2 focus:ring-blue-500/50 shadow-[0_0_15px_-3px_rgba(14,165,233,0.4)]">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                                Login
                            </button>
                        </div>
                    </form>
                </div>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }
    
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    private bool showPassword = false;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        if (authState.User.Identity is not null && authState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl, forceLoad: true);
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }
}

