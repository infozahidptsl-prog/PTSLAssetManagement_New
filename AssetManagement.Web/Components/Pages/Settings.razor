    }

    private async Task ConfirmDelete()
    {
        if (deleteActionType == "Brand")
        {
            await SettingsService.DeleteBrandAsync(itemToDeleteId);
            brands = await SettingsService.GetBrandsAsync();
        }
        else if (deleteActionType == "Category")
        {
            await SettingsService.DeleteCategoryAsync(itemToDeleteId);
            categories = await SettingsService.GetCategoriesAsync();
        }
        else if (deleteActionType == "Designation")
        {
            await SettingsService.DeleteDesignationAsync(itemToDeleteId);
            designations = await SettingsService.GetDesignationsAsync();
        }
        else if (deleteActionType == "Department")
        {
            await SettingsService.DeleteDepartmentAsync(itemToDeleteId);
            departments = await SettingsService.GetDepartmentsAsync();
        }
        else if (deleteActionType == "ProjectManager")
        {
            await SettingsService.DeleteProjectManagerAsync(itemToDeleteId);
            projectManagers = await SettingsService.GetProjectManagersAsync();
        }
        else if (deleteActionType == "OwnerCompany")
        {
            await SettingsService.DeleteOwnerCompanyAsync(itemToDeleteId);
            ownerCompanies = await SettingsService.GetOwnerCompaniesAsync();
        }
        else if (deleteActionType == "Team")
        {
            if (int.TryParse(itemToDeleteId, out int parsedId))
            {
                await SettingsService.DeleteTeamAsync(parsedId);
                await LoadTeams();
            }
        }
        else if (deleteActionType == "User")
        {
            var user = await UserManager.FindByIdAsync(itemToDeleteId);
            if (user != null)
            {
                await UserManager.DeleteAsync(user);
                await LoadUsers();
            }
        }
        else if (deleteActionType == "Role")
        {
            var role = await RoleManager.FindByNameAsync(itemToDeleteId);
            if (role != null && role.Name != "Admin")
            {
                await RoleManager.DeleteAsync(role);
                await LoadRolesAsync();
            }
        }
        var deletedType = deleteActionType;
        CloseConfirmModal();
        Notifications.ShowSuccess($"{deletedType} deleted successfully.");
    }

