    // User Management Methods
    private void StartEditUser(ApplicationUser user)
    {
        editUserModel = new UserFormModel
        {
            Id = user.Id,
            Email = user.Email ?? "",
            FullName = user.FullName ?? ""
        };
        selectedRole = GetUserRole(user.Id);
        if (selectedRole == "None") selectedRole = "Employee";
        showEditUserModal = true;
        userErrorMessage = "";
    }
    
    private void ShowDeleteUserModal(ApplicationUser user)
    {
        itemToDeleteId = user.Id;
        deleteActionType = "User";
        confirmModalMessage = $"Are you sure you want to delete user {user.Email}?";
        showConfirmModal = true;
    }
    
    private void CloseUserModal()
    {
        showAddUserModal = false;
        showEditUserModal = false;
        newUserModel = new UserFormModel();
    }
    
    private async Task SaveUser()
    {
        userErrorMessage = "";
        
        if (showAddUserModal)
        {
            if (string.IsNullOrWhiteSpace(newUserModel.Email) || string.IsNullOrWhiteSpace(newUserModel.Password))
            {
                userErrorMessage = "Email and Password are required.";
                return;
            }
            
            var user = new ApplicationUser
            {
                UserName = newUserModel.Email,
                Email = newUserModel.Email,
                FullName = newUserModel.FullName
            };
            
            var result = await UserManager.CreateAsync(user, newUserModel.Password);
            if (result.Succeeded)
            {
                await UserManager.AddToRoleAsync(user, selectedRole);
                CloseUserModal();
                await LoadUsers();
                Notifications.ShowSuccess($"User account '{user.Email}' created successfully.");
            }
            else
            {
                userErrorMessage = string.Join(", ", result.Errors.Select(e => e.Description));
            }
        }
        else if (showEditUserModal)
        {
            var user = await UserManager.FindByIdAsync(editUserModel.Id);
            if (user != null)
            {
                user.Email = editUserModel.Email;
                user.UserName = editUserModel.Email;
                user.FullName = editUserModel.FullName;
                
                var updateResult = await UserManager.UpdateAsync(user);
                
                if (updateResult.Succeeded)
                {
                    if (!string.IsNullOrWhiteSpace(editUserModel.Password))
                    {
                        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
                        var passResult = await UserManager.ResetPasswordAsync(user, token, editUserModel.Password);
                        if (!passResult.Succeeded)
                        {
                            userErrorMessage = "User updated, but password reset failed: " + string.Join(", ", passResult.Errors.Select(e => e.Description));
                            return;
                        }
                    }

                    var currentRoles = await UserManager.GetRolesAsync(user);
                    await UserManager.RemoveFromRolesAsync(user, currentRoles);
                    await UserManager.AddToRoleAsync(user, selectedRole);
                    
                    // Force refresh user session to apply new role
                    await UserManager.UpdateSecurityStampAsync(user);
                    
                    CloseUserModal();
                    await LoadUsers();
                    Notifications.ShowSuccess($"User account '{user.Email}' updated successfully.");
                }
                else
                {
                    userErrorMessage = string.Join(", ", updateResult.Errors.Select(e => e.Description));
                }
            }
        }
    }
    
    private string loadedPermissionRole = "";

    // Role Permissions Methods
    private async Task OnPermissionRoleChanged(ChangeEventArgs e)
    {
        selectedPermissionRole = e.Value?.ToString() ?? "";
        await LoadRolePermissions();
    }

    private async Task LoadRolePermissions()
    {
        permissionsMessage = "";
        permissionSelections.Clear();
        foreach (var perm in availablePermissions)
        {
            permissionSelections[perm] = false;
        }
        
        var role = await RoleManager.FindByNameAsync(selectedPermissionRole);
        if (role != null)
        {
            var claims = await RoleManager.GetClaimsAsync(role);
            var rolePerms = claims.Where(c => c.Type == "Permission").Select(c => c.Value).ToList();
            
            foreach (var perm in rolePerms)
            {
                if (permissionSelections.ContainsKey(perm))
                {
                    permissionSelections[perm] = true;
                }
            }
            loadedPermissionRole = selectedPermissionRole;
            permissionsLoaded = true;
        }
        else
        {
            loadedPermissionRole = "";
            permissionsLoaded = false;
        }
    }
    
    private void SelectAllPermissions()
    {
        foreach (var key in permissionSelections.Keys.ToList())
        {
            permissionSelections[key] = true;
        }
    }
    
    private void UnselectAllPermissions()
    {
        foreach (var key in permissionSelections.Keys.ToList())
        {
            permissionSelections[key] = false;
        }
    }
    
    private async Task SaveRolePermissions()
    {
        if (string.IsNullOrEmpty(loadedPermissionRole)) return;

        var role = await RoleManager.FindByNameAsync(loadedPermissionRole);
        if (role != null)
        {
            var existingClaims = await RoleManager.GetClaimsAsync(role);
            var existingPermissionClaims = existingClaims.Where(c => c.Type == "Permission").ToList();
            
            // Remove old permissions
            foreach (var claim in existingPermissionClaims)
            {
                await RoleManager.RemoveClaimAsync(role, claim);
            }
            
            // Add new permissions
            foreach (var perm in permissionSelections.Where(x => x.Value).Select(x => x.Key))
            {
                await RoleManager.AddClaimAsync(role, new Claim("Permission", perm));
            }
            
            // Force refresh of permissions for users in this role
            var usersInRole = await UserManager.GetUsersInRoleAsync(role.Name);
            foreach (var user in usersInRole)
            {
                await UserManager.UpdateSecurityStampAsync(user);
            }
            
            permissionsMessage = $"Permissions updated successfully for role '{loadedPermissionRole}'.";
            Notifications.ShowSuccess($"Permissions updated successfully for role '{loadedPermissionRole}'.");
        }
    }
