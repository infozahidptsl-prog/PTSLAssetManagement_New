            Notifications.ShowWarning($"Role '{rName}' already exists.");
        }
        newRoleName = "";
    }

    private void StartEditRole(string role)
    {
        editingRoleName = role;
        editRoleNameInput = role;
    }

    private void CancelEditRole()
    {
        editingRoleName = null;
        editRoleNameInput = "";
    }

    private async Task SaveEditRole(string oldRoleName)
    {
        if (string.IsNullOrWhiteSpace(editRoleNameInput) || oldRoleName == editRoleNameInput)
        {
            CancelEditRole();
            return;
        }

        var role = await RoleManager.FindByNameAsync(oldRoleName);
        if (role != null)
        {
            role.Name = editRoleNameInput.Trim();
            await RoleManager.UpdateAsync(role);
            await LoadRolesAsync();
            Notifications.ShowSuccess($"Role renamed to '{role.Name}'.");
        }
        CancelEditRole();
    }

