@page "/settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AssetManagement.Core.Security.Permissions.Settings.View)]
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Interfaces
@using AssetManagement.Core.Security
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject ISettingsService SettingsService
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject SweetAlertService Swal
@inject NotificationService Notifications

<PageTitle>Prime Tech Solutions Ltd.</PageTitle>

<PageHeader Title="Settings" />

<div class="px-6 py-6 lg:px-9 bg-canvas min-h-screen">
    <div class="flex flex-col lg:flex-row gap-8 max-w-[1400px]">
        <!-- Sidebar Navigation -->
        <div class="w-full lg:w-72 shrink-0 flex flex-col gap-6 bg-surface p-5 rounded-2xl border border-line-soft shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)] h-auto lg:h-[calc(100vh-120px)] lg:sticky top-24 overflow-y-auto custom-scrollbar">
            
            <div>
                <h2 class="text-[10px] font-bold text-txt-lo/70 uppercase tracking-widest mb-3 px-3">Assets & Inventory</h2>
                <div class="flex flex-col gap-1">
                    <button @onclick='@(() => activeTab = "Brands")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Brands" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Brands" ? "text-accent-500" : "text-txt-lo")"><path d="M12 2L2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
                        Brands
                    </button>
                    <button @onclick='@(() => activeTab = "Categories")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Categories" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Categories" ? "text-accent-500" : "text-txt-lo")"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
                        Categories
                    </button>
                    <button @onclick='@(() => activeTab = "OwnerCompanies")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "OwnerCompanies" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "OwnerCompanies" ? "text-accent-500" : "text-txt-lo")"><path d="M3 21h18"/><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>
                        Owner Companies
                    </button>
                    <button @onclick='@(() => activeTab = "Locations")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Locations" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Locations" ? "text-accent-500" : "text-txt-lo")"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                        Locations
                    </button>
                </div>
            </div>

            <div>
                <h2 class="text-[10px] font-bold text-txt-lo/70 uppercase tracking-widest mb-3 px-3">Organization</h2>
                <div class="flex flex-col gap-1">
                    <button @onclick='@(() => activeTab = "Designations")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Designations" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Designations" ? "text-accent-500" : "text-txt-lo")"><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/><circle cx="12" cy="7" r="4"/><path d="M12 14c-4.4 0-8 2-8 6v1h16v-1c0-4-3.6-6-8-6Z"/></svg>
                        Designations
                    </button>
                    <button @onclick='@(() => activeTab = "Departments")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Departments" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Departments" ? "text-accent-500" : "text-txt-lo")"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" x2="12" y1="22" y2="12"/></svg>
                        Departments
                    </button>
                    <button @onclick='@(() => activeTab = "Teams")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Teams" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Teams" ? "text-accent-500" : "text-txt-lo")"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Teams
                    </button>
                    <button @onclick='@(() => activeTab = "ProjectManagers")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "ProjectManagers" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "ProjectManagers" ? "text-accent-500" : "text-txt-lo")"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        Project Managers
                    </button>
                    <button @onclick='@(() => activeTab = "BloodGroups")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "BloodGroups" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "BloodGroups" ? "text-accent-500" : "text-txt-lo")"><path d="M7.4 12.3c-.6.6-1.5.6-2.1 0-.6-.6-.6-1.5 0-2.1l7.6-7.6c.3-.3.8-.3 1.1 0l7.6 7.6c.6.6.6 1.5 0 2.1-.6.6-1.5.6-2.1 0L12 5.1l-4.6 7.2Z"/><path d="M12 17a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/></svg>
                        Blood Groups
                    </button>
                </div>
            </div>

            <div>
                <h2 class="text-[10px] font-bold text-txt-lo/70 uppercase tracking-widest mb-3 px-3">Access & Security</h2>
                <div class="flex flex-col gap-1">
                    <button @onclick='@(() => activeTab = "Users")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Users" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Users" ? "text-accent-500" : "text-txt-lo")"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        Users
                    </button>
                    <button @onclick='@(() => activeTab = "Roles")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Roles" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Roles" ? "text-accent-500" : "text-txt-lo")"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h.01"/><path d="M17 7h.01"/><path d="M7 17h.01"/><path d="M17 17h.01"/></svg>
                        Roles
                    </button>
                    <button @onclick='@(() => activeTab = "Permissions")' class='flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(activeTab == "Permissions" ? "bg-accent-500/10 text-accent-600 shadow-sm ring-1 ring-accent-500/20" : "text-txt-mid hover:bg-elevated hover:text-txt-hi")'>
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(activeTab == "Permissions" ? "text-accent-500" : "text-txt-lo")"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
                        Role Permissions
                    </button>
                </div>
            </div>
            
            <!-- Bottom spacer to prevent cut-off -->
            <div class="h-4 shrink-0"></div>
        </div>

        <!-- Content Area -->
        <div class="flex-1 w-full min-w-0">

        @if (activeTab == "Brands")
        {
            <div class="rounded-2xl border border-line-soft bg-surface shadow-sm overflow-hidden flex flex-col max-w-4xl lg:h-[calc(100vh-120px)]">
                <div class="p-4 border-b border-line-soft bg-surface flex justify-between items-center gap-4 shrink-0">
                    <div class="flex items-center gap-2 bg-elevated rounded-lg p-1 border border-line-soft focus-within:border-accent-border focus-within:ring-1 focus-within:ring-accent-500 transition-all">
                        <input type="text" @bind="newBrandName" @bind:event="oninput" @onkeyup="@(e => { if(e.Key == "Enter") AddBrand(); })" placeholder="New brand name" class="w-[200px] bg-transparent text-sm text-txt-hi focus:outline-none placeholder:text-txt-lo pl-2" />
                        <button @onclick="AddBrand" class="rounded-md bg-accent-500 px-3 py-1.5 text-xs font-semibold text-accent-on shadow-sm hover:bg-accent-600 transition-colors">Add</button>
                    </div>
                    <div class="relative w-[250px]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-txt-lo"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="search" @bind="brandSearch" @bind:event="oninput" placeholder="Search brands..." class="w-full rounded-lg border border-line-soft bg-elevated pl-8 pr-3 py-1.5 text-sm text-txt-hi placeholder:text-txt-lo focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all" />
                    </div>
                </div>
                <div class="overflow-y-auto flex-1 custom-scrollbar">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-elevated text-txt-mid border-b border-line-soft sticky top-0 z-10">
                            <tr>
                                <th class="px-5 py-2.5 font-semibold">Brand Name</th>
                                <th class="px-5 py-2.5 font-semibold text-right w-24">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line-soft">
                            @if (brands == null)
                            {
                                <tr><td colspan="2" class="px-5 py-6 text-center text-txt-mid">Loading...</td></tr>
                            }
                            else if (!FilteredBrands.Any())
                            {
                                <tr><td colspan="2" class="px-5 py-6 text-center text-txt-lo">No brands found.</td></tr>
                            }
                            else
                            {
                                @foreach (var brand in FilteredBrands)
                                {
                                    <tr class="hover:bg-elevated transition-colors group">
                                        @if (editingBrandId == brand.Id)
                                        {
                                            <td class="px-5 py-2">
                                                <input type="text" @bind="editBrandName" class="w-full rounded border border-accent-500 bg-transparent px-2 py-1 text-sm text-txt-hi focus:outline-none" />
                                            </td>
                                            <td class="px-5 py-2 text-right">
                                                <div class="flex items-center justify-end gap-2">
                                                    <button @onclick="() => SaveEditBrand(brand)" class="rounded bg-accent-500 px-2 py-1 text-[11px] font-medium text-accent-on hover:bg-accent-600 transition-colors">Save</button>
                                                    <button @onclick="CancelEditBrand" class="rounded bg-elevated px-2 py-1 text-[11px] font-medium text-txt-mid border border-line-soft hover:text-txt-hi transition-colors">Cancel</button>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="px-5 py-2 font-medium text-txt-hi">@brand.Name</td>
                                            <td class="px-5 py-2 text-right">
                                                <button @onclick="() => StartEditBrand(brand)" class="inline-flex h-7 w-7 items-center justify-center rounded text-accent-500 hover:bg-accent-500/10 opacity-70 group-hover:opacity-100 transition-all focus:opacity-100 mr-1" title="Edit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                                </button>
                                                <button @onclick="() => ShowDeleteBrandModal(brand.Id)" class="inline-flex h-7 w-7 items-center justify-center rounded text-danger-500 hover:bg-danger-500/10 opacity-70 group-hover:opacity-100 transition-all focus:opacity-100" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "Categories")
        {
            <div class="rounded-2xl border border-line-soft bg-surface shadow-sm overflow-hidden flex flex-col max-w-4xl lg:h-[calc(100vh-120px)]">
                <div class="p-4 border-b border-line-soft bg-surface flex justify-between items-center gap-4 shrink-0">
                    <div class="flex items-center gap-2 bg-elevated rounded-lg p-1 border border-line-soft focus-within:border-accent-border focus-within:ring-1 focus-within:ring-accent-500 transition-all">
                        <input type="text" @bind="newCategoryName" @bind:event="oninput" @onkeyup="@(e => { if(e.Key == "Enter") AddCategory(); })" placeholder="New category" class="w-[150px] bg-transparent text-sm text-txt-hi focus:outline-none placeholder:text-txt-lo pl-2" />
                        <select @bind="newCategoryType" class="bg-transparent text-sm text-txt-hi border-l border-line-soft pl-2 pr-1 py-1 focus:outline-none">
                            <option value="System">System</option>
                            <option value="Component">Component</option>
                            <option value="Peripheral">Peripheral</option>
                        </select>
                        <button @onclick="AddCategory" class="rounded-md bg-accent-500 px-3 py-1.5 text-xs font-semibold text-accent-on shadow-sm hover:bg-accent-600 transition-colors">Add</button>
                    </div>
                    <div class="relative w-[250px]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-txt-lo"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                        <input type="search" @bind="categorySearch" @bind:event="oninput" placeholder="Search categories..." class="w-full rounded-lg border border-line-soft bg-elevated pl-8 pr-3 py-1.5 text-sm text-txt-hi placeholder:text-txt-lo focus:border-accent-border focus:outline-none focus:ring-1 focus:ring-accent-500 transition-all" />
                    </div>
                </div>
                <div class="overflow-y-auto flex-1 custom-scrollbar">
                    <table class="w-full text-left text-sm whitespace-nowrap">
                        <thead class="bg-elevated text-txt-mid border-b border-line-soft sticky top-0 z-10">
                            <tr>
                                <th class="px-5 py-2.5 font-semibold">Category Name</th>
                                <th class="px-5 py-2.5 font-semibold">Type</th>
                                <th class="px-5 py-2.5 font-semibold text-right w-24">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line-soft">
                            @if (categories == null)
                            {
                                <tr><td colspan="3" class="px-5 py-6 text-center text-txt-mid">Loading...</td></tr>
                            }
                            else if (!FilteredCategories.Any())
                            {
                                <tr><td colspan="3" class="px-5 py-6 text-center text-txt-lo">No categories found.</td></tr>
                            }
                            else
                            {
                                @foreach (var category in FilteredCategories)
                                {
                                    <tr class="hover:bg-elevated transition-colors group">
                                        @if (editingCategoryId == category.Id)
                                        {
                                            <td class="px-5 py-2">
                                                <input type="text" @bind="editCategoryName" class="w-full rounded border border-accent-500 bg-transparent px-2 py-1 text-sm text-txt-hi focus:outline-none" />
                                            </td>
                                            <td class="px-5 py-2">
                                                <select @bind="editCategoryType" class="rounded border border-accent-500 bg-transparent px-2 py-1 text-sm text-txt-hi focus:outline-none">
                                                    <option value="System">System</option>
                                                    <option value="Component">Component</option>
                                                    <option value="Peripheral">Peripheral</option>
                                                </select>
                                            </td>
                                            <td class="px-5 py-2 text-right">
                                                <div class="flex items-center justify-end gap-2">
                                                    <button @onclick="() => SaveEditCategory(category)" class="rounded bg-accent-500 px-2 py-1 text-[11px] font-medium text-accent-on hover:bg-accent-600 transition-colors">Save</button>
                                                    <button @onclick="CancelEditCategory" class="rounded bg-elevated px-2 py-1 text-[11px] font-medium text-txt-mid border border-line-soft hover:text-txt-hi transition-colors">Cancel</button>
                                                </div>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="px-5 py-2 font-medium text-txt-hi">@category.Name</td>
                                            <td class="px-5 py-2">
                                                @if (!string.IsNullOrEmpty(category.Type))
                                                {
                                                    <span class="rounded bg-accent-soft px-1.5 py-0.5 text-[10px] font-medium text-accent-600 border border-accent-border/50">@category.Type</span>
                                                }
                                            </td>
                                            <td class="px-5 py-2 text-right">
                                                <button @onclick="() => StartEditCategory(category)" class="inline-flex h-7 w-7 items-center justify-center rounded text-accent-500 hover:bg-accent-500/10 opacity-70 group-hover:opacity-100 transition-all focus:opacity-100 mr-1" title="Edit">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                                </button>
                                                <button @onclick="() => ShowDeleteCategoryModal(category.Id)" class="inline-flex h-7 w-7 items-center justify-center rounded text-danger-500 hover:bg-danger-500/10 opacity-70 group-hover:opacity-100 transition-all focus:opacity-100" title="Delete">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "Designations")
        {
