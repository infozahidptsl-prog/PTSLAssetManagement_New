    private string GeneratePrefix(string companyName)
    {
        if (string.IsNullOrWhiteSpace(companyName)) return "";
        
        var words = companyName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        
        if (words.Length >= 3)
        {
            return $"{words[0][0]}{words[1][0]}{words[2][0]}".ToUpper();
        }
        else if (words.Length > 1)
        {
            return string.Join("", words.Select(w => w[0])).ToUpper();
        }
        else
        {
            var word = words[0];
            var upperChars = new string(word.Where(char.IsUpper).ToArray());
            if (upperChars.Length >= 2)
            {
                return upperChars;
            }
            return word.Substring(0, Math.Min(3, word.Length)).ToUpper();
        }
    }

