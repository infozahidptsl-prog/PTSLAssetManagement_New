    private async Task LoadData()
    {
        allDevices = await DeviceService.GetDevicesAsync();
        allEmployees = await EmployeeService.GetEmployeesAsync(true);
        
        employee = allEmployees.FirstOrDefault(e => e.Id.Equals(Id, StringComparison.OrdinalIgnoreCase));
        if (employee == null) return;

        var allHandovers = await HandoverService.GetHandoversAsync();
        var employeeHandovers = allHandovers.Where(h => h.To == employee.Name).ToList();
        
        var inUseBase = allDevices.Where(d => 
            ((!string.IsNullOrEmpty(d.EmployeeId) && d.EmployeeId == employee.EmployeeId) || 
            (!string.IsNullOrEmpty(d.UserName) && d.UserName == employee.Name)) &&
            d.Status == AssetManagement.Core.Enums.DeviceStatus.InUse
        ).ToList();

        var repairBase = allDevices.Where(d => 
            ((!string.IsNullOrEmpty(d.EmployeeId) && d.EmployeeId == employee.EmployeeId) || 
            (!string.IsNullOrEmpty(d.UserName) && d.UserName == employee.Name)) &&
            d.Status == AssetManagement.Core.Enums.DeviceStatus.InRepair
        ).ToList();

        heldItems = inUseBase;
        repairItems = repairBase;
        allAssignedItems = inUseBase.Concat(repairBase).ToList();

        // Generate movement feed for this employee
        var employeeMovements = new List<MovementDto>();
        foreach (var h in employeeHandovers)
        {
            var d = await DeviceService.GetDeviceByIdAsync(h.DeviceId);
            var assetId = d != null ? (string.IsNullOrEmpty(d.AssetTag) ? d.Id.ToString() : d.AssetTag) : h.DeviceId.ToString();
            
            employeeMovements.Add(new MovementDto
            {
                Type = "allocate",
                From = h.From,
                To = h.To,
                ItemId = assetId,
                Note = "Allocated to employee",
                Date = DateTime.TryParse(h.Released, out var dtRel) ? dtRel : DateTime.Now
            });

            if (!string.IsNullOrEmpty(h.ReturnDate))
            {
                employeeMovements.Add(new MovementDto
                {
                    Type = "return",
                    From = employee.Name,
                    To = "In stock",
                    ItemId = assetId,
                    Note = h.Condition ?? "Returned",
                    Date = DateTime.TryParse(h.ReturnDate, out var dtRet) ? dtRet : DateTime.Now
                });
            }
        }
        
        movements = employeeMovements.OrderByDescending(m => m.Date).ToList();
    }

