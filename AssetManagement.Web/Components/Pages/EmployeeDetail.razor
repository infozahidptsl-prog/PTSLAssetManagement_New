    private MarkupString ParseAboutText(string? about)
    {
        if (string.IsNullOrWhiteSpace(about)) return new MarkupString("");
        
        // Auto-heal broken paragraphs that don't end with sentence-ending punctuation.
        // This fixes legacy hard-wrapped text that got erroneously converted to separate <p> tags.
        // It looks for a word character or comma just before the closing </p> and merges it with the next <p>.
        about = System.Text.RegularExpressions.Regex.Replace(about, @"([a-zA-Z0-9,;-])\s*</p>\s*<p>", "$1 ");

        // Also if it's completely legacy plain text (no HTML tags at all), heal the hard wraps
        if (!about.Contains("<p>") && !about.Contains("<br>") && !about.Contains("<br/>") && !about.Contains("<strong>") && !about.Contains("<em>"))
        {
            about = System.Net.WebUtility.HtmlEncode(about);
            about = System.Text.RegularExpressions.Regex.Replace(about, @"(\r?\n){2,}", "<br /><br />");
            about = System.Text.RegularExpressions.Regex.Replace(about, @"\r?\n", " ");
        }

        // Replace the dynamic date tags
        var result = System.Text.RegularExpressions.Regex.Replace(about, @"\{\{YearsSince:(\d{4})\}\}", match =>
        {
            if (int.TryParse(match.Groups[1].Value, out int year))
            {
                return (DateTime.Now.Year - year).ToString();
            }
            return match.Value;
        });

        // Add physical Drop Cap to the very first letter to guarantee perfect rendering
        result = System.Text.RegularExpressions.Regex.Replace(result, @"^((?:\s*<[^>]+>\s*)*\s*)([a-zA-Z])", match => 
        {
            return $"{match.Groups[1].Value}<span class=\"float-left text-5xl font-serif font-bold text-[#DA943B] mr-2 -mt-1.5 leading-none\">{match.Groups[2].Value}</span>";
        });

        return new MarkupString(result);
    }

    private bool showQrModal = false;
    private bool copiedLink = false;

    private void OpenQrModal()
    {
        copiedLink = false;
        showQrModal = true;
    }

    private void CloseQrModal()
    {
        showQrModal = false;
    }

    private async Task CopyDeepLink()
    {
        if (employee == null) return;
        var link = GetEmployeeProfileDeepLink(employee);
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", link);
            copiedLink = true;
            StateHasChanged();
            await Task.Delay(2500);
            copiedLink = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard fallback
        }
    }

    private string GetEmployeeIdentifier(Employee emp)
    {
        if (!string.IsNullOrWhiteSpace(emp.EmployeeId)) return emp.EmployeeId.Trim();
        return emp.Id;
    }

    private string GetEmployeeProfileDeepLink(Employee emp)
    {
        if (emp == null || string.IsNullOrEmpty(emp.Id)) return string.Empty;
        var id = GetEmployeeIdentifier(emp);
        return AssetManagement.Web.Helpers.NetworkHelper.ToScannableUri(NavigationManager.BaseUri, $"/e/{id}");
    }

    private string GetEmployeeQrUrl(Employee emp, int size = 300)
    {
        var deepLink = GetEmployeeProfileDeepLink(emp);
        if (string.IsNullOrEmpty(deepLink)) return string.Empty;
        return AssetManagement.Web.Helpers.NetworkHelper.GetQrCodeUrl(deepLink, size, 2);
    }
