    private async Task HandleFileSelectedForCrop(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        try
        {
            var maxFileSize = 15 * 1024 * 1024; // 15MB
            using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var buffer = ms.ToArray();
            
            var format = file.ContentType?.ToLower() ?? "image/jpeg";
            if (!format.StartsWith("image/")) format = "image/jpeg";
            
            cropModalImageSrc = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
            currentCropAspectRatio = 238.0 / 176.0;
            showCropModal = true;
            isCropperInitializing = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading photo for crop: {ex.Message}");
