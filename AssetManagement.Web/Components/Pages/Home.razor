@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Core.Interfaces
@inject IDashboardService DashboardService
@inject NavigationManager NavigationManager

<PageTitle>Prime Tech Solutions Ltd.</PageTitle>

<style>
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @@keyframes growBarUp {
        0% { transform: scaleY(0); }
        100% { transform: scaleY(1); }
    }
    @@keyframes growBarRight {
        0% { width: 0%; }
    }
    @@keyframes drawGaugeArc {
        0% { stroke-dashoffset: 120; }
    }
    @@keyframes growWidth {
        0% { width: 0%; }
    }

    .dashboard-container {
        padding: 20px 28px 40px 28px;
        animation: fadeSlideUp 0.5s ease-out forwards;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        color: #0f172a;
        background: #f8fafc;
        min-height: calc(100vh - 60px);
    }

    /* Top Control Bar */
    .top-action-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }
    .search-input-wrap {
        position: relative;
        flex: 1;
        min-width: 280px;
        max-width: 480px;
    }
    .search-input-wrap svg {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        width: 17px;
        height: 17px;
        color: #94a3b8;
    }
    .search-input-wrap input {
        width: 100%;
        height: 42px;
        padding: 8px 16px 8px 42px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #ffffff;
        font-size: 13px;
        color: #0f172a;
        outline: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .search-input-wrap input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .top-controls-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
    .control-dropdown {
        height: 42px;
        padding: 0 14px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        background: #ffffff;
        font-size: 13px;
        font-weight: 500;
        color: #334155;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    }
    .control-dropdown:hover {
        border-color: #cbd5e1;
        background: #f8fafc;
    }
    .btn-export-pdf {
        height: 42px;
        padding: 0 18px;
        background: #0f172a;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 2px 4px rgba(15, 23, 42, 0.15);
    }
    .btn-export-pdf:hover {
        background: #1e293b;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.2);
    }

    /* Grids */
    .grid-kpis {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }
    .grid-charts {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 16px;
        margin-bottom: 20px;
    }
    .grid-bottom-3 {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 30px;
    }

    @@media(max-width: 1200px) {
        .grid-kpis { grid-template-columns: repeat(2, 1fr); }
        .grid-charts { grid-template-columns: 1fr; }
        .grid-bottom-3 { grid-template-columns: 1fr; }
    }
    @@media(max-width: 680px) {
        .grid-kpis { grid-template-columns: 1fr; }
        .dashboard-container { padding: 14px 16px 30px 16px; }
    }

    /* Card Base */
    .card-panel {
        background: #ffffff;
        border: 1px solid #eef2f6;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03), 0 4px 14px rgba(15, 23, 42, 0.02);
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-color 0.3s ease;
    }
    .card-panel:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px -6px rgba(15, 23, 42, 0.08), 0 8px 12px -6px rgba(15, 23, 42, 0.03);
        border-color: #cbd5e1;
    }

    /* Top KPI Cards */
    .kpi-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .kpi-header-title {
        font-size: 13px;
        font-weight: 600;
        color: #475569;
    }
    .pill-green {
        background: #ecfdf5;
        color: #059669;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }
    .pill-amber {
        background: #fef3c7;
        color: #b45309;
        font-size: 11px;
        font-weight: 600;
        padding: 2px 9px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
    }
    .kpi-big-num {
        font-size: 34px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1.1;
        margin-bottom: 8px;
        letter-spacing: -0.5px;
    }
    .kpi-meta-sub {
        font-size: 12px;
        color: #64748b;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .kpi-meta-sub strong {
        color: #0f172a;
        font-weight: 700;
    }

    /* Chart Section Headers */
    .chart-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
    }
    .chart-panel-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .chart-legend {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }
    .legend-indicator {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 3px;
        margin-right: 5px;
        vertical-align: middle;
    }

    /* Monthly Vertical Bar Chart */
    .monthly-chart-container {
        display: flex;
        align-items: stretch;
        gap: 12px;
        height: 220px;
        position: relative;
    }
    .monthly-y-axis {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-end;
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        height: 180px;
        margin-bottom: 28px;
        min-width: 28px;
        user-select: none;
    }
    .monthly-chart-body {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .monthly-plot-area {
        height: 180px;
        position: relative;
        display: flex;
        align-items: flex-end;
    }
    .monthly-gridlines {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        pointer-events: none;
    }
    .monthly-grid-line {
        width: 100%;
        height: 1px;
        background: #f1f5f9;
    }
    .monthly-bars-row {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        padding: 0 4px;
    }
    .monthly-bar-pair {
        display: flex;
        align-items: flex-end;
        gap: 3px;
        height: 100%;
        justify-content: center;
        flex: 1;
        max-width: 44px;
        position: relative;
    }
    .monthly-bar {
        width: 12px;
        min-height: 2px;
        border-radius: 2px 2px 0 0;
        transform-origin: bottom;
        animation: growBarUp 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        position: relative;
        cursor: pointer;
        transition: filter 0.2s ease, transform 0.2s ease;
    }
    .monthly-bar:hover {
        filter: brightness(1.15);
        transform: scaleX(1.15);
    }
    .monthly-bar-val {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%);
        font-size: 9.5px;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 2px;
        white-space: nowrap;
        pointer-events: none;
        transition: opacity 0.15s ease;
    }
    .monthly-bar-val.in-use {
        color: #25779d;
    }
    .monthly-bar-val.reserve {
        color: #2b2d5c;
    }
    .monthly-bar:hover .monthly-bar-val {
        opacity: 0;
    }
    .monthly-bar-tooltip {
        position: absolute;
        bottom: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(-6px);
        background: #0f172a;
        color: #ffffff;
        font-size: 10px;
        font-weight: 700;
        padding: 3px 6px;
        border-radius: 4px;
        white-space: nowrap;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.2s ease, transform 0.2s ease;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        z-index: 10;
    }
    .monthly-bar:hover .monthly-bar-tooltip {
        opacity: 1;
        transform: translateX(-50%) translateY(-2px);
    }
    .monthly-x-axis {
        display: flex;
        justify-content: space-around;
        align-items: center;
        height: 28px;
        border-top: 1px solid #e2e8f0;
        padding: 0 4px;
    }
    .monthly-x-label {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        text-align: center;
        flex: 1;
        max-width: 44px;
    }


    /* Stacked Department Horizontal Bar Chart */
    .stacked-chart-container {
        display: flex;
        flex-direction: column;
        gap: 14px;
        height: 220px;
        justify-content: space-between;
        position: relative;
    }
    .stacked-row {
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
    }
    .stacked-row-label {
        width: 85px;
        font-size: 12px;
        font-weight: 600;
        color: #334155;
        text-align: right;
        flex-shrink: 0;
        white-space: nowrap;
    }
    .stacked-bar-track {
        flex: 1;
        height: 22px;
        background: #f8fafc;
        border-radius: 3px;
        display: flex;
        align-items: stretch;
        overflow: hidden;
        position: relative;
    }
    .stacked-segment {
        height: 100%;
        transition: filter 0.2s ease;
        position: relative;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: growBarRight 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .stacked-segment:hover {
        filter: brightness(1.2);
    }
    .stacked-segment-val {
        font-size: 10px;
        font-weight: 700;
        color: #ffffff;
        white-space: nowrap;
        padding: 0 2px;
        line-height: 1;
        pointer-events: none;
        user-select: none;
    }
    .stacked-row-total {
        width: 32px;
        font-size: 12px;
        font-weight: 800;
        color: #0f172a;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
    }
    .stacked-x-axis {
        display: flex;
        justify-content: space-between;
        padding-left: 97px;
        padding-right: 44px;
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        border-top: 1px solid #f1f5f9;
        padding-top: 6px;
    }
    .stacked-grid-overlay {
        position: absolute;
        left: 97px;
        right: 44px;
        top: 0;
        bottom: 26px;
        display: flex;
        justify-content: space-between;
        pointer-events: none;
    }
    .stacked-v-grid {
        width: 1px;
        height: 100%;
        background: #f1f5f9;
    }


    /* Bottom Cards */
    .watch-row {
        margin-bottom: 14px;
    }
    .watch-row:last-child {
        margin-bottom: 0;
    }
    .watch-row-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 12px;
        margin-bottom: 6px;
    }
    .watch-row-title {
        font-weight: 600;
        color: #334155;
    }
    .watch-tag {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        background: #f1f5f9;
        padding: 2px 6px;
        border-radius: 4px;
    }
    .watch-progress-track {
        height: 6px;
        background: #f1f5f9;
        border-radius: 4px;
        overflow: hidden;
    }
    .watch-progress-fill {
        height: 100%;
        border-radius: 4px;
        animation: growWidth 1.2s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    /* Semicircular Gauge */
    .gauge-card-body {
        display: flex;
        align-items: center;
        gap: 16px;
        height: 130px;
    }
    .gauge-wrap {
        position: relative;
        width: 140px;
        height: 80px;
        display: flex;
        justify-content: center;
        align-items: flex-end;
    }
    .gauge-svg {
        width: 140px;
        height: 70px;
    }
    .gauge-inner-text {
        position: absolute;
        bottom: 2px;
        left: 50%;
        transform: translateX(-50%);
        text-align: center;
    }
    .gauge-percent {
        font-size: 24px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
    }
    .gauge-label {
        font-size: 10px;
        font-weight: 600;
        color: #64748b;
        margin-top: 2px;
    }
    .animated-gauge-arc {
        animation: drawGaugeArc 1.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }
    .gauge-legend-list {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .gauge-legend-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 600;
        color: #475569;
    }

    /* Critical Alerts */
    .alert-banner-box {
        border-radius: 10px;
        padding: 12px 14px;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-bottom: 10px;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .alert-banner-box:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .alert-banner-box:last-child {
        margin-bottom: 0;
    }
    .alert-blue-box {
        background: #f0f6ff;
        border: 1px solid #dbeafe;
    }
    .alert-amber-box {
        background: #fffbeb;
        border: 1px solid #fef3c7;
    }
    .alert-icon-circle {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .alert-box-title {
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2px;
    }
    .alert-box-sub {
        font-size: 11px;
        color: #64748b;
        font-weight: 500;
    }
</style>

@if (isLoading)
{
    <div style="display:flex;height:60vh;align-items:center;justify-content:center;flex-direction:column;gap:12px;">
        <div style="width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#2563eb;border-radius:50%;animation:spin 0.8s linear infinite;"></div>
        <p style="color:#64748b;font-size:13px;font-weight:600;">Loading executive dashboard data...</p>
        <style>@@keyframes spin { to { transform: rotate(360deg); } }</style>
    </div>
}
else
{
    <div class="dashboard-container">
        <!-- Top Action Bar -->
        <div class="top-action-bar">
            <!-- Search Bar -->
            <div class="search-input-wrap">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input type="text" placeholder="Search device, serial, employee ID..." @bind="searchQuery" @bind:event="oninput" @onkeydown="HandleSearchKey" />
            </div>

            <!-- Date, Dept Filter & Export Button -->
            <div class="top-controls-right">
                <div class="control-dropdown" title="Timeframe">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                    <span>@DateTime.Now.ToString("MMM yyyy")</span>
                    <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                </div>

                <select class="control-dropdown" @bind="selectedDepartment" style="outline:none;">
                    <option value="">Department Filter</option>
                    <option value="All">All Departments</option>
                    <option value="Engineering">Engineering</option>
                    <option value="Sales">Sales &amp; QC</option>
                    <option value="Operations">Operations</option>
                    <option value="Finance">Finance &amp; Accounts</option>
                    <option value="Design">Design &amp; Support</option>
                </select>

                <button class="btn-export-pdf" @onclick="ExportExecutivePdf">
                    <svg width="15" height="15" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span>Export Executive PDF</span>
                </button>
            </div>
        </div>

        <!-- 4-Column Executive KPI Cards -->
        <div class="grid-kpis">
            <!-- Card 1: Total Assets -->
            <div class="card-panel">
                <div class="kpi-header">
                    <span class="kpi-header-title">Total Assets</span>
                    <span class="pill-green">+@extras.MomGrowthPercentage% MoM</span>
                </div>
                <div class="kpi-big-num">@overview.TotalAssets</div>
                <div class="kpi-meta-sub">
                    Total Book Value <strong>৳@extras.TotalBookValue.ToString("N0")</strong>
                </div>
            </div>

            <!-- Card 2: Active Deployed -->
            <div class="card-panel">
                <div class="kpi-header">
                    <span class="kpi-header-title">Active Deployed</span>
                </div>
                <div class="kpi-big-num">@utilization.Assigned</div>
                <div class="kpi-meta-sub">
                    Utilization Rate <strong>@overview.UtilizationPercentage%</strong>
                    <span class="pill-green" style="margin-left:4px;">Trend ↗</span>
                </div>
            </div>

            <!-- Card 3: Available in Store -->
            <div class="card-panel">
                <div class="kpi-header">
                    <span class="kpi-header-title">Available in Store</span>
                </div>
                <div class="kpi-big-num">@overview.AvailableAssets</div>
                <div class="kpi-meta-sub">
                    Buffer inventory <strong>@GetBufferPercentage()%</strong>
                </div>
            </div>

            <!-- Card 4: In Repair / Maintenance -->
            <div class="card-panel">
                <div class="kpi-header">
                    <span class="kpi-header-title">In Repair / Maintenance</span>
                </div>
                <div class="kpi-big-num">@statusCounts.Faulty</div>
                <div class="kpi-meta-sub">
                    <span class="pill-amber">Fast resolution ETA</span>
                </div>
            </div>
        </div>

        <!-- Center Row: 2 Large Executive Bar Charts (Option 1 & Department Deployment) -->
        <div class="grid-charts">
            <!-- Left Chart: Monthly Inventory Utilization — In-Use vs. Reserve Stock (2026) -->
            <div class="card-panel">
                <div class="chart-panel-header" style="margin-bottom:14px;">
                    <div class="chart-panel-title">
                        Inventory Utilization — In-Use vs. Reserve Stock (2026)
                    </div>
                </div>

                <div class="monthly-chart-container">
                    <!-- Y-Axis labels (Dynamic Scale 0 to 160) -->
                    <div class="monthly-y-axis">
                        <span>160</span>
                        <span>120</span>
                        <span>80</span>
                        <span>40</span>
                        <span>0</span>
                    </div>

                    <!-- Chart Grid, Bars, and Separate X-Axis -->
                    <div class="monthly-chart-body">
                        <!-- Plot Area (above baseline) -->
                        <div class="monthly-plot-area">
                            <div class="monthly-gridlines">
                                <div class="monthly-grid-line"></div>
                                <div class="monthly-grid-line"></div>
                                <div class="monthly-grid-line"></div>
                                <div class="monthly-grid-line"></div>
                                <div class="monthly-grid-line"></div>
                            </div>

                            <div class="monthly-bars-row">
                                @{
                                    double maxScale = 160.0;
                                    foreach (var m in extras.MonthlyFlows)
                                    {
                                        double inUseHeightPct = Math.Min(100.0, (m.InUse / maxScale) * 100);
                                        double reserveHeightPct = Math.Min(100.0, (m.ReserveStock / maxScale) * 100);
                                        <div class="monthly-bar-pair">
                                            <!-- In-Use Bar (Steel Blue / Teal #25779d) -->
                                            <div class="monthly-bar" style="height:@inUseHeightPct%; background:#25779d;" title="@m.Month In-Use: @m.InUse">
                                                @if (m.InUse > 0)
                                                {
                                                    <span class="monthly-bar-val in-use">@m.InUse</span>
                                                }
                                                <div class="monthly-bar-tooltip">@m.InUse In-Use</div>
                                            </div>
                                            <!-- Reserve Stock Bar (Deep Indigo Navy #2b2d5c) -->
                                            <div class="monthly-bar" style="height:@reserveHeightPct%; background:#2b2d5c;" title="@m.Month Reserve: @m.ReserveStock">
                                                @if (m.ReserveStock > 0)
                                                {
                                                    <span class="monthly-bar-val reserve">@m.ReserveStock</span>
                                                }
                                                <div class="monthly-bar-tooltip">@m.ReserveStock Reserve</div>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <!-- Dedicated X-Axis Row below baseline -->
                        <div class="monthly-x-axis">
                            @foreach (var m in extras.MonthlyFlows)
                            {
                                <div class="monthly-x-label">@m.Month</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Bottom Legend matching user image -->
                <div style="display:flex; justify-content:center; align-items:center; gap:24px; margin-top:14px; font-size:12px; font-weight:600; color:#334155;">
                    <span style="display:inline-flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:#25779d;"></span>
                        In-Use (Active)
                    </span>
                    <span style="display:inline-flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:#2b2d5c;"></span>
                        Reserve Stock (In-Store)
                    </span>
                </div>
            </div>

            <!-- Right Chart: Fleet Status by Hardware Category (Stacked Horizontal Bar) -->
            <div class="card-panel">
                <div class="chart-panel-header" style="margin-bottom:14px;">
                    <div class="chart-panel-title">
                        Fleet Status by Hardware Category
                    </div>
                </div>

                <div class="stacked-chart-container">
                    <!-- Subtle background vertical gridlines -->
                    <div class="stacked-grid-overlay">
                        <div class="stacked-v-grid"></div>
                        <div class="stacked-v-grid"></div>
                        <div class="stacked-v-grid"></div>
                        <div class="stacked-v-grid"></div>
                        <div class="stacked-v-grid"></div>
                        <div class="stacked-v-grid"></div>
                    </div>

                    @{
                        int maxTotal = extras.DepartmentDeployments.Count > 0 ? extras.DepartmentDeployments.Max(d => d.Total) : 25;
                        double maxDepScale = Math.Max(25.0, Math.Ceiling(maxTotal / 5.0) * 5.0);
                        foreach (var d in extras.DepartmentDeployments)
                        {
                            double actWidth = Math.Min(100.0, (d.Active / maxDepScale) * 100.0);
                            double storeWidth = Math.Min(100.0, (d.InStore / maxDepScale) * 100.0);
                            double maintWidth = Math.Min(100.0, (d.Maintenance / maxDepScale) * 100.0);
                            <div class="stacked-row">
                                <div class="stacked-row-label">@d.Category</div>
                                <div class="stacked-bar-track">
                                    <!-- Active (Deep Navy #2b2d5c) -->
                                    @if (d.Active > 0)
                                    {
                                        <div class="stacked-segment" style="width:@actWidth%; background:#2b2d5c;" title="@d.Category Active: @d.Active">
                                            @if (actWidth >= 8.0)
                                            {
                                                <span class="stacked-segment-val">@d.Active</span>
                                            }
                                        </div>
                                    }
                                    <!-- In-Store (Steel Blue #25779d) -->
                                    @if (d.InStore > 0)
                                    {
                                        <div class="stacked-segment" style="width:@storeWidth%; background:#25779d;" title="@d.Category In-Store: @d.InStore">
                                            @if (storeWidth >= 8.0)
                                            {
                                                <span class="stacked-segment-val">@d.InStore</span>
                                            }
                                        </div>
                                    }
                                    <!-- Maintenance (Coral Orange #dd5738) -->
                                    @if (d.Maintenance > 0)
                                    {
                                        <div class="stacked-segment" style="width:@maintWidth%; background:#dd5738;" title="@d.Category Maintenance: @d.Maintenance">
                                            @if (maintWidth >= 8.0)
                                            {
                                                <span class="stacked-segment-val">@d.Maintenance</span>
                                            }
                                        </div>
                                    }
                                </div>
                                <div class="stacked-row-total" title="Total @d.Category: @d.Total">@d.Total</div>
                            </div>
                        }
                    }

                    <!-- X-Axis Reference Scale -->
                    <div class="stacked-x-axis">
                        <span>0</span>
                        <span>@((int)(maxDepScale * 0.2))</span>
                        <span>@((int)(maxDepScale * 0.4))</span>
                        <span>@((int)(maxDepScale * 0.6))</span>
                        <span>@((int)(maxDepScale * 0.8))</span>
                        <span>@((int)maxDepScale)</span>
                    </div>
                </div>

                <!-- Bottom Legend matching user image -->
                <div style="display:flex; justify-content:center; align-items:center; gap:20px; margin-top:14px; font-size:12px; font-weight:600; color:#334155;">
                    <span style="display:inline-flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:#2b2d5c;"></span>
                        Active
                    </span>
                    <span style="display:inline-flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:#25779d;"></span>
                        In-Store
                    </span>
                    <span style="display:inline-flex; align-items:center; gap:6px;">
                        <span style="display:inline-block; width:12px; height:12px; border-radius:3px; background:#dd5738;"></span>
                        Maintenance
                    </span>
                </div>
            </div>
        </div>

        <!-- Bottom Row: 3 Panels -->
        <div class="grid-bottom-3">
            <!-- Panel 1: Warranty & Depreciation Watch -->
            <div class="card-panel">
                <div class="chart-panel-title" style="margin-bottom:18px;">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#2563eb" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                    Warranty &amp; Depreciation Watch
                </div>

                <div class="watch-row">
                    <div class="watch-row-top">
                        <span class="watch-row-title">@lifecycleRisk.WarrantyExpiring30Days assets expire in less than 30 days</span>
                        <span class="watch-tag">&lt; 30 days</span>
                    </div>
                    <div class="watch-progress-track">
                        <div class="watch-progress-fill" style="width:@(Math.Max(overview.TotalAssets > 0 ? (lifecycleRisk.WarrantyExpiring30Days * 100.0 / overview.TotalAssets) : 0, lifecycleRisk.WarrantyExpiring30Days > 0 ? 12 : 2))%; background:#2563eb;"></div>
                    </div>
                </div>

                <div class="watch-row">
                    <div class="watch-row-top">
                        <span class="watch-row-title">@lifecycleRisk.WarrantyExpiring90Days assets expiring in 90 days</span>
                        <span class="watch-tag">&lt; 90 days</span>
                    </div>
                    <div class="watch-progress-track">
                        <div class="watch-progress-fill" style="width:@(Math.Max(overview.TotalAssets > 0 ? (lifecycleRisk.WarrantyExpiring90Days * 100.0 / overview.TotalAssets) : 0, lifecycleRisk.WarrantyExpiring90Days > 0 ? 12 : 2))%; background:#059669;"></div>
                    </div>
                </div>

                <div class="watch-row">
                    <div class="watch-row-top">
                        <span class="watch-row-title">@(lifecycleRisk.Faulty + lifecycleRisk.Scrapped + lifecycleRisk.WarrantyExpired) assets requiring repair / end of lifecycle</span>
                        <span class="watch-tag" style="color:#d97706; background:#fef3c7;">Action required</span>
                    </div>
                    <div class="watch-progress-track">
                        <div class="watch-progress-fill" style="width:@(Math.Max(overview.TotalAssets > 0 ? ((lifecycleRisk.Faulty + lifecycleRisk.Scrapped + lifecycleRisk.WarrantyExpired) * 100.0 / overview.TotalAssets) : 0, (lifecycleRisk.Faulty + lifecycleRisk.Scrapped + lifecycleRisk.WarrantyExpired) > 0 ? 18 : 2))%; background:#d97706;"></div>
                    </div>
                </div>
            </div>

            <!-- Panel 2: Hardware Health & Fleet Condition -->
            <div class="card-panel">
                <div class="chart-panel-title" style="margin-bottom:16px;">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#059669" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                    Hardware Health &amp; Fleet Condition
                </div>

                <div class="gauge-card-body">
                    <!-- Gauge Semicircle Arch -->
                    <div class="gauge-wrap">
                        <svg viewBox="0 0 100 56" class="gauge-svg">
                            <!-- Background Track Arc -->
                            <path d="M 12 48 A 38 38 0 0 1 88 48" fill="none" stroke="#f1f5f9" stroke-width="8" stroke-linecap="round"/>
                            <!-- Animated Gauge Indicator (circumference ~ 119.38) -->
                            @{
                                double gaugeOffset = 119.38 * (1.0 - (extras.FleetHealthScore / 100.0));
                            }
                            <path class="animated-gauge-arc" d="M 12 48 A 38 38 0 0 1 88 48" fill="none" stroke="#059669" stroke-width="8" stroke-linecap="round"
                                  stroke-dasharray="119.38" stroke-dashoffset="@gaugeOffset.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)"/>
                        </svg>
                        <div class="gauge-inner-text">
                            <div class="gauge-percent">@extras.FleetHealthScore%</div>
                            <div class="gauge-label">Fleet Health</div>
                        </div>
                    </div>

                    <!-- Legend Items -->
                    <div class="gauge-legend-list">
                        <div class="gauge-legend-item">
                            <span><span style="color:#059669;">●</span> Healthy</span>
                            <span style="font-weight:700; color:#0f172a;">@extras.HealthyCount</span>
                        </div>
                        <div class="gauge-legend-item">
                            <span><span style="color:#d97706;">●</span> At Risk</span>
                            <span style="font-weight:700; color:#0f172a;">@extras.AtRiskCount</span>
                        </div>
                        <div class="gauge-legend-item">
                            <span><span style="color:#ef4444;">●</span> Obsolete</span>
                            <span style="font-weight:700; color:#0f172a;">@extras.ObsoleteCount</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Panel 3: Recent Critical Alerts & Audit Trail -->
            <div class="card-panel">
                <div class="chart-panel-title" style="margin-bottom:14px;">
                    <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="#ea580c" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                    Recent Critical Alerts &amp; Audit Trail
                </div>

                <!-- Alert 1: Duplicate Serials -->
                <a href="/automation" class="alert-banner-box alert-blue-box">
                    <div class="alert-icon-circle" style="background:#dbeafe; color:#2563eb;">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                        </svg>
                    </div>
                    <div>
                        <div class="alert-box-title">Duplicate Serial Check</div>
                        <div class="alert-box-sub">@(extras.DuplicateSerialsCount > 0 ? $"{extras.DuplicateSerialsCount} duplicate serial numbers flagged" : "Audit verified — No conflicts")</div>
                    </div>
                </a>

                <!-- Alert 2: Pending Manager Approvals -->
                <a href="/requisitions" class="alert-banner-box alert-amber-box">
                    <div class="alert-icon-circle" style="background:#fef3c7; color:#d97706;">
                        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="12" y1="8" x2="12" y2="12" />
                            <line x1="12" y1="16" x2="12.01" y2="16" />
                        </svg>
                    </div>
                    <div>
                        <div class="alert-box-title">Pending Manager Approvals</div>
                        <div class="alert-box-sub">@(extras.PendingApprovalsCount > 0 ? $"{extras.PendingApprovalsCount} asset requisitions awaiting review" : "All requisitions up to date")</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private string searchQuery = string.Empty;
    private string selectedDepartment = string.Empty;

    private DashboardKpiOverview overview = new();
    private AssetStatusCounts statusCounts = new();
    private List<CategoryCount> categoryBreakdown = new();
    private UtilizationMetrics utilization = new();
    private LifecycleRiskMetrics lifecycleRisk = new();
    private RepairTrendMetrics repairTrend = new();
    private List<GroupedAttentionFinding> attentionFindings = new();
    private ExecutiveDashboardExtras extras = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            overview          = await DashboardService.GetOverviewAsync();
            statusCounts      = await DashboardService.GetAssetStatusAsync();
            categoryBreakdown = await DashboardService.GetCategoryBreakdownAsync();
            utilization       = await DashboardService.GetUtilizationAsync();
            lifecycleRisk     = await DashboardService.GetLifecycleRiskAsync();
            repairTrend       = await DashboardService.GetRepairTrendAsync();
            attentionFindings = await DashboardService.GetNeedsAttentionGroupedAsync();
            extras            = await DashboardService.GetExecutiveExtrasAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private double GetBufferPercentage()
    {
        if (overview.TotalAssets == 0) return 0;
        return Math.Round(((double)overview.AvailableAssets / overview.TotalAssets) * 100, 1);
    }

    private class CategoryDisplayItem
    {
        public string Name { get; set; } = string.Empty;
        public int Count { get; set; }
        public string Color { get; set; } = "#2563eb";
    }

    private List<CategoryDisplayItem> GetFormattedCategories()
    {
        int laptop = categoryBreakdown.FirstOrDefault(c => c.Category.Contains("Laptop", StringComparison.OrdinalIgnoreCase))?.Count ?? 78;
        int desktop = categoryBreakdown.FirstOrDefault(c => c.Category.Contains("Desktop", StringComparison.OrdinalIgnoreCase))?.Count ?? 42;
        int monitor = categoryBreakdown.FirstOrDefault(c => c.Category.Contains("Monitor", StringComparison.OrdinalIgnoreCase))?.Count ?? 31;
        int mobile = categoryBreakdown.FirstOrDefault(c => c.Category.Contains("Mobile", StringComparison.OrdinalIgnoreCase) || c.Category.Contains("Phone", StringComparison.OrdinalIgnoreCase))?.Count ?? 12;
        int network = categoryBreakdown.FirstOrDefault(c => c.Category.Contains("Server", StringComparison.OrdinalIgnoreCase) || c.Category.Contains("Network", StringComparison.OrdinalIgnoreCase))?.Count ?? 8;

        return new List<CategoryDisplayItem>
        {
            new CategoryDisplayItem { Name = "Laptops", Count = laptop, Color = "#0f172a" },
            new CategoryDisplayItem { Name = "Desktops", Count = desktop, Color = "#2563eb" },
            new CategoryDisplayItem { Name = "Displays/Monitors", Count = monitor, Color = "#059669" },
            new CategoryDisplayItem { Name = "Mobile Devices", Count = mobile, Color = "#d97706" },
            new CategoryDisplayItem { Name = "Network Gear", Count = network, Color = "#475569" }
        };
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            NavigationManager.NavigateTo($"/all-assets?q={Uri.EscapeDataString(searchQuery)}");
        }
    }

    private void ExportExecutivePdf()
    {
        NavigationManager.NavigateTo("/reports");
    }
}

