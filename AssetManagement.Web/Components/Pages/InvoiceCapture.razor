@page "/ai/invoice"
@using Microsoft.AspNetCore.Authorization
@using AssetManagement.Core.Interfaces
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Infrastructure.Services
@using AssetManagement.Web.Components.Shared
@using System.IO
@attribute [Authorize]
@rendermode InteractiveServer

@inject PurchaseService PurchaseService
@inject DeviceService DeviceService
@inject NavigationManager NavigationManager
@inject IAiDocumentExtractionService AiService
@inject IOcrService OcrService
@inject IAiFieldMappingService FieldMappingService
@inject IAiValidationService ValidationService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject NotificationService Notifications
@inject ISettingsService SettingsService
@implements IAsyncDisposable

<PageTitle>Prime Tech Solutions Ltd.</PageTitle>

<div class="bg-surface pb-2 border-b border-line-soft">
    <PageHeader Title="AI Intake &amp; Invoices Registry" 
                Description="Guided 4-step wizard: Upload invoices, verify extracted items, fast-tag physical asset serials, and print QR labels.">
        <Actions>
            @if (activeMainTab == "upload")
            {
                @if (currentStep == 2)
                {
                    <button type="button" @onclick="AnalyzeDocuments" disabled="@isAnalyzing" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-line bg-elevated text-txt-hi hover:border-line-strong transition-colors shadow-xs">
                        <svg class="w-3.5 h-3.5 @(isAnalyzing ? "animate-spin" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        Re-extract
                    </button>
                    <button type="button" @onclick="ResetForm" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-line bg-elevated text-txt-hi hover:border-line-strong transition-colors shadow-xs">
                        New Upload
                    </button>
                    @if (captureMode == 1)
                    {
                        <button type="button" @onclick="PostPurchase" disabled="@isPosting" class="inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-bold rounded-md bg-accent-500 text-white hover:bg-accent-600 shadow-xs transition-colors whitespace-nowrap shrink-0">
                            Save &amp; Tag Assets &rarr;
                        </button>
                    }
                    else
                    {
                        <button type="button" @onclick="RegisterDirectDevice" disabled="@isRegisteringDevice" class="inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-bold rounded-md bg-emerald-600 text-white hover:bg-emerald-700 shadow-xs transition-colors whitespace-nowrap shrink-0">
                            Register Device Directly
                        </button>
                    }
                }
                else if (currentStep == 3)
                {
                    <button type="button" @onclick="() => currentStep = 2" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-line bg-elevated text-txt-hi hover:border-line-strong transition-colors shadow-xs">
                        &larr; Back to Invoice
                    </button>
                    <button type="button" @onclick="SkipAndFinishStep3" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-line bg-elevated text-txt-hi hover:border-line-strong transition-colors shadow-xs">
                        Skip Untagged &amp; Finish
                    </button>
                    <button type="button" @onclick="RegisterTaggedUnits" disabled="@isRegisteringUnits" class="inline-flex items-center gap-1.5 px-4 py-1.5 text-xs font-bold rounded-md bg-emerald-600 text-white hover:bg-emerald-700 shadow-xs transition-colors whitespace-nowrap shrink-0">
                        Register Units &rarr;
                    </button>
                }
                else if (currentStep == 4)
                {
                    <button type="button" @onclick="PrintQrLabels" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold rounded-md bg-accent-500 text-white hover:bg-accent-600 transition-colors shadow-xs">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                        Print QR Labels
                    </button>
                    <button type="button" @onclick="ResetForm" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-line bg-elevated text-txt-hi hover:border-line-strong transition-colors shadow-xs">
                        + New Invoice
                    </button>
                }
            }
            else if (activeMainTab == "registry")
            {
                <button type="button" @onclick='() => SetActiveMainTab("upload")' class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md border border-accent-300 bg-accent-soft text-accent-700 hover:bg-accent-100 transition-colors shadow-xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
                    + AI Invoice Wizard
                </button>
                <button type="button" @onclick="OpenAddModal" class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-md bg-accent-500 text-white hover:bg-accent-600 transition-colors shadow-xs">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Manual Purchase
                </button>
            }
        </Actions>
    </PageHeader>
</div>

<!-- Navigation Tabs Switcher -->
<div class="px-6 pt-3 lg:px-9 flex items-center justify-between border-b border-line-soft bg-surface">
    <div class="flex items-center gap-6">
        <button type="button" @onclick='() => SetActiveMainTab("upload")' class="pb-3 text-[13px] font-semibold transition-colors border-b-2 flex items-center gap-2 @(activeMainTab == "upload" ? "border-accent-500 text-accent-600" : "border-transparent text-txt-mid hover:text-txt-hi")">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
            AI Document Intake
        </button>
        <button type="button" @onclick='() => SetActiveMainTab("registry")' class="pb-3 text-[13px] font-semibold transition-colors border-b-2 flex items-center gap-2 @(activeMainTab == "registry" ? "border-accent-500 text-accent-600" : "border-transparent text-txt-mid hover:text-txt-hi")">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            Invoices &amp; Purchases Registry
            <span class="rounded-full bg-accent-soft text-accent-600 px-2 py-0.5 text-[10px] font-mono font-bold">@allPurchases.Count</span>
        </button>
    </div>
</div>

<div class="w-full pt-4 space-y-6">
    @if (activeMainTab == "upload")
    {
        <style>
            @@media print {
                body * {
                    visibility: hidden !important;
                }
                #printable-qr-sheet, #printable-qr-sheet * {
                    visibility: visible !important;
                }
                #printable-qr-sheet {
                    position: absolute !important;
                    left: 0 !important;
                    top: 0 !important;
                    width: 100% !important;
                    margin: 0 !important;
                    padding: 16px !important;
                    background: white !important;
                    color: black !important;
                }
                .no-print {
                    display: none !important;
                }
            }
        </style>

        @if (captureMode == 1)
        {
            <!-- 4-STEP WIZARD PROGRESS BAR -->
            <div class="max-w-3xl mx-auto mb-8 px-4 no-print">
                <div class="relative flex items-center justify-between">
                    <div class="absolute left-6 right-6 top-5 -translate-y-1/2 h-1 bg-line rounded-full z-0"></div>
                    <div class="absolute left-6 top-5 -translate-y-1/2 h-1 bg-accent-500 rounded-full transition-all duration-500 z-0" 
                         style="width: calc(@(StepProgressPercent)% * 0.88);"></div>

                    <!-- STEP 1: Upload -->
                    <div class="relative z-10 flex flex-col items-center cursor-pointer select-none" @onclick="() => GoToStep(1)">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all duration-300 @(currentStep > 1 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 1 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 1)
                            {
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                <span>1</span>
                            }
                        </div>
                        <span class="mt-2 text-xs font-bold @(currentStep == 1 ? "text-accent-600" : currentStep > 1 ? "text-emerald-600" : "text-txt-lo")">
                            Upload Invoice
                        </span>
                        <span class="text-[10px] text-txt-lo hidden sm:block">PDF / Image</span>
                    </div>

                    <!-- STEP 2: Review Invoice -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep >= 2 ? "cursor-pointer" : "cursor-not-allowed") select-none" @onclick="() => GoToStep(2)">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all duration-300 @(currentStep > 2 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 2 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 2)
                            {
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                <span>2</span>
                            }
                        </div>
                        <span class="mt-2 text-xs font-bold @(currentStep == 2 ? "text-accent-600" : currentStep > 2 ? "text-emerald-600" : "text-txt-lo")">
                            Review &amp; Verify
                        </span>
                        <span class="text-[10px] text-txt-lo hidden sm:block">Items &amp; Costs</span>
                    </div>

                    <!-- STEP 3: Tag Serials -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep >= 3 ? "cursor-pointer" : "cursor-not-allowed") select-none" @onclick="() => GoToStep(3)">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all duration-300 @(currentStep > 3 ? "bg-emerald-500 text-white shadow-sm ring-4 ring-emerald-100" : currentStep == 3 ? "bg-accent-500 text-white shadow-md ring-4 ring-accent-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep > 3)
                            {
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                <span>3</span>
                            }
                        </div>
                        <span class="mt-2 text-xs font-bold @(currentStep == 3 ? "text-accent-600" : currentStep > 3 ? "text-emerald-600" : "text-txt-lo")">
                            Tag Asset Serials
                        </span>
                        <span class="text-[10px] text-txt-lo hidden sm:block">Unit Allocation</span>
                    </div>

                    <!-- STEP 4: Complete & QR -->
                    <div class="relative z-10 flex flex-col items-center @(currentStep >= 4 ? "cursor-pointer" : "cursor-not-allowed") select-none" @onclick="() => GoToStep(4)">
                        <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-xs transition-all duration-300 @(currentStep == 4 ? "bg-emerald-600 text-white shadow-md ring-4 ring-emerald-100" : "bg-surface border-2 border-line text-txt-lo")">
                            @if (currentStep == 4)
                            {
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                            }
                            else
                            {
                                <span>4</span>
                            }
                        </div>
                        <span class="mt-2 text-xs font-bold @(currentStep == 4 ? "text-emerald-600" : "text-txt-lo")">
                            Complete &amp; QR
                        </span>
                        <span class="text-[10px] text-txt-lo hidden sm:block">Print &amp; Inventory</span>
                    </div>
                </div>
            </div>
        }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="mb-6 p-4 rounded-xl bg-danger-50 text-danger-700 border border-danger-200 text-sm flex items-start gap-3 max-w-4xl mx-auto">
            <svg class="w-5 h-5 shrink-0 mt-0.5 text-danger-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
            <div class="flex-1">
                <div class="font-bold">Extraction / Validation Alert</div>
                <div>@errorMessage</div>
            </div>
            <button @onclick="() => errorMessage = null" class="text-danger-400 hover:text-danger-600">&times;</button>
        </div>
    }

    @if (currentStep == 1)
    {
        <!-- STEP 1: Two Options Selector & Upload Card -->
        <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8 shadow-sm max-w-4xl mx-auto">

            <!-- Mode Selector Switch -->
            <div class="flex flex-col items-center justify-center mb-8">
                <div class="text-[11px] font-bold uppercase tracking-wider text-txt-lo mb-2">Choose Upload Document Type</div>
                <div class="inline-flex p-1.5 bg-elevated border border-line rounded-2xl shadow-xs gap-1">
                    <button type="button" @onclick="() => SetCaptureMode(1)" 
                        class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @(captureMode == 1 ? "bg-surface text-accent-600 shadow-sm border border-line-soft font-extrabold" : "text-txt-mid hover:text-txt-hi")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Option 1: Supplier Invoice / Challan
                    </button>
                    <button type="button" @onclick="() => SetCaptureMode(2)" 
                        class="px-5 py-2.5 rounded-xl text-xs font-bold transition-all flex items-center gap-2 @(captureMode == 2 ? "bg-surface text-emerald-600 shadow-sm border border-line-soft font-extrabold" : "text-txt-mid hover:text-txt-hi")">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Option 2: Device Details / Label (No Invoice)
                    </button>
                </div>
            </div>

            <!-- Header Description based on Mode -->
            <div class="text-center mb-8">
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl @(captureMode == 1 ? "bg-accent-50 text-accent-600" : "bg-emerald-50 text-emerald-600") mb-4 shadow-sm border border-line-soft">
                    @if (captureMode == 1)
                    {
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    }
                    else
                    {
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    }
                </div>
                <h2 class="text-xl font-bold text-txt-hi">
                    @(captureMode == 1 ? "Upload Supplier Invoices & Delivery Challans" : "Upload Physical Device Label or Hardware Specs")
                </h2>
                <p class="text-sm text-txt-mid mt-1 max-w-md mx-auto">
                    @(captureMode == 1 
                        ? "AI extracts vendor, invoice number, line items, costs, and serials. Supports multi-page PDFs, scans, and photos." 
                        : "No invoice available? Upload device back stickers, box serials, or system info screenshots to extract specs and register directly.")
                </p>
            </div>

            <!-- Upload Area & Clipboard Target -->
            <label class="group relative flex flex-col items-center justify-center border-2 border-dashed @(captureMode == 1 ? "border-accent-300/60 hover:border-accent-500 bg-accent-500/5 hover:bg-accent-500/10" : "border-emerald-300/60 hover:border-emerald-500 bg-emerald-500/5 hover:bg-emerald-500/10") p-10 rounded-2xl cursor-pointer transition-all duration-300 mb-6 text-center">
                <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-full bg-surface shadow-sm border border-line-soft group-hover:scale-105 transition-transform">
                    <svg class="w-6 h-6 @(captureMode == 1 ? "text-accent-600" : "text-emerald-600")" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                </div>
                <span class="text-txt-hi font-bold text-base mb-1">
                    @(captureMode == 1 ? "Click to browse or drag & drop invoice documents here" : "Click to browse or drag & drop device photos / screenshots here")
                </span>
                <span class="text-xs text-txt-mid">Or simply press <kbd class="px-2 py-0.5 bg-surface border border-line-strong rounded font-mono text-[11px] text-txt-hi shadow-xs">Ctrl + V</kbd> to paste clipboard images</span>
                <InputFile OnChange="HandleFilesSelected" multiple accept=".jpg,.jpeg,.png,.pdf" class="hidden" />
            </label>

            @if (uploadedFiles.Any())
            {
                <div class="mb-6">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo mb-3 flex items-center justify-between">
                        <span>Document Queue (@uploadedFiles.Count)</span>
                        <span class="text-[11px] text-txt-mid font-normal">
                            @(captureMode == 1 ? "All documents combined into a single extraction session" : "Ready for hardware spec extraction")
                        </span>
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                        @foreach (var file in uploadedFiles)
                        {
                            <div class="flex items-center justify-between p-3.5 bg-elevated rounded-xl border border-line shadow-xs group">
                                <div class="flex items-center gap-3 overflow-hidden">
                                    <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface text-accent-600 border border-line-soft">
                                        @if (file.ContentType.Contains("pdf"))
                                        {
                                            <span class="text-[10px] font-black uppercase tracking-tighter">PDF</span>
                                        }
                                        else
                                        {
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        }
                                    </div>
                                    <div class="truncate">
                                        <div class="text-xs font-semibold text-txt-hi truncate">@file.Name</div>
                                        <div class="text-[10px] text-txt-lo">@((file.Bytes.Length / 1024.0).ToString("N0")) KB</div>
                                    </div>
                                </div>
                                <button type="button" @onclick="() => RemoveFile(file)" class="text-txt-muted hover:text-danger-500 p-1.5 rounded-lg hover:bg-danger-50 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex justify-end pt-4 border-t border-line-soft">
                    <button type="button" @onclick="AnalyzeDocuments" disabled="@isAnalyzing" style="padding: 12px 32px;" class="px-6 py-3 @(captureMode == 1 ? "bg-accent-500 hover:bg-accent-600" : "bg-emerald-600 hover:bg-emerald-700") text-white font-bold text-sm rounded-xl shadow-md disabled:opacity-50 transition-all inline-flex items-center gap-2.5 whitespace-nowrap cursor-pointer">
                        @if (isAnalyzing)
                        {
                            <svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span>Extracting Data...</span>
                        }
                        else
                        {
                            <svg class="w-4 h-4 shrink-0 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            <span class="whitespace-nowrap">@(captureMode == 1 ? "Run AI Invoice Extraction" : "Run AI Device Extraction")</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
    else if (currentStep == 2 && captureMode == 1 && purchaseForm != null)
    {
        <!-- MODE 1: Invoice Review Workspace -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- LEFT COLUMN: Document Preview & Navigation -->
            <div class="lg:col-span-5 flex flex-col gap-4">
                <div class="bg-surface rounded-2xl border border-line shadow-sm overflow-hidden sticky top-6">
                    <div class="p-3 bg-elevated border-b border-line flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-txt-hi">Document Viewer</span>
                            <span class="text-[11px] text-txt-lo">(@(selectedPreviewIndex + 1) of @uploadedFiles.Count)</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button type="button" @onclick="PrevPreview" disabled="@(selectedPreviewIndex == 0)" title="@(selectedPreviewIndex == 0 ? "First document" : "Previous document")" class="px-2.5 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold text-txt-hi transition-colors">
                                &larr; Prev
                            </button>
                            <button type="button" @onclick="NextPreview" disabled="@(selectedPreviewIndex >= uploadedFiles.Count - 1)" title="@(selectedPreviewIndex >= uploadedFiles.Count - 1 ? "Last document" : "Next document")" class="px-2.5 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold text-txt-hi transition-colors">
                                Next &rarr;
                            </button>
                            <div class="h-4 w-px bg-line mx-1"></div>
                            <button type="button" @onclick="ZoomOut" disabled="@(zoomScale <= 0.75)" title="Zoom Out" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 text-xs font-bold text-txt-hi">
                                &minus;
                            </button>
                            <span class="text-[11px] font-mono font-bold text-txt-mid min-w-[38px] text-center">@((int)(zoomScale * 100))%</span>
                            <button type="button" @onclick="ZoomIn" disabled="@(zoomScale >= 2.5)" title="Zoom In" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 text-xs font-bold text-txt-hi">
                                +
                            </button>
                            <button type="button" @onclick="ResetZoom" title="Reset to 100%" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated text-xs font-semibold text-txt-mid">
                                Reset
                            </button>
                        </div>
                    </div>

                    <div class="p-4 bg-slate-900/5 min-h-[480px] max-h-[750px] overflow-auto flex items-center justify-center">
                        @if (uploadedFiles.Any())
                        {
                            var currentPreview = uploadedFiles[selectedPreviewIndex];
                            if (currentPreview.ContentType.Contains("pdf"))
                            {
                                <embed src="@currentPreview.DataUrl" type="application/pdf" class="w-full h-[650px] rounded-lg border border-line-soft shadow-xs" />
                            }
                            else
                            {
                                <img src="@currentPreview.DataUrl" alt="Document Preview" style="transform: scale(@(zoomScale.ToString(System.Globalization.CultureInfo.InvariantCulture))); transform-origin: top center;" class="max-w-full rounded-lg shadow-sm transition-transform duration-150 cursor-zoom-in" @onclick="ToggleImageZoom" />
                            }
                        }
                    </div>

                    <div class="p-3 bg-surface border-t border-line flex items-center justify-between text-xs text-txt-mid">
                        <span class="truncate max-w-[200px]">@uploadedFiles[selectedPreviewIndex].Name</span>
                        <label class="cursor-pointer font-semibold text-accent-600 hover:text-accent-700">
                            + Add Supporting Document
                            <InputFile OnChange="HandleAdditionalFilesSelected" accept=".jpg,.jpeg,.png,.pdf" class="hidden" />
                        </label>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Editable Invoice Header, Line Items, Reconciliation -->
            <div class="lg:col-span-7 flex flex-col gap-6">

                <!-- Validation Alerts & Duplicates -->
                @if (validationWarnings.Any())
                {
                    <div class="p-4 rounded-xl bg-warn-50 border border-warn-200">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-warn-800 flex items-center gap-1.5 mb-2">
                            <svg class="w-4 h-4 text-warn-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                            Accuracy &amp; Business Rules Review
                        </h4>
                        <ul class="text-xs text-warn-700 space-y-1 list-disc list-inside">
                            @foreach (var w in validationWarnings)
                            {
                                <li>@w</li>
                            }
                        </ul>
                    </div>
                }

                @if (isDuplicate)
                {
                    <div class="p-4 rounded-xl bg-danger-50 border border-danger-200">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-danger-800 flex items-center gap-1.5 mb-1">
                            <svg class="w-4 h-4 text-danger-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Duplicate Invoice Detected
                        </h4>
                        <p class="text-xs text-danger-700">An invoice with number <strong>@purchaseForm.InvoiceNumber</strong> from <strong>@purchaseForm.Supplier</strong> already exists in the system. Review carefully before posting.</p>
                    </div>
                }

                <!-- Header Card -->
                <div class="bg-surface rounded-2xl border border-line p-6 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo mb-4">Invoice Header</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Vendor / Supplier <span class="text-danger-500">*</span></label>
                            <input type="text" @bind="purchaseForm.Supplier" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-medium focus:border-accent-500 outline-none" placeholder="e.g. South Bangla Computers" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Invoice / Challan Number <span class="text-danger-500">*</span></label>
                            <input type="text" @bind="purchaseForm.InvoiceNumber" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-mono focus:border-accent-500 outline-none" placeholder="e.g. SO-GBPAB-2026-0357 or INV-001" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Purchase Order (PO #)</label>
                            <input type="text" @bind="poNumber" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-mono focus:border-accent-500 outline-none" placeholder="e.g. PNL/GBPL/03/08/26-094" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Invoice Date</label>
                            <input type="date" @bind="purchaseForm.PurchaseDate" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-accent-500 outline-none" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Currency</label>
                            <input type="text" @bind="currency" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-semibold focus:border-accent-500 outline-none" placeholder="BDT" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Payment Terms</label>
                            <input type="text" @bind="paymentTerms" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-accent-500 outline-none" placeholder="e.g. Net 30" />
                        </div>
                    </div>
                </div>

                <!-- Line Items Table -->
                <div class="bg-surface rounded-2xl border border-line shadow-sm overflow-hidden">
                    <div class="p-4 bg-elevated border-b border-line flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo">Purchased Line Items (@purchaseForm.Items.Count)</h3>
                            @if (purchaseForm.Items.Any(i => (i.Quantity ?? 1) > 1))
                            {
                                <button type="button" @onclick="SplitAllMultiQtyRows" title="Split lines with quantity > 1 into individual unit lines (Qty: 1 each)" class="text-xs font-bold text-emerald-600 hover:text-emerald-700 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-2 py-0.5 rounded-lg flex items-center gap-1 transition-colors">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
                                    Auto-Split Multi-Qty Rows
                                </button>
                            }
                        </div>
                        <button type="button" @onclick="AddItemRow" class="text-xs font-bold text-accent-600 hover:text-accent-700 flex items-center gap-1">
                            + Add Line Item
                        </button>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm whitespace-nowrap">
                            <thead class="bg-surface border-b border-line text-[11px] font-semibold uppercase tracking-wider text-txt-mid">
                                <tr>
                                    <th class="px-4 py-2.5">Category</th>
                                    <th class="px-4 py-2.5">Product Description / Model</th>
                                    <th class="px-4 py-2.5">Brand</th>
                                    <th class="px-4 py-2.5 w-20 text-center">Qty</th>
                                    <th class="px-4 py-2.5 w-28 text-right">Unit Price</th>
                                    <th class="px-4 py-2.5 w-28 text-right">Subtotal</th>
                                    <th class="px-4 py-2.5">Candidate Serials</th>
                                    <th class="px-4 py-2.5 w-10"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-line-soft">
                                @foreach (var item in purchaseForm.Items)
                                {
                                    <tr>
                                        <td class="px-4 py-2">
                                            <select @bind="item.Category" class="w-28 bg-elevated border border-line rounded px-2 py-1 text-xs text-txt-hi">
                                                <option value="Laptop">Laptop</option>
                                                <option value="Desktop">Desktop</option>
                                                <option value="Monitor">Monitor</option>
                                                <option value="Network Switch">Network Switch</option>
                                                <option value="Access Point">Access Point</option>
                                                <option value="Component">Component</option>
                                                <option value="General">General</option>
                                            </select>
                                        </td>
                                        <td class="px-4 py-2">
                                            <input type="text" @bind="item.ModelName" class="w-64 bg-elevated border border-line rounded px-2 py-1 text-xs text-txt-hi" placeholder="e.g. Cisco Catalyst C1300-24T-4G" />
                                        </td>
                                        <td class="px-4 py-2">
                                            <input type="text" @bind="item.Manufacturer" class="w-24 bg-elevated border border-line rounded px-2 py-1 text-xs text-txt-hi" placeholder="e.g. Cisco" />
                                        </td>
                                        <td class="px-4 py-2 text-center">
                                            <input type="number" min="1" @bind="item.Quantity" class="w-16 bg-elevated border border-line rounded px-2 py-1 text-xs text-center text-txt-hi" />
                                            @if ((item.Quantity ?? 1) > 1)
                                            {
                                                <button type="button" @onclick="() => SplitRow(item)" title="Split into individual unit lines (Qty: 1 each)" class="text-[10px] font-semibold text-emerald-600 hover:text-emerald-700 hover:underline block mx-auto mt-0.5">
                                                    Split (1 ea)
                                                </button>
                                            }
                                        </td>
                                        <td class="px-4 py-2 text-right">
                                            <input type="number" step="0.01" @bind="item.UnitCost" class="w-24 bg-elevated border border-line rounded px-2 py-1 text-xs text-right text-txt-hi" />
                                        </td>
                                        <td class="px-4 py-2 text-right font-mono font-medium text-txt-hi">
                                            @(((item.Quantity ?? 1) * (item.UnitCost ?? 0m)).ToString("C", new System.Globalization.CultureInfo("bn-BD")))
                                        </td>
                                        <td class="px-4 py-2">
                                            <input type="text" @bind="item.CandidateSerial" class="w-56 bg-elevated border border-line rounded px-2 py-1 text-xs text-txt-hi font-mono" placeholder="e.g. DT33003080Y" />
                                        </td>
                                        <td class="px-4 py-2 text-right">
                                            <button type="button" @onclick="() => purchaseForm.Items.Remove(item)" class="text-txt-muted hover:text-danger-500 text-sm">&times;</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Financial Totals Reconciliation -->
                <div class="bg-surface rounded-2xl border border-line p-6 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo mb-3">Financial Reconciliation</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                        <div class="p-3 bg-elevated rounded-xl border border-line">
                            <div class="text-[11px] font-semibold text-txt-mid">Items Subtotal</div>
                            <div class="text-sm font-bold text-txt-hi mt-1">@CalculatedSum.ToString("C", new System.Globalization.CultureInfo("bn-BD"))</div>
                        </div>
                        <div class="p-3 bg-elevated rounded-xl border border-line">
                            <div class="text-[11px] font-semibold text-txt-mid">Taxes &amp; VAT</div>
                            <div class="text-sm font-bold text-txt-hi mt-1">@taxAmount.ToString("C", new System.Globalization.CultureInfo("bn-BD"))</div>
                        </div>
                        <div class="p-3 bg-elevated rounded-xl border border-line">
                            <div class="text-[11px] font-semibold text-txt-mid">Discount</div>
                            <div class="text-sm font-bold text-txt-hi mt-1">@discountAmount.ToString("C", new System.Globalization.CultureInfo("bn-BD"))</div>
                        </div>
                        <div class="p-3 bg-accent-500/10 rounded-xl border border-accent-300">
                            <div class="text-[11px] font-semibold text-accent-700">Net Total</div>
                            <div class="text-base font-black text-accent-900 mt-1">@invoiceTotal.ToString("C", new System.Globalization.CultureInfo("bn-BD"))</div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Actions -->
                <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-line-soft">
                    <button type="button" @onclick="() => currentStep = 1" class="text-xs font-semibold text-txt-mid hover:text-txt-hi">
                        &larr; Back to Upload
                    </button>
                    <div class="flex flex-wrap items-center gap-3">
                        <button type="button" @onclick="ResetForm" class="px-4 py-2.5 text-xs font-semibold rounded-xl bg-surface border border-line-strong text-txt-hi hover:bg-elevated transition-colors whitespace-nowrap">
                            Cancel &amp; Reset
                        </button>
                        <button type="button" @onclick="SaveDirectToStoreOnly" disabled="@isPosting" class="px-4 py-2.5 text-xs font-semibold rounded-xl bg-surface border border-line hover:bg-elevated text-txt-hi transition-colors whitespace-nowrap">
                            Save to Store Only (Skip Tagging)
                        </button>
                        <button type="button" @onclick="PostPurchase" disabled="@isPosting" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-xs font-bold rounded-xl bg-accent-500 hover:bg-accent-600 text-white shadow-sm transition-colors whitespace-nowrap shrink-0 cursor-pointer">
                            @if (isPosting)
                            {
                                <svg class="animate-spin h-3.5 w-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                <span>Saving Purchase...</span>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Save &amp; Continue to Tag Assets &rarr;</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 2 && captureMode == 2 && directDevice != null)
    {
        <!-- MODE 2: Direct Physical Device Details Review (No Invoice) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

            <!-- LEFT COLUMN: Physical Photo / Sticker Preview -->
            <div class="lg:col-span-5 flex flex-col gap-4">
                <div class="bg-surface rounded-2xl border border-line shadow-sm overflow-hidden sticky top-6">
                    <div class="p-3 bg-elevated border-b border-line flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-txt-hi">Physical Label Photo</span>
                            <span class="text-[11px] text-txt-lo">(@(selectedPreviewIndex + 1) of @uploadedFiles.Count)</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button type="button" @onclick="PrevPreview" disabled="@(selectedPreviewIndex == 0)" title="@(selectedPreviewIndex == 0 ? "First photo" : "Previous photo")" class="px-2.5 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold text-txt-hi transition-colors">
                                &larr; Prev
                            </button>
                            <button type="button" @onclick="NextPreview" disabled="@(selectedPreviewIndex >= uploadedFiles.Count - 1)" title="@(selectedPreviewIndex >= uploadedFiles.Count - 1 ? "Last photo" : "Next photo")" class="px-2.5 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed text-xs font-semibold text-txt-hi transition-colors">
                                Next &rarr;
                            </button>
                            <div class="h-4 w-px bg-line mx-1"></div>
                            <button type="button" @onclick="ZoomOut" disabled="@(zoomScale <= 0.75)" title="Zoom Out" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 text-xs font-bold text-txt-hi">
                                &minus;
                            </button>
                            <span class="text-[11px] font-mono font-bold text-txt-mid min-w-[38px] text-center">@((int)(zoomScale * 100))%</span>
                            <button type="button" @onclick="ZoomIn" disabled="@(zoomScale >= 2.5)" title="Zoom In" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated disabled:opacity-40 text-xs font-bold text-txt-hi">
                                +
                            </button>
                            <button type="button" @onclick="ResetZoom" title="Reset to 100%" class="px-2 py-1 rounded-lg bg-surface border border-line hover:bg-elevated text-xs font-semibold text-txt-mid">
                                Reset
                            </button>
                        </div>
                    </div>

                    <div class="p-4 bg-slate-900/5 min-h-[480px] max-h-[750px] overflow-auto flex items-center justify-center">
                        @if (uploadedFiles.Any())
                        {
                            var currentPreview = uploadedFiles[selectedPreviewIndex];
                            if (currentPreview.ContentType.Contains("pdf"))
                            {
                                <embed src="@currentPreview.DataUrl" type="application/pdf" class="w-full h-[650px] rounded-lg border border-line-soft shadow-xs" />
                            }
                            else
                            {
                                <img src="@currentPreview.DataUrl" alt="Device Label Preview" style="transform: scale(@(zoomScale.ToString(System.Globalization.CultureInfo.InvariantCulture))); transform-origin: top center;" class="max-w-full rounded-lg shadow-sm transition-transform duration-150 cursor-zoom-in" @onclick="ToggleImageZoom" />
                            }
                        }
                    </div>

                    <div class="p-3 bg-surface border-t border-line flex items-center justify-between text-xs text-txt-mid">
                        <span class="truncate max-w-[200px]">@uploadedFiles[selectedPreviewIndex].Name</span>
                        <label class="cursor-pointer font-semibold text-emerald-600 hover:text-emerald-700">
                            + Add Additional Photo
                            <InputFile OnChange="HandleAdditionalFilesSelected" accept=".jpg,.jpeg,.png,.pdf" class="hidden" />
                        </label>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: Direct Device Hardware Review & Register -->
            <div class="lg:col-span-7 flex flex-col gap-6">

                <!-- Direct Mode Banner -->
                <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 flex items-start gap-3">
                    <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    <div>
                        <div class="text-xs font-bold uppercase tracking-wider text-emerald-800">Direct Device Registration (No Upfront Invoice)</div>
                        <p class="text-xs text-emerald-700 mt-0.5">This device will be immediately registered with a generated Asset Tag and QR code. An invoice or purchase record can be linked at any point in the future.</p>
                    </div>
                </div>

                <!-- Hardware Identity Card -->
                <div class="bg-surface rounded-2xl border border-line p-6 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo mb-4">Device Identity &amp; Serial</h3>

                    @if (candidateSerials.Any())
                    {
                        <div class="mb-4 p-3 bg-elevated rounded-xl border border-line">
                            <span class="text-[11px] font-bold text-txt-mid block mb-1.5">Candidate Serials Detected by AI/OCR:</span>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var sn in candidateSerials)
                                {
                                    <button type="button" @onclick="() => directDevice.Serial = sn" class="px-2.5 py-1 rounded-lg text-xs font-mono font-bold transition-all @(directDevice.Serial == sn ? "bg-emerald-600 text-white shadow-xs" : "bg-surface border border-line text-txt-hi hover:border-emerald-500")">
                                        @sn
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Serial Number <span class="text-danger-500">*</span></label>
                            <input type="text" @bind="directDevice.Serial" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-mono font-bold focus:border-emerald-500 outline-none" placeholder="e.g. DT33003080Y or 5CD2341..." />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Device Name / Model <span class="text-danger-500">*</span></label>
                            <input type="text" @bind="directDevice.DeviceName" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-semibold focus:border-emerald-500 outline-none" placeholder="e.g. Cisco Catalyst C1300-24T-4G" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Brand / Manufacturer</label>
                            <input type="text" @bind="directDevice.Brand" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="e.g. Cisco, ASUS, Dell" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Category</label>
                            <select @bind="directDevice.Category" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none">
                                <option value="Network Switch">Network Switch</option>
                                <option value="Access Point">Access Point</option>
                                <option value="Laptop">Laptop</option>
                                <option value="Desktop">Desktop</option>
                                <option value="Monitor">Monitor</option>
                                <option value="Component">Component</option>
                                <option value="Server">Server</option>
                                <option value="IT Equipment">IT Equipment</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">MAC Address / IMEI</label>
                            <input type="text" @bind="directDevice.MacAddress" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi font-mono focus:border-emerald-500 outline-none" placeholder="e.g. 00:1A:2B:3C:4D:5E" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Owner Company</label>
                            <input type="text" @bind="directDevice.OwnerCompany" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="PrimeTech Solutions Ltd." />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Office / Location</label>
                            <select @bind="directDevice.Location" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none">
                                <option value="">Select Office Location</option>
                                <option value="TK Bhaban">TK Bhaban</option>
                                <option value="BSEC Bhaban">BSEC Bhaban</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Hardware Specifications Card -->
                <div class="bg-surface rounded-2xl border border-line p-6 shadow-sm">
                    <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo mb-4">Hardware Specifications (If Applicable)</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Processor (CPU)</label>
                            <input type="text" @bind="directDevice.Processor" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="e.g. Core i5-1235U" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">RAM / Memory</label>
                            <input type="text" @bind="directDevice.Ram" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="e.g. 16 GB" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">SSD Storage</label>
                            <input type="text" @bind="directDevice.Ssd" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="e.g. 512 GB NVMe" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">HDD Storage</label>
                            <input type="text" @bind="directDevice.Hdd" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" placeholder="e.g. 1 TB" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Condition</label>
                            <select @bind="directDevice.Condition" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none">
                                <option value="New">New</option>
                                <option value="Good">Good</option>
                                <option value="Fair">Fair</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-txt-mid mb-1">Warranty (Months)</label>
                            <input type="number" @bind="directDevice.WarrantyMonths" class="w-full bg-elevated border border-line rounded-lg px-3 py-2 text-sm text-txt-hi focus:border-emerald-500 outline-none" />
                        </div>
                    </div>
                </div>

                <!-- Bottom Actions -->
                <div class="flex flex-wrap items-center justify-end gap-3 pt-4 border-t border-line-soft">
                    <button type="button" @onclick="ResetForm" class="px-5 py-2.5 text-xs font-semibold rounded-xl bg-surface border border-line-strong text-txt-hi hover:bg-elevated transition-colors whitespace-nowrap">
                        Cancel &amp; Reset
                    </button>
                    <button type="button" @onclick="RegisterDirectDevice" disabled="@isRegisteringDevice" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 text-xs font-semibold rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors whitespace-nowrap shrink-0">
                        @if (isRegisteringDevice)
                        {
                            <svg class="animate-spin h-3.5 w-3.5 text-white shrink-0" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            <span>Saving Device to Inventory...</span>
                        }
                        else
                        {
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                            <span>Confirm &amp; Register Physical Asset</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 3 && (savedPurchase != null || purchaseForm != null))
    {
        var activeP = savedPurchase ?? purchaseForm!;
        <!-- STEP 3: FAST BULK UNIT TAGGING GRID -->
        <div class="max-w-5xl mx-auto space-y-6 animate-in fade-in duration-300">
            <!-- Success Banner -->
            <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-500/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-3.5">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center shrink-0 shadow-sm">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold uppercase tracking-wider text-emerald-800">Purchase Order Saved</span>
                            <span class="font-mono font-bold text-xs px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-900 border border-emerald-300">@activeP.PurchaseNumber</span>
                        </div>
                        <p class="text-xs text-txt-mid mt-0.5">
                            Supplier: <strong>@activeP.Supplier</strong> &bull; Invoice: <strong>@(activeP.InvoiceNumber ?? "—")</strong> &bull; Total Units: <strong>@unitTagEntries.Count</strong>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2 self-stretch sm:self-auto justify-end">
                    <button type="button" @onclick="() => showBulkSerialModal = true" class="px-3.5 py-1.5 rounded-xl border border-line bg-surface hover:bg-elevated text-xs font-semibold text-txt-hi transition-colors shadow-xs flex items-center gap-1.5 cursor-pointer">
                        <svg class="w-4 h-4 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        <span>Paste Serials List</span>
                    </button>
                </div>
            </div>

            <!-- Batch Settings Bar -->
            <div class="p-3.5 bg-surface rounded-2xl border border-line flex flex-wrap items-center justify-between gap-3 text-xs shadow-xs">
                <div class="flex items-center gap-2 text-txt-mid">
                    <svg class="w-4 h-4 text-txt-lo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
                    <span class="font-bold text-txt-hi">Apply Defaults to All Untagged:</span>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="text-txt-lo">Location:</span>
                        <select value="@batchDefaultLocation" @onchange="e => ApplyBatchLocation(e.Value?.ToString() ?? officeLocations[0])" class="bg-elevated border border-line rounded-lg px-2.5 py-1 text-xs text-txt-hi font-medium focus:border-accent-500 outline-none">
                            @foreach (var loc in officeLocations)
                            {
                                <option value="@loc">@loc</option>
                            }
                        </select>
                    </div>

                    <div class="flex items-center gap-1.5">
                        <span class="text-txt-lo">Company:</span>
                        <select value="@batchDefaultCompany" @onchange="e => ApplyBatchCompany(e.Value?.ToString() ?? ownerCompanies[0])" class="bg-elevated border border-line rounded-lg px-2.5 py-1 text-xs text-txt-hi font-medium focus:border-accent-500 outline-none">
                            @foreach (var comp in ownerCompanies)
                            {
                                <option value="@comp">@comp</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <!-- Tagging Units Table -->
            <div class="rounded-2xl border border-line bg-surface shadow-sm overflow-hidden">
                <div class="px-5 py-3.5 bg-elevated border-b border-line flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-bold text-txt-hi">Hardware Units Awaiting Physical Serial Numbers</span>
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-accent-soft text-accent-700">
                            @unitTagEntries.Count(u => !string.IsNullOrWhiteSpace(u.SerialNumber)) / @unitTagEntries.Count Ready
                        </span>
                    </div>
                    <span class="text-[11px] text-txt-lo hidden sm:inline">Type or scan barcode directly into each serial field</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs whitespace-nowrap">
                        <thead class="bg-elevated/50 text-[11px] font-semibold uppercase tracking-wider text-txt-mid border-b border-line">
                            <tr>
                                <th class="px-4 py-3">Unit</th>
                                <th class="px-4 py-3">Category</th>
                                <th class="px-4 py-3">Asset Tag</th>
                                <th class="px-4 py-3 min-w-[220px]">Serial Number <span class="text-danger-500">*</span></th>
                                <th class="px-4 py-3">Office Location</th>
                                <th class="px-4 py-3">Owner Company</th>
                                <th class="px-4 py-3 text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-line-soft">
                            @for (int idx = 0; idx < unitTagEntries.Count; idx++)
                            {
                                var entry = unitTagEntries[idx];
                                <tr class="hover:bg-elevated/40 transition-colors @(entry.IsRegistered ? "bg-emerald-50/20" : "")">
                                    <td class="px-4 py-3">
                                        <div class="font-bold text-txt-hi">@entry.Brand @entry.ModelName</div>
                                        <div class="text-[10px] text-txt-lo font-mono">Unit @entry.UnitIndex of @entry.TotalUnitsForItem</div>
                                    </td>
                                    <td class="px-4 py-3">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-elevated border border-line text-txt-hi">
                                            @entry.Category
                                        </span>
                                    </td>
                                    <td class="px-4 py-3">
                                        <input type="text" @bind="entry.AssetTag" disabled="@entry.IsRegistered" class="w-32 bg-elevated border border-line rounded-lg px-2.5 py-1 text-xs font-mono font-bold text-accent-700 disabled:opacity-60 focus:border-accent-500 outline-none" />
                                    </td>
                                    <td class="px-4 py-3">
                                        <input type="text" @bind="entry.SerialNumber" @bind:event="oninput" disabled="@entry.IsRegistered" placeholder="Scan or enter serial..." class="w-full bg-elevated border border-line rounded-lg px-3 py-1.5 text-xs font-mono font-bold text-txt-hi placeholder:text-txt-lo placeholder:font-normal focus:border-emerald-500 outline-none disabled:opacity-60" />
                                    </td>
                                    <td class="px-4 py-3">
                                        <select @bind="entry.Location" disabled="@entry.IsRegistered" class="bg-elevated border border-line rounded-lg px-2.5 py-1 text-xs text-txt-hi focus:border-accent-500 outline-none disabled:opacity-60">
                                            @foreach (var loc in officeLocations)
                                            {
                                                <option value="@loc">@loc</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="px-4 py-3">
                                        <select @bind="entry.OwnerCompany" disabled="@entry.IsRegistered" class="bg-elevated border border-line rounded-lg px-2.5 py-1 text-xs text-txt-hi focus:border-accent-500 outline-none disabled:opacity-60 max-w-[160px] truncate">
                                            @foreach (var comp in ownerCompanies)
                                            {
                                                <option value="@comp">@comp</option>
                                            }
                                        </select>
                                    </td>
                                    <td class="px-4 py-3 text-center">
                                        @if (entry.IsRegistered)
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                Registered
                                            </span>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(entry.SerialNumber))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-accent-soft text-accent-700">
                                                Ready to Register
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-500">
                                                Needs Serial
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer Actions -->
                <div class="p-4 bg-elevated/30 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-3">
                    <button type="button" @onclick="() => currentStep = 2" class="text-xs font-semibold text-txt-mid hover:text-txt-hi">
                        &larr; Back to Invoice Review
                    </button>

                    <div class="flex items-center gap-2.5">
                        <button type="button" @onclick="SkipAndFinishStep3" class="px-4 py-2 text-xs font-semibold rounded-xl bg-surface border border-line hover:bg-elevated text-txt-hi transition-colors whitespace-nowrap">
                            Skip Remaining &amp; Keep in Store
                        </button>

                        <button type="button" @onclick="RegisterTaggedUnits" disabled="@isRegisteringUnits" class="inline-flex items-center gap-2 px-6 py-2 text-xs font-bold rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors whitespace-nowrap cursor-pointer">
                            @if (isRegisteringUnits)
                            {
                                <svg class="animate-spin h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                                <span>Registering Assets...</span>
                            }
                            else
                            {
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                <span>Confirm &amp; Register Units (@unitTagEntries.Count(u => !u.IsRegistered && !string.IsNullOrWhiteSpace(u.SerialNumber))) &rarr;</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (currentStep == 4)
    {
        var activeP = savedPurchase ?? purchaseForm;
        <!-- STEP 4: CELEBRATION SUMMARY & QR LABEL SHEET -->
        <div class="max-w-4xl mx-auto space-y-8 animate-in fade-in duration-300">
            <!-- Hero Header -->
            <div class="rounded-3xl border border-line bg-surface p-8 shadow-sm text-center relative overflow-hidden">
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 border border-emerald-200 mb-4 shadow-xs">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                </div>
                <h2 class="text-2xl font-black text-txt-hi tracking-tight">Invoice Intake &amp; Asset Onboarding Complete!</h2>
                <p class="text-sm text-txt-mid mt-1.5 max-w-lg mx-auto">
                    Purchase reference <strong class="text-txt-hi font-mono">@(activeP?.PurchaseNumber ?? "—")</strong> is safely committed to the database.
                </p>

                <!-- Metrics Pills -->
                <div class="mt-6 flex flex-wrap justify-center gap-3">
                    <div class="px-4 py-2 rounded-xl bg-elevated border border-line text-left">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-txt-lo">Supplier / Vendor</div>
                        <div class="text-xs font-bold text-txt-hi font-mono">@(activeP?.Supplier ?? "—")</div>
                    </div>
                    <div class="px-4 py-2 rounded-xl bg-emerald-50 border border-emerald-200 text-left">
                        <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-800">Assets Activated</div>
                        <div class="text-xs font-bold text-emerald-700 font-mono">@registeredUnitsList.Count unit(s)</div>
                    </div>
                    @if (activeP != null)
                    {
                        var inStoreRemaining = activeP.Items.Sum(i => i.RemainingQuantity);
                        if (inStoreRemaining > 0)
                        {
                            <div class="px-4 py-2 rounded-xl bg-amber-50 border border-amber-200 text-left">
                                <div class="text-[10px] font-bold uppercase tracking-wider text-amber-800">In Store (Unassigned)</div>
                                <div class="text-xs font-bold text-amber-700 font-mono">@inStoreRemaining unit(s)</div>
                            </div>
                        }
                    }
                </div>

                <!-- Top Level Action Buttons -->
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3 no-print">
                    @if (registeredUnitsList.Any())
                    {
                        <button type="button" @onclick="PrintQrLabels" class="inline-flex items-center gap-2 rounded-xl bg-accent-500 hover:bg-accent-600 px-5 py-2.5 text-xs font-bold text-white shadow-sm transition-colors cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                            <span>Print All QR Labels</span>
                        </button>
                    }
                    <a href="/devices" class="inline-flex items-center gap-2 rounded-xl bg-surface border border-line hover:bg-elevated px-5 py-2.5 text-xs font-bold text-txt-hi transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
                        <span>View in All Assets</span>
                    </a>
                    <button type="button" @onclick='() => SetActiveMainTab("registry")' class="inline-flex items-center gap-2 rounded-xl bg-surface border border-line hover:bg-elevated px-5 py-2.5 text-xs font-bold text-txt-hi transition-colors">
                        <span>View Invoices Registry</span>
                    </button>
                    <button type="button" @onclick="ResetForm" class="inline-flex items-center gap-2 rounded-xl bg-surface border border-line-strong hover:bg-elevated px-5 py-2.5 text-xs font-bold text-txt-hi transition-colors">
                        <span>+ New Invoice Upload</span>
                    </button>
                </div>
            </div>

            <!-- PRINTABLE QR LABEL SHEET -->
            @if (registeredUnitsList.Any())
            {
                <div id="printable-qr-sheet" class="space-y-4">
                    <div class="flex items-center justify-between pb-2 border-b border-line no-print">
                        <h3 class="text-xs font-bold uppercase tracking-wider text-txt-lo">Ready-to-Print Hardware Labels (@registeredUnitsList.Count)</h3>
                        <span class="text-[11px] text-txt-mid">Optimized for sticker printers or standard sheets</span>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var dev in registeredUnitsList)
                        {
                            <div class="p-4 rounded-2xl border-2 border-line bg-surface shadow-xs flex flex-col justify-between break-inside-avoid print:border-black print:p-2">
                                <div class="flex items-start justify-between gap-3 border-b border-line pb-2 mb-2">
                                    <div>
                                        <span class="text-[9px] font-black uppercase tracking-wider text-accent-700 block">PrimeTech Solutions Ltd.</span>
                                        <span class="text-sm font-black font-mono text-txt-hi block">@dev.AssetTag</span>
                                    </div>
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-elevated border border-line text-txt-hi">
                                        @dev.Category
                                    </span>
                                </div>

                                <div class="flex items-center justify-between gap-3 my-2">
                                    <div class="space-y-1">
                                        <p class="text-xs font-bold text-txt-hi">@dev.Brand @dev.DeviceName</p>
                                        <p class="text-[11px] text-txt-mid font-mono">SN: <strong>@dev.Serial</strong></p>
                                        <p class="text-[10px] text-txt-lo">Loc: @(dev.Location ?? "Store")</p>
                                    </div>

                                    <div class="bg-white p-1 rounded-lg border border-line shrink-0">
                                        <img src="https://api.qrserver.com/v1/create-qr-code/?size=120x120&margin=2&data=@(Uri.EscapeDataString(dev.AssetTag ?? dev.Serial ?? ""))" alt="Asset QR" class="w-16 h-16 object-contain" />
                                    </div>
                                </div>

                                <div class="text-[9px] text-txt-lo pt-1 border-t border-line-soft font-mono flex justify-between">
                                    <span>PO: @(activeP?.PurchaseNumber ?? "—")</span>
                                    <span>@DateTime.Now.ToString("dd-MMM-yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    }
    else if (activeMainTab == "registry")
    {
        <!-- KPI Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div @onclick='() => SetRegistryFilter("all")' class="cursor-pointer group relative overflow-hidden rounded-xl text-left shadow-sm transition-transform duration-150 hover:scale-[1.02] active:scale-95" style="background: #f5f3ff; border: 1px solid #ddd6fe;">
                <div class="relative z-10 flex items-start justify-between p-3">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest" style="color: #5b21b6;">Total Invoices / Purchases</p>
                        <p class="tnum mt-1 text-2xl font-bold tracking-tight" style="color: #7c3aed;">@allPurchases.Count</p>
                        <p class="mt-0.5 text-[11px] font-medium" style="color: #6d28d9;">All recorded purchases</p>
                    </div>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" style="background: #ede9fe; color: #7c3aed;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </span>
                </div>
            </div>

            <div @onclick='() => SetRegistryFilter("pending")' class="cursor-pointer group relative overflow-hidden rounded-xl text-left shadow-sm transition-transform duration-150 hover:scale-[1.02] active:scale-95" style="background: #fffbeb; border: 1px solid #fde68a;">
                <div class="relative z-10 flex items-start justify-between p-3">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest" style="color: #92400e;">Pending Device Registration</p>
                        <p class="tnum mt-1 text-2xl font-bold tracking-tight" style="color: #b45309;">@allPurchases.Count(p => p.Items.Any(i => i.RemainingQuantity > 0))</p>
                        <p class="mt-0.5 text-[11px] font-medium" style="color: #92400e;">Awaiting physical tags</p>
                    </div>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" style="background: #fef3c7; color: #d97706;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    </span>
                </div>
            </div>

            <div @onclick='() => SetRegistryFilter("completed")' class="cursor-pointer group relative overflow-hidden rounded-xl text-left shadow-sm transition-transform duration-150 hover:scale-[1.02] active:scale-95" style="background: #ecfdf5; border: 1px solid #a7f3d0;">
                <div class="relative z-10 flex items-start justify-between p-3">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest" style="color: #065f46;">Completed Invoices</p>
                        <p class="tnum mt-1 text-2xl font-bold tracking-tight" style="color: #047857;">@allPurchases.Count(p => p.Items.Any() && p.Items.All(i => i.RemainingQuantity <= 0))</p>
                        <p class="mt-0.5 text-[11px] font-medium" style="color: #047857;">All units tagged &amp; active</p>
                    </div>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" style="background: #d1fae5; color: #059669;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    </span>
                </div>
            </div>

            <div class="group relative overflow-hidden rounded-xl text-left shadow-sm" style="background: #eff6ff; border: 1px solid #bfdbfe;">
                <div class="relative z-10 flex items-start justify-between p-3">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest" style="color: #1e40af;">Total Hardware Units</p>
                        <p class="tnum mt-1 text-2xl font-bold tracking-tight" style="color: #1d4ed8;">@allPurchases.Sum(p => p.Items.Sum(i => i.Quantity ?? 0))</p>
                        <p class="mt-0.5 text-[11px] font-medium" style="color: #1d4ed8;">Total purchased units</p>
                    </div>
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg" style="background: #dbeafe; color: #2563eb;">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
                    </span>
                </div>
            </div>
        </div>

        <!-- Toolbar & Filter Bar -->
        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <!-- Left: Filter Tabs -->
            <div class="inline-flex p-1 bg-elevated border border-line rounded-xl text-xs">
                <button type="button" @onclick='() => SetRegistryFilter("all")' class="px-3 py-1 rounded-lg font-semibold transition-all @(registryStatusFilter == "all" ? "bg-surface text-txt-hi shadow-xs" : "text-txt-mid hover:text-txt-hi")">
                    All (@allPurchases.Count)
                </button>
                <button type="button" @onclick='() => SetRegistryFilter("pending")' class="px-3 py-1 rounded-lg font-semibold transition-all @(registryStatusFilter == "pending" ? "bg-amber-50 text-amber-800 shadow-xs border border-amber-200" : "text-txt-mid hover:text-txt-hi")">
                    Pending Registration (@allPurchases.Count(p => p.Items.Any(i => i.RemainingQuantity > 0)))
                </button>
                <button type="button" @onclick='() => SetRegistryFilter("completed")' class="px-3 py-1 rounded-lg font-semibold transition-all @(registryStatusFilter == "completed" ? "bg-emerald-50 text-emerald-800 shadow-xs border border-emerald-200" : "text-txt-mid hover:text-txt-hi")">
                    Completed (@allPurchases.Count(p => p.Items.Any() && p.Items.All(i => i.RemainingQuantity <= 0)))
                </button>
            </div>

            <!-- Right: Search, Date Filter & Action -->
            <div class="flex flex-wrap items-center gap-3">
                <AssetManagement.Web.Components.Shared.DateRangePicker 
                    @bind-StartDate="registryStartDate" 
                    @bind-EndDate="registryEndDate" 
                    OnRangeChanged="ResetRegistryPage" 
                    Placeholder="Filter by purchase date" />

                <div class="relative w-56 sm:w-64">
                    <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-txt-lo" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke-width="2"/><path d="m21 21-4.3-4.3" stroke-width="2"/></svg>
                    <input type="search" placeholder="Search supplier, invoice, purchase #..." @bind="registrySearchTerm" @bind:event="oninput" @bind:after="ResetRegistryPage" class="w-full rounded-xl border border-line bg-surface py-1.5 pl-9 pr-3 text-xs text-txt-hi placeholder:text-txt-lo hover:border-line-strong focus:outline-none focus:ring-2 focus:ring-accent-500/20" />
                </div>

                <button type="button" @onclick="OpenAddModal" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-accent-500 hover:bg-accent-600 text-white text-xs font-semibold shadow-xs transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    + Manual Purchase
                </button>
            </div>
        </div>

        <!-- Invoices & Purchases Table -->
        <div class="rounded-2xl border border-line bg-surface shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-line-soft bg-elevated/70 text-txt-lo uppercase tracking-wider font-semibold">
                            <th class="py-3 px-4 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortRegistryBy("Purchase")'>
                                <div class="flex items-center gap-1.5">Purchase # &amp; Date @RenderRegistrySortIcon("Purchase")</div>
                            </th>
                            <th class="py-3 px-4 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortRegistryBy("Supplier")'>
                                <div class="flex items-center gap-1.5">Supplier / Vendor @RenderRegistrySortIcon("Supplier")</div>
                            </th>
                            <th class="py-3 px-4 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortRegistryBy("Invoice")'>
                                <div class="flex items-center gap-1.5">Invoice # @RenderRegistrySortIcon("Invoice")</div>
                            </th>
                            <th class="py-3 px-4 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortRegistryBy("Items")'>
                                <div class="flex items-center gap-1.5">Line Items @RenderRegistrySortIcon("Items")</div>
                            </th>
                            <th class="py-3 px-4 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortRegistryBy("Status")'>
                                <div class="flex items-center gap-1.5">Registration Status @RenderRegistrySortIcon("Status")</div>
                            </th>
                            <th class="py-3 px-4 text-center">Attached Invoice</th>
                            <th class="py-3 px-4 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-line-soft">
                        @if (!PaginatedRegistryPurchases.Any())
                        {
                            <tr>
                                <td colspan="7" class="py-12 text-center text-txt-mid">
                                    <svg class="w-10 h-10 mx-auto text-txt-lo mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    <p class="font-semibold text-txt-hi">No purchases or invoices found</p>
                                    <p class="text-[11px] text-txt-lo mt-0.5">Try adjusting your filters, date range, or upload a new invoice.</p>
                                </td>
                            </tr>
                        }
                        @foreach (var p in PaginatedRegistryPurchases)
                        {
                            var totalUnits = p.Items.Sum(i => i.Quantity ?? 0);
                            var remainingUnits = p.Items.Sum(i => i.RemainingQuantity);
                            var isCompleted = p.Items.Any() && remainingUnits <= 0;

                            <tr class="hover:bg-elevated/40 transition-colors">
                                <td class="py-3.5 px-4">
                                    <span class="font-bold text-txt-hi font-mono text-[13px] block">@p.PurchaseNumber</span>
                                    <span class="text-txt-lo text-[11px]">@(p.PurchaseDate?.ToString("dd-MMM-yyyy") ?? "—")</span>
                                </td>
                                <td class="py-3.5 px-4 font-semibold text-txt-hi">
                                    @p.Supplier
                                </td>
                                <td class="py-3.5 px-4 font-mono text-txt-mid font-medium">
                                    @(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? "—" : p.InvoiceNumber)
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="max-w-xs">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-elevated border border-line text-txt-hi mb-1">
                                            @p.Items.Count item@(p.Items.Count != 1 ? "s" : "") &bull; @totalUnits unit@(totalUnits != 1 ? "s" : "")
                                        </span>
                                        <div class="text-[11px] text-txt-mid truncate" title="@string.Join(", ", p.Items.Select(i => $"{i.Manufacturer} {i.ModelName} (x{i.Quantity})"))">
                                            @string.Join(", ", p.Items.Select(i => $"{i.Manufacturer} {i.ModelName} (x{i.Quantity})"))
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    @if (isCompleted)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                            All Registered
                                        </span>
                                    }
                                    else if (remainingUnits > 0)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-amber-100 text-amber-800">
                                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                                            @remainingUnits remaining of @totalUnits
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-100 text-slate-700">
                                            No items
                                        </span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    @if (!string.IsNullOrEmpty(p.InvoiceFilePath))
                                    {
                                        <button type="button" @onclick="() => OpenInvoiceViewer(p.InvoiceFilePath)" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-line bg-elevated hover:bg-surface text-txt-mid hover:text-accent-600 transition-colors shadow-xs" title="View attached document">
                                            <svg class="w-3.5 h-3.5 text-accent-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            <span class="font-medium">View File</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-txt-lo">—</span>
                                    }
                                </td>
                                <td class="py-3.5 px-4 text-right">
                                    <div class="inline-flex items-center gap-1.5">
                                        @if (remainingUnits > 0)
                                        {
                                            <button type="button" @onclick="() => StartTaggingFromPurchase(p)" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-semibold transition-colors shadow-xs" title="Tag remaining physical units in Wizard">
                                                <span>Tag Units (@remainingUnits)</span>
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" @onclick="() => StartTaggingFromPurchase(p)" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-line bg-elevated hover:bg-surface text-txt-mid font-medium transition-colors text-xs" title="View purchase details & assets">
                                                <span>View Units</span>
                                            </button>
                                        }
                                        <button type="button" @onclick="() => OpenEditModal(p)" class="p-1 rounded-lg border border-line bg-surface hover:bg-elevated text-txt-mid hover:text-txt-hi transition-colors" title="Edit purchase details">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                        </button>
                                        <button type="button" @onclick="() => OpenDeleteModal(p)" class="p-1 rounded-lg border border-line bg-surface hover:bg-danger-50 text-txt-mid hover:text-danger-600 transition-colors" title="Delete purchase">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-4 py-3 border-t border-line-soft text-xs text-txt-mid bg-elevated/30">
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span>Rows per page:</span>
                        <select @bind="registryPageSize" @bind:after="ResetRegistryPage" class="bg-surface border border-line rounded px-2 py-1 text-txt-hi font-medium">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <span>
                        Showing @((registryPage - 1) * registryPageSize + 1) to @(Math.Min(registryPage * registryPageSize, FilteredRegistryPurchases.Count)) of @FilteredRegistryPurchases.Count purchases
                    </span>
                </div>

                <div class="flex items-center gap-1">
                    <button type="button" @onclick="() => GoToRegistryPage(1)" disabled="@(registryPage == 1)" class="px-2.5 py-1 rounded border border-line bg-surface hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed font-medium">
                        First
                    </button>
                    <button type="button" @onclick="() => GoToRegistryPage(registryPage - 1)" disabled="@(registryPage == 1)" class="px-2.5 py-1 rounded border border-line bg-surface hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed font-medium">
                        Prev
                    </button>
                    <span class="px-3 py-1 font-bold text-txt-hi">
                        Page @registryPage of @TotalRegistryPages
                    </span>
                    <button type="button" @onclick="() => GoToRegistryPage(registryPage + 1)" disabled="@(registryPage >= TotalRegistryPages)" class="px-2.5 py-1 rounded border border-line bg-surface hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed font-medium">
                        Next
                    </button>
                    <button type="button" @onclick="() => GoToRegistryPage(TotalRegistryPages)" disabled="@(registryPage >= TotalRegistryPages)" class="px-2.5 py-1 rounded border border-line bg-surface hover:bg-elevated disabled:opacity-40 disabled:cursor-not-allowed font-medium">
                        Last
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- INVOICE VIEWER MODAL -->
<AssetManagement.Web.Components.Shared.InvoiceViewerModal @bind-IsOpen="showInvoiceViewer" FilePath="@selectedInvoicePath" />

<!-- EDIT PURCHASE MODAL -->
@if (showEditModal && editingPurchase != null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="bg-surface rounded-2xl border border-line p-6 shadow-2xl max-w-lg w-full space-y-4 animate-in fade-in zoom-in-95">
            <div class="flex items-center justify-between border-b border-line-soft pb-3">
                <h3 class="text-base font-bold text-txt-hi">Edit Purchase @editingPurchase.PurchaseNumber</h3>
                <button type="button" @onclick="() => showEditModal = false" class="text-txt-lo hover:text-txt-hi text-lg leading-none">&times;</button>
            </div>

            @if (!string.IsNullOrEmpty(editErrorMessage))
            {
                <div class="p-3 rounded-lg bg-danger-50 text-danger-700 border border-danger-200 text-xs">@editErrorMessage</div>
            }

            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-semibold text-txt-mid mb-1">Supplier / Vendor</label>
                    <input type="text" @bind="editingPurchase.Supplier" class="w-full rounded-xl border border-line bg-elevated px-3 py-2 text-xs font-semibold text-txt-hi focus:border-accent-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-txt-mid mb-1">Invoice Number</label>
                    <input type="text" @bind="editingPurchase.InvoiceNumber" class="w-full rounded-xl border border-line bg-elevated px-3 py-2 text-xs font-semibold text-txt-hi focus:border-accent-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-txt-mid mb-1">Purchase Date</label>
                    <input type="date" value="@(editingPurchase.PurchaseDate?.ToString("yyyy-MM-dd"))" @onchange="OnEditPurchaseDateChange" class="w-full rounded-xl border border-line bg-elevated px-3 py-2 text-xs font-semibold text-txt-hi focus:border-accent-500 focus:outline-none" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-txt-mid mb-1">Notes / Remarks</label>
                    <textarea rows="2" @bind="editingPurchase.Notes" class="w-full rounded-xl border border-line bg-elevated px-3 py-2 text-xs text-txt-hi focus:border-accent-500 focus:outline-none"></textarea>
                </div>

                <!-- Attached Invoice / Document -->
                <div>
                    <label class="block text-xs font-semibold text-txt-mid mb-1">Attached Invoice / Bill Document</label>
                    @if (!string.IsNullOrEmpty(editingPurchase.InvoiceFilePath))
                    {
                        var isPdf = editingPurchase.InvoiceFilePath.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                        var fileName = System.IO.Path.GetFileName(editingPurchase.InvoiceFilePath);
                        <div class="flex items-center justify-between p-2.5 rounded-xl border border-line bg-elevated">
                            <div class="flex items-center gap-2.5 overflow-hidden">
                                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg @(isPdf ? "bg-danger-50 text-danger-600" : "bg-accent-50 text-accent-600")">
                                    @if (isPdf)
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                    }
                                    else
                                    {
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    }
                                </span>
                                <div class="truncate">
                                    <p class="text-xs font-semibold text-txt-hi truncate">@fileName</p>
                                    <p class="text-[10px] text-txt-lo">Current attached invoice file</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button type="button" @onclick="() => OpenInvoiceViewer(editingPurchase.InvoiceFilePath)" class="px-2 py-1 rounded-lg border border-line bg-surface text-txt-mid hover:text-accent-600 text-[11px] font-semibold transition-colors">
                                    Preview
                                </button>
                                <button type="button" @onclick="RemoveEditAttachedInvoice" class="px-2 py-1 rounded-lg border border-line bg-surface text-danger-600 hover:bg-danger-50 text-[11px] font-semibold transition-colors">
                                    Remove
                                </button>
                            </div>
                        </div>
                    }

                    <div class="mt-2">
                        <label class="flex cursor-pointer items-center justify-center gap-2 rounded-xl border border-dashed border-line hover:border-accent-500 bg-elevated/40 hover:bg-elevated px-4 py-3 transition-colors text-center">
