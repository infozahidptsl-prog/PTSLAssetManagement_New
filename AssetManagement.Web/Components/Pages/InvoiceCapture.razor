    private async Task AnalyzeDocuments()
    {
        if (!uploadedFiles.Any())
        {
            errorMessage = "Please upload or paste at least one document.";
            return;
        }

        isAnalyzing = true;
        errorMessage = null;
        validationWarnings.Clear();
        StateHasChanged();

        try
        {
            string fullOcrText = "";
            string firstBase64 = "";

            foreach (var file in uploadedFiles)
            {
                using var stream = new MemoryStream(file.Bytes);
                var ocrRes = await OcrService.ExtractTextAsync(stream, file.Name, file.ContentType);
                if (ocrRes.IsSuccess && !string.IsNullOrWhiteSpace(ocrRes.Text))
                {
                    fullOcrText += ocrRes.Text + "\n\n";
                }

                if (string.IsNullOrEmpty(firstBase64) && !file.ContentType.Contains("pdf"))
                {
                    firstBase64 = Convert.ToBase64String(file.Bytes);
                }
            }

            if (string.IsNullOrEmpty(firstBase64) && uploadedFiles.Any())
            {
                firstBase64 = Convert.ToBase64String(uploadedFiles.First().Bytes);
            }

            // Provider extraction pipeline
            var aiResult = await AiService.ExtractDocumentAsync(fullOcrText, firstBase64);

            if (captureMode == 1)
            {
                // MODE 1: Purchase / Invoice Mapping
                var mapped = await FieldMappingService.MapPurchaseAsync(aiResult);
                validationWarnings.AddRange(mapped.Warnings);

                await ValidationService.ValidatePurchaseAsync(mapped);
                validationWarnings.AddRange(mapped.Warnings);

                purchaseForm = new Purchase
                {
                    PurchaseNumber = "PUR-" + DateTime.Now.ToString("yyMMdd") + new Random().Next(100, 999),
                    Supplier = mapped.Data?.Vendor ?? aiResult.Vendor ?? "",
                    InvoiceNumber = mapped.Data?.InvoiceNumber ?? aiResult.InvoiceNumber ?? aiResult.ChallanNumber ?? "",
                    PurchaseDate = mapped.Data?.InvoiceDate ?? aiResult.DocumentDate ?? DateTime.Today,
                    Notes = "Created via Dynamic AI Document Extraction"
                };

                poNumber = mapped.Data?.PurchaseOrderNumber ?? aiResult.PurchaseOrderNumber ?? "";
                currency = mapped.Data?.Currency ?? aiResult.Currency ?? "BDT";
                paymentTerms = mapped.Data?.PaymentTerms ?? aiResult.PaymentTerms ?? "";
                invoiceTotal = mapped.Data?.Total ?? aiResult.TotalAmount ?? 0m;
                taxAmount = mapped.Data?.Tax ?? aiResult.Tax ?? 0m;
                discountAmount = mapped.Data?.Discount ?? aiResult.Discount ?? 0m;

                if (mapped.Data?.Items != null && mapped.Data.Items.Any())
                {
                    foreach (var item in mapped.Data.Items)
                    {
                        var modelName = item.Description;
                        if (!string.IsNullOrWhiteSpace(item.Model) && !item.Description.Contains(item.Model, StringComparison.OrdinalIgnoreCase))
                        {
                            modelName = $"{item.Description} ({item.Model})";
                        }

                        var qty = item.Quantity > 0 ? item.Quantity : 1;
                        var serialsList = new List<string>();
                        if (item.SerialNumbers != null && item.SerialNumbers.Any())
                        {
                            serialsList.AddRange(item.SerialNumbers);
                        }
                        else if (!string.IsNullOrWhiteSpace(item.SerialNumber))
                        {
                            var splitSns = item.SerialNumber.Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries);
                            serialsList.AddRange(splitSns);
                        }

                        // Auto-Split Rows in Invoice Table: Each individual physical unit gets its own row of Qty 1
                        if (qty > 1)
                        {
                            for (int q = 0; q < qty; q++)
                            {
                                var assignedSerial = q < serialsList.Count ? serialsList[q] : "";
                                purchaseForm.Items.Add(new PurchaseItem
                                {
                                    PurchaseId = purchaseForm.Id,
                                    Category = InferCategory(item.Description, item.Model),
                                    Manufacturer = item.Manufacturer,
                                    ModelName = modelName,
                                    Quantity = 1,
                                    UnitCost = item.UnitPrice,
                                    CandidateSerial = assignedSerial
                                });
                            }
                        }
                        else
                        {
                            purchaseForm.Items.Add(new PurchaseItem
                            {
                                PurchaseId = purchaseForm.Id,
                                Category = InferCategory(item.Description, item.Model),
                                Manufacturer = item.Manufacturer,
                                ModelName = modelName,
                                Quantity = 1,
                                UnitCost = item.UnitPrice,
                                CandidateSerial = serialsList.FirstOrDefault() ?? item.SerialNumber ?? ""
                            });
                        }
                    }
                }
                else
                {
                    AddItemRow();
                }

                if (!string.IsNullOrWhiteSpace(purchaseForm.Supplier) && !string.IsNullOrWhiteSpace(purchaseForm.InvoiceNumber))
                {
                    isDuplicate = await PurchaseService.CheckDuplicateInvoiceAsync(purchaseForm.Supplier, purchaseForm.InvoiceNumber);
                }

                currentStep = 2;
            }
            else
            {
                // MODE 2: Physical Device Label / Specs Mapping
                var mappedDevice = await FieldMappingService.MapDeviceAsync(aiResult);
                candidateSerials.Clear();

                if (!string.IsNullOrWhiteSpace(mappedDevice.Data?.SerialNumber))
                {
                    candidateSerials.Add(mappedDevice.Data.SerialNumber);
                }
                if (mappedDevice.Data?.CandidateSerials != null)
                {
                    foreach (var s in mappedDevice.Data.CandidateSerials)
                    {
                        if (!candidateSerials.Contains(s)) candidateSerials.Add(s);
                    }
                }
                if (aiResult.CandidateSerials != null)
                {
                    foreach (var s in aiResult.CandidateSerials)
                    {
                        if (!candidateSerials.Contains(s)) candidateSerials.Add(s);
                    }
                }

                directDevice = new Device
                {
                    Brand = mappedDevice.Data?.Manufacturer ?? aiResult.Manufacturer ?? "",
                    DeviceName = mappedDevice.Data?.Model ?? aiResult.Model ?? "",
                    Serial = mappedDevice.Data?.SerialNumber ?? candidateSerials.FirstOrDefault() ?? "",
                    Processor = mappedDevice.Data?.Processor ?? aiResult.Processor ?? "",
                    Ram = mappedDevice.Data?.Ram ?? aiResult.Ram ?? "",
                    Ssd = mappedDevice.Data?.Ssd ?? aiResult.Ssd ?? "",
                    Hdd = mappedDevice.Data?.Hdd ?? aiResult.Hdd ?? "",
                    Category = InferCategory($"{fullOcrText} {mappedDevice.Data?.Model} {aiResult.Model}", mappedDevice.Data?.Manufacturer ?? aiResult.Manufacturer),
                    OwnerCompany = "PrimeTech Solutions Ltd.",
                    Condition = "New",
                    Status = DeviceStatus.InStore,
                    WarrantyMonths = 36,
                    ReceivedDate = DateTime.Today.ToString("yyyy-MM-dd"),
                    Note = "Direct AI intake without upfront invoice"
                };

                currentStep = 2;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error during extraction pipeline: {ex.Message}";
        }
        finally
        {
            isAnalyzing = false;
        }
    }

    private void AddItemRow()
    {
        if (purchaseForm != null)
        {
            purchaseForm.Items.Add(new PurchaseItem
            {
                PurchaseId = purchaseForm.Id,
                Category = "General",
                ModelName = "",
                Manufacturer = "",
                Quantity = 1,
                UnitCost = 0m,
                CandidateSerial = ""
            });
        }
    }

    private void SplitRow(PurchaseItem item)
    {
        if (purchaseForm == null || (item.Quantity ?? 1) <= 1) return;
        var count = item.Quantity.Value;
        var serials = (item.CandidateSerial ?? "")
            .Split(new[] { ',', ';', ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .ToList();

        var list = purchaseForm.Items.ToList();
        var index = list.IndexOf(item);
        if (index < 0) return;

        list.RemoveAt(index);

        for (int i = 0; i < count; i++)
        {
            var sn = i < serials.Count ? serials[i] : "";
            list.Insert(index + i, new PurchaseItem
            {
                PurchaseId = purchaseForm.Id,
                Category = item.Category,
                Manufacturer = item.Manufacturer,
                ModelName = item.ModelName,
                Quantity = 1,
                UnitCost = item.UnitCost,
                CandidateSerial = sn
            });
        }

        purchaseForm.Items = list;
    }

    private void SplitAllMultiQtyRows()
    {
        if (purchaseForm == null) return;
        var itemsToSplit = purchaseForm.Items.Where(i => (i.Quantity ?? 1) > 1).ToList();
        foreach (var item in itemsToSplit)
        {
            SplitRow(item);
        }
    }

    private static string InferCategory(string? desc, string? model)
    {
        var text = $"{desc} {model}".ToLowerInvariant();
        if (text.Contains("switch") || text.Contains("catalyst") || text.Contains("sfp") || text.Contains("router") || text.Contains("gateway"))
            return "Network Switch";
        if (text.Contains("access point") || text.Contains("wifi") || text.Contains("ap") || text.Contains("cbw"))
            return "Access Point";
        if (text.Contains("laptop") || text.Contains("expertbook") || text.Contains("thinkpad") || text.Contains("latitude") || text.Contains("notebook") || text.Contains("macbook"))
            return "Laptop";
        if (text.Contains("desktop") || text.Contains("workstation") || text.Contains("optiplex") || text.Contains("tower"))
            return "Desktop";
        if (text.Contains("monitor") || text.Contains("display") || text.Contains("screen") || text.Contains("led") || text.Contains("lcd") || text.Contains("k202"))
            return "Monitor";
        if (text.Contains("ssd") || text.Contains("ram") || text.Contains("hdd") || text.Contains("drive") || text.Contains("memory"))
            return "Component";
        if (text.Contains("server"))
            return "Server";
        return "IT Equipment";
    }

    private async Task PostPurchase()
    {
        if (purchaseForm == null) return;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(purchaseForm.Supplier))
        {
            errorMessage = "Vendor / Supplier is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(purchaseForm.InvoiceNumber))
        {
            errorMessage = "Invoice number is required.";
            return;
        }
        if (!purchaseForm.Items.Any())
        {
            errorMessage = "At least one line item is required.";
            return;
        }

        isPosting = true;
        StateHasChanged();
        try
        {
            // If documents were uploaded in AI Intake, save them to wwwroot/uploads/invoices
            if (uploadedFiles.Any() && string.IsNullOrEmpty(purchaseForm.InvoiceFilePath))
            {
                var uploadsDir = Path.Combine(Env.WebRootPath, "uploads", "invoices");
                Directory.CreateDirectory(uploadsDir);

                var savedPaths = new List<string>();
                foreach (var upFile in uploadedFiles)
                {
                    var ext = Path.GetExtension(upFile.Name);
                    if (string.IsNullOrEmpty(ext))
                    {
                        ext = upFile.ContentType.Contains("pdf") ? ".pdf" : ".png";
                    }
                    var safeName = $"{purchaseForm.PurchaseNumber}_{Guid.NewGuid().ToString("N").Substring(0, 8)}{ext}";
                    var fullPath = Path.Combine(uploadsDir, safeName);
                    await File.WriteAllBytesAsync(fullPath, upFile.Bytes);
                    savedPaths.Add($"/uploads/invoices/{safeName}");
                }

                if (savedPaths.Any())
                {
                    purchaseForm.InvoiceFilePath = string.Join("|", savedPaths);
                }
            }

            await PurchaseService.AddPurchaseAsync(purchaseForm);
            savedPurchase = await PurchaseService.GetPurchaseByIdAsync(purchaseForm.Id);
            await LoadAllPurchasesAsync();

            // Populate Step 3 tagging grid
            await InitializeUnitTagEntriesAsync(savedPurchase ?? purchaseForm);

            currentStep = 3;
            Notifications.ShowSuccess($"Purchase #{purchaseForm.PurchaseNumber} committed to database. Tag your units below.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Database error saving purchase: {ex.Message}";
            Notifications.ShowError($"Database error saving purchase: {ex.Message}");
        }
        finally
        {
            isPosting = false;
            StateHasChanged();
        }
    }

    private async Task SaveDirectToStoreOnly()
    {
        await PostPurchase();
        if (errorMessage == null)
        {
            currentStep = 4;
            StateHasChanged();
        }
    }

    private async Task InitializeUnitTagEntriesAsync(Purchase p)
    {
        unitTagEntries.Clear();
        registeredUnitsList.Clear();

        var remainingCandidateSerials = new Queue<string>(candidateSerials);
        var usedTagsInBatch = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        foreach (var item in p.Items)
        {
            int remaining = item.RemainingQuantity;
            if (remaining <= 0) continue;

            int totalForThisItem = item.Quantity ?? remaining;

            for (int i = 1; i <= remaining; i++)
            {
                var dummyDevice = new Device
                {
                    Category = item.Category,
                    OwnerCompany = batchDefaultCompany,
                    Brand = item.Manufacturer
                };

                string generatedTag = await DeviceService.GenerateAssetTagAsync(dummyDevice);

                // Ensure unique in batch
                int attempt = 1;
                string candidateTag = generatedTag;
                while (usedTagsInBatch.Contains(candidateTag))
                {
                    var parts = generatedTag.Split('-');
                    if (parts.Length >= 2 && int.TryParse(parts.Last(), out int seq))
                    {
                        var prefix = string.Join("-", parts.Take(parts.Length - 1));
                        candidateTag = $"{prefix}-{(seq + attempt):D3}";
                    }
                    else
                    {
                        candidateTag = $"{generatedTag}_{attempt}";
                    }
                    attempt++;
                }
                usedTagsInBatch.Add(candidateTag);

                string serialVal = "";
                if (!string.IsNullOrWhiteSpace(item.CandidateSerial) && i == 1)
                {
                    serialVal = item.CandidateSerial;
                }
                else if (remainingCandidateSerials.Count > 0)
                {
                    serialVal = remainingCandidateSerials.Dequeue();
                }

                unitTagEntries.Add(new UnitTagEntry
                {
                    PurchaseItemId = item.Id,
                    LineItemDescription = $"{item.Manufacturer} {item.ModelName}".Trim(),
                    UnitIndex = (totalForThisItem - remaining) + i,
                    TotalUnitsForItem = totalForThisItem,
                    Brand = item.Manufacturer,
                    ModelName = item.ModelName,
                    Category = string.IsNullOrWhiteSpace(item.Category) ? "Laptop" : item.Category,
                    AssetTag = candidateTag,
                    SerialNumber = serialVal,
                    Location = batchDefaultLocation,
                    OwnerCompany = batchDefaultCompany,
                    Condition = "New",
                    WarrantyMonths = 12,
                    IsRegistered = false
                });
            }
        }
    }

    private async Task RegisterTaggedUnits()
    {
        var entriesToRegister = unitTagEntries
            .Where(u => !u.IsRegistered && !string.IsNullOrWhiteSpace(u.SerialNumber))
            .ToList();

        if (!entriesToRegister.Any())
        {
            errorMessage = "Please enter a serial number for at least one unit, or click 'Skip Remaining & Keep in Store'.";
            return;
        }

        var duplicates = entriesToRegister
            .GroupBy(u => u.SerialNumber.Trim(), StringComparer.OrdinalIgnoreCase)
            .Where(g => g.Count() > 1)
            .Select(g => g.Key)
            .ToList();

        if (duplicates.Any())
        {
            errorMessage = $"Duplicate serial number entered: {string.Join(", ", duplicates)}. Each physical device must have a unique serial.";
            return;
        }

        isRegisteringUnits = true;
        errorMessage = null;
        StateHasChanged();

        int count = 0;
        try
        {
            foreach (var entry in entriesToRegister)
            {
                var device = new Device
                {
                    Id = Guid.NewGuid().ToString(),
                    DeviceName = $"{entry.Brand} {entry.ModelName}".Trim(),
                    Brand = entry.Brand,
                    Category = entry.Category,
                    Serial = entry.SerialNumber.Trim(),
                    AssetTag = entry.AssetTag,
                    Location = entry.Location,
                    OwnerCompany = entry.OwnerCompany,
                    Condition = entry.Condition,
                    WarrantyMonths = entry.WarrantyMonths,
                    ReceivedDate = DateTime.Now.ToString("yyyy-MM-dd"),
                    Status = DeviceStatus.InStore
                };

                var registered = await DeviceService.RegisterPhysicalAssetFromPurchaseAsync(device, entry.PurchaseItemId);
                entry.IsRegistered = true;
                entry.RegisteredDeviceId = registered.Id;
                registeredUnitsList.Add(registered);
                count++;
            }

            if (savedPurchase != null)
            {
                savedPurchase = await PurchaseService.GetPurchaseByIdAsync(savedPurchase.Id);
            }
            await LoadAllPurchasesAsync();

            Notifications.ShowSuccess($"Successfully registered {count} physical asset(s) to inventory!");
            currentStep = 4;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error registering units: {ex.Message}";
            Notifications.ShowError($"Registration error: {ex.Message}");
        }
        finally
        {
            isRegisteringUnits = false;
            StateHasChanged();
        }
    }

    private void SkipAndFinishStep3()
    {
        currentStep = 4;
        StateHasChanged();
    }

    private void ApplyBulkSerials()
    {
        if (string.IsNullOrWhiteSpace(bulkSerialPasteText)) return;
        var lines = bulkSerialPasteText
            .Split(new[] { '\r', '\n', ',', '\t' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();

        int lineIndex = 0;
        foreach (var entry in unitTagEntries.Where(u => !u.IsRegistered))
        {
            if (lineIndex < lines.Count)
            {
                entry.SerialNumber = lines[lineIndex];
                lineIndex++;
            }
        }

        showBulkSerialModal = false;
        bulkSerialPasteText = "";
        Notifications.ShowSuccess($"Applied {lineIndex} serial number(s) to untagged units.");
        StateHasChanged();
    }

    private void ApplyBatchLocation(string loc)
    {
        batchDefaultLocation = loc;
        foreach (var entry in unitTagEntries.Where(u => !u.IsRegistered))
        {
            entry.Location = loc;
        }
        StateHasChanged();
    }

    private void ApplyBatchCompany(string comp)
    {
        batchDefaultCompany = comp;
        foreach (var entry in unitTagEntries.Where(u => !u.IsRegistered))
        {
            entry.OwnerCompany = comp;
        }
        StateHasChanged();
    }

    private async Task StartTaggingFromPurchase(Purchase p)
    {
        var fullPurchase = await PurchaseService.GetPurchaseByIdAsync(p.Id);
        if (fullPurchase == null) return;

        savedPurchase = fullPurchase;
        await InitializeUnitTagEntriesAsync(fullPurchase);
        activeMainTab = "upload";
        currentStep = 3;
        StateHasChanged();
    }

    private async Task LoadPurchaseForTaggingAsync(string id)
    {
        var p = await PurchaseService.GetPurchaseByIdAsync(id);
        if (p != null)
        {
            await StartTaggingFromPurchase(p);
        }
    }

