    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs">
        <div class="bg-surface rounded-2xl border border-line p-6 shadow-2xl max-w-md w-full space-y-4 animate-in fade-in zoom-in-95">
            <div class="flex items-center gap-3 text-danger-600 border-b border-line-soft pb-3">
