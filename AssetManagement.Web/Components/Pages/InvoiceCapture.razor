            else
            {
                <p class="text-xs text-txt-mid">
                    Are you sure you want to permanently delete purchase <strong>@deletingPurchase.PurchaseNumber</strong> (Invoice: @(deletingPurchase.InvoiceNumber ?? "—"))? This action will remove all associated line items and the uploaded document.
                </p>
            }

            <div class="flex items-center justify-end gap-2 pt-3 border-t border-line-soft">
                <button type="button" @onclick="() => showDeleteModal = false" class="px-4 py-2 rounded-xl border border-line text-xs font-semibold text-txt-mid hover:bg-elevated transition-colors cursor-pointer">
                    @(hasRegisteredDevices ? "Close" : "Cancel")
