    }

    private async Task RegisterDirectDevice()
    {
        if (directDevice == null) return;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(directDevice.Serial))
        {
            errorMessage = "Serial number is required to register a physical asset.";
            return;
        }

        if (string.IsNullOrWhiteSpace(directDevice.DeviceName))
        {
            directDevice.DeviceName = "Physical Device";
        }

        isRegisteringDevice = true;
        StateHasChanged();

        try
        {
            directDevice.PurchaseItemId = null; // Unbilled / Direct intake
            await DeviceService.AddDeviceAsync(directDevice);
            createdDevice = directDevice;
            registeredUnitsList.Clear();
            registeredUnitsList.Add(directDevice);
            currentStep = 4;
            Notifications.ShowSuccess($"Asset '{directDevice.DeviceName}' ({directDevice.AssetTag ?? directDevice.Serial}) registered successfully.");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error registering device: {ex.Message}";
            Notifications.ShowError($"Error registering device: {ex.Message}");
        }
        finally
        {
            isRegisteringDevice = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        currentStep = 1;
        uploadedFiles.Clear();
        purchaseForm = null;
        savedPurchase = null;
        directDevice = null;
        createdDevice = null;
        candidateSerials.Clear();
        unitTagEntries.Clear();
        registeredUnitsList.Clear();
        errorMessage = null;
        isDuplicate = false;
        validationWarnings.Clear();
        selectedPreviewIndex = 0;
        zoomScale = 1.0;
        bulkSerialPasteText = "";
        showBulkSerialModal = false;
    }

