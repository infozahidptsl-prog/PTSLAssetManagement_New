                </div>
            </div>

            @if (!string.IsNullOrEmpty(deleteErrorMessage))
            {
                <div class="p-3 rounded-lg bg-danger-50 text-danger-700 border border-danger-200 text-xs">@deleteErrorMessage</div>
            }

            @if (hasRegisteredDevices)
            {
                <div class="p-3 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-800 space-y-1">
                    <p class="font-bold">Cannot Delete This Purchase</p>
                    <p>There are physical assets registered from this purchase. To delete it, you must first remove those registered devices from <strong>All assets</strong>.</p>
