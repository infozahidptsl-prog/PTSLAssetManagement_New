@code {
    private string activeMainTab = "upload";
    private void SetActiveMainTab(string tab)
    {
        activeMainTab = tab;
        if (tab == "registry")
        {
            _ = LoadAllPurchasesAsync();
        }
        StateHasChanged();
    }

    // Registry Tab State
    private List<Purchase> allPurchases = new();
    private string registryStatusFilter = "all";
    private string registrySearchTerm = "";
    private DateTime? registryStartDate;
    private DateTime? registryEndDate;
    private int registryPage = 1;
    private int registryPageSize = 10;

    // Computed KPI Stats
    private int PendingRegistrationCount => allPurchases.Count(p => p.Items.Any() && p.Items.Sum(i => i.RemainingQuantity) > 0);
    private int CompletedInvoicesCount => allPurchases.Count(p => p.Items.Any() && p.Items.Sum(i => i.RemainingQuantity) <= 0);
    private int TotalHardwareUnits => allPurchases.SelectMany(p => p.Items).Sum(i => i.Quantity ?? 0);

    // Registry Filter & Pagination Computed Properties
    private List<Purchase> FilteredRegistryPurchases
    {
        get
        {
            var q = allPurchases.AsEnumerable();

            if (registryStatusFilter == "pending")
            {
                q = q.Where(p => p.Items.Any() && p.Items.Sum(i => i.RemainingQuantity) > 0);
            }
            else if (registryStatusFilter == "completed")
            {
                q = q.Where(p => p.Items.Any() && p.Items.Sum(i => i.RemainingQuantity) <= 0);
            }

            if (registryStartDate.HasValue)
            {
                q = q.Where(p => p.PurchaseDate.HasValue && p.PurchaseDate.Value.Date >= registryStartDate.Value.Date);
            }
            if (registryEndDate.HasValue)
            {
                q = q.Where(p => p.PurchaseDate.HasValue && p.PurchaseDate.Value.Date <= registryEndDate.Value.Date);
            }

            if (!string.IsNullOrWhiteSpace(registrySearchTerm))
            {
                var term = registrySearchTerm.Trim().ToLowerInvariant();
                q = q.Where(p =>
                    (p.PurchaseNumber != null && p.PurchaseNumber.ToLowerInvariant().Contains(term)) ||
                    (p.Supplier != null && p.Supplier.ToLowerInvariant().Contains(term)) ||
                    (p.InvoiceNumber != null && p.InvoiceNumber.ToLowerInvariant().Contains(term)) ||
                    p.Items.Any(i => (i.ModelName != null && i.ModelName.ToLowerInvariant().Contains(term)) ||
                                     (i.Manufacturer != null && i.Manufacturer.ToLowerInvariant().Contains(term))));
            }

            q = registrySortColumn switch
            {
                "Purchase" => registrySortAscending
                    ? q.OrderBy(p => p.PurchaseDate ?? DateTime.MinValue).ThenBy(p => p.PurchaseNumber)
                    : q.OrderByDescending(p => p.PurchaseDate ?? DateTime.MinValue).ThenByDescending(p => p.PurchaseNumber),
                "Supplier" => registrySortAscending
                    ? q.OrderBy(p => p.Supplier).ThenBy(p => p.PurchaseNumber)
                    : q.OrderByDescending(p => p.Supplier).ThenByDescending(p => p.PurchaseNumber),
                "Invoice" => registrySortAscending
                    ? q.OrderBy(p => p.InvoiceNumber ?? string.Empty)
                    : q.OrderByDescending(p => p.InvoiceNumber ?? string.Empty),
                "Items" => registrySortAscending
                    ? q.OrderBy(p => p.Items.Sum(i => i.Quantity ?? 0))
                    : q.OrderByDescending(p => p.Items.Sum(i => i.Quantity ?? 0)),
                "Status" => registrySortAscending
                    ? q.OrderBy(p => p.Items.Sum(i => i.RemainingQuantity))
                    : q.OrderByDescending(p => p.Items.Sum(i => i.RemainingQuantity)),
                _ => q.OrderByDescending(p => p.PurchaseDate ?? DateTime.MinValue).ThenByDescending(p => p.Id)
            };

            return q.ToList();
        }
    }

    private string registrySortColumn = "Purchase";
    private bool registrySortAscending = false;

    private void SortRegistryBy(string col)
    {
        if (registrySortColumn == col)
        {
            registrySortAscending = !registrySortAscending;
        }
        else
        {
            registrySortColumn = col;
            registrySortAscending = true;
        }
        registryPage = 1;
    }

    private RenderFragment RenderRegistrySortIcon(string col) => __builder =>
    {
        if (registrySortColumn == col)
        {
            if (registrySortAscending)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m5 15 7-7 7 7"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m19 9-7 7-7-7"/></svg>
            }
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-line-strong opacity-40 group-hover:opacity-100 transition-opacity"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
        }
    };

    private List<Purchase> PaginatedRegistryPurchases =>
        FilteredRegistryPurchases
            .Skip((registryPage - 1) * registryPageSize)
            .Take(registryPageSize)
            .ToList();

    private int TotalRegistryPages =>
        Math.Max(1, (int)Math.Ceiling((double)Math.Max(1, FilteredRegistryPurchases.Count) / registryPageSize));

    private void SetRegistryFilter(string filter)
    {
        registryStatusFilter = filter;
        ResetRegistryPage();
    }

    private void ResetRegistryPage()
    {
        registryPage = 1;
        StateHasChanged();
    }

    private void GoToRegistryPage(int page)
    {
        registryPage = Math.Clamp(page, 1, TotalRegistryPages);
    }

    private async Task LoadAllPurchasesAsync()
    {
        try
        {
            allPurchases = await PurchaseService.GetAllPurchasesAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading purchases: {ex.Message}");
        }
    }

    [SupplyParameterFromQuery]
    public string? PurchaseId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAllPurchasesAsync();
        try
        {
            var cats = await SettingsService.GetCategoriesAsync();
            if (cats != null && cats.Any())
            {
                var names = cats.Select(c => c.Name).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().ToList();
                if (names.Any())
                {
                    deviceCategories = names;
                }
            }
        }
        catch { }

        if (!string.IsNullOrEmpty(PurchaseId))
        {
            await LoadPurchaseForTaggingAsync(PurchaseId);
        }
    }

    // Invoice Document Viewer
    private bool showInvoiceViewer = false;
    private string? selectedInvoicePath;
    private void OpenInvoiceViewer(string? path)
    {
        selectedInvoicePath = path;
        showInvoiceViewer = true;
    }

    // Edit Purchase Modal
    private bool showEditModal = false;
    private Purchase? editingPurchase;
    private string? editErrorMessage;

    private void OpenEditModal(Purchase p)
    {
        editingPurchase = new Purchase
        {
            Id = p.Id,
            PurchaseNumber = p.PurchaseNumber,
            Supplier = p.Supplier,
            InvoiceNumber = p.InvoiceNumber,
            PurchaseDate = p.PurchaseDate,
            Notes = p.Notes,
            InvoiceFilePath = p.InvoiceFilePath
        };
        editErrorMessage = null;
        showEditModal = true;
    }

    private void OnEditPurchaseDateChange(ChangeEventArgs e)
    {
        if (editingPurchase != null && DateTime.TryParse(e.Value?.ToString(), out var dt))
        {
            editingPurchase.PurchaseDate = dt;
        }
    }

    private bool isUploadingEditFile = false;

    private async Task HandleEditPurchaseFileUpload(InputFileChangeEventArgs e)
    {
        if (editingPurchase == null) return;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 15 * 1024 * 1024)
        {
            editErrorMessage = "File size must be 15MB or less.";
            return;
        }

        isUploadingEditFile = true;
        editErrorMessage = null;
        StateHasChanged();

        try
        {
            var uploadsDir = Path.Combine(Env.WebRootPath, "uploads", "invoices");
            Directory.CreateDirectory(uploadsDir);
            var ext = Path.GetExtension(file.Name);
            var safeName = $"{editingPurchase.PurchaseNumber}_{Guid.NewGuid().ToString("N").Substring(0, 8)}{ext}";
            var fullPath = Path.Combine(uploadsDir, safeName);

            await using (var fs = new FileStream(fullPath, FileMode.Create))
            {
                await file.OpenReadStream(15 * 1024 * 1024).CopyToAsync(fs);
            }

