@page "/obsolete"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AssetManagement.Core.Security.Permissions.Devices.View)]
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Infrastructure.Services
@using AssetManagement.Web.Models
@inject DeviceService DeviceService
@inject NavigationManager NavigationManager

<PageTitle>Scrapped assets - PrimeTech Asset Manager</PageTitle>

<div class="bg-surface pb-4 border-b border-line-soft">
<PageHeader Title="Scrapped assets">
    <Actions>
        <button type="button" @onclick="ShowScrapModal" class="inline-flex items-center justify-center gap-2 rounded-lg border border-danger-border bg-danger-soft text-danger-500 hover:bg-danger-500 hover:text-white px-4 py-2 text-sm font-semibold transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-danger-500">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
            Declare obsolete
        </button>
    </Actions>
    <ChildContent>
        <div class="mt-5 flex flex-row gap-3">
            <div class="flex-1 group relative overflow-hidden rounded-xl border border-red-200 bg-red-50 dark:bg-red-900/20 text-left shadow-sm">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-red-800 dark:text-red-400">Obsolete items</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@obsoleteItems.Count</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Written-off assets</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-red-100 text-red-600 dark:text-red-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                    </span>
                </div>
            </div>

            <div class="flex-1 group relative overflow-hidden rounded-xl border border-orange-100 bg-orange-50 dark:bg-orange-900/20 text-left">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-orange-800 dark:text-orange-400">Original purchase value</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@String.Format(new System.Globalization.CultureInfo("bn-BD"), "{0:C0}", writtenOffValue)</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Lost capital</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-orange-100 text-orange-600 dark:text-orange-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    </span>
                </div>
            </div>

            <div class="flex-1 group relative overflow-hidden rounded-xl border border-cyan-200 bg-cyan-50 dark:bg-cyan-900/20 text-left">
                <div class="relative z-10 flex items-start justify-between p-4">
                    <div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-cyan-700 dark:text-cyan-400">Write-off events</p>
                        <p class="tnum mt-1 text-xl font-bold tracking-tight text-txt-hi">@obsoleteItems.Count</p>
                        <p class="mt-0.5 text-[11px] text-txt-lo">Total scrap actions</p>
                    </div>
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-cyan-100 text-cyan-600 dark:text-cyan-400">
                        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
                    </span>
                </div>
            </div>
        </div>
    </ChildContent>
</PageHeader>
</div>

<section aria-label="Obsolete items" class="bg-surface">
    <h2 class="px-6 pb-1 pt-5 text-[11px] font-medium uppercase tracking-widest text-txt-lo lg:px-9">
        Obsolete items
    </h2>
    <AppTable TItem="Device" Items="sortedObsoleteItems" OnRowClick="@((Device device) => NavigationManager.NavigateTo($"/device/{device.Id}"))">
        <HeaderContent>
            <th scope="col" class="py-2 pl-6 pr-3 font-semibold text-[10px] uppercase tracking-widest text-txt-mid lg:pl-9 cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Asset")'>
                <div class="flex items-center gap-1.5">Asset ID @RenderSortIcon("Asset")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Type")'>
                <div class="flex items-center gap-1.5">Type @RenderSortIcon("Type")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Specification")'>
                <div class="flex items-center gap-1.5">Specification @RenderSortIcon("Specification")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Status")'>
                <div class="flex items-center gap-1.5">Status @RenderSortIcon("Status")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("User")'>
                <div class="flex items-center gap-1.5">USER @RenderSortIcon("User")</div>
            </th>
            <th scope="col" class="px-3 py-2 font-semibold text-[10px] uppercase tracking-widest text-txt-mid cursor-pointer hover:bg-elevated transition-colors group select-none" @onclick='() => SortBy("Warranty")'>
                <div class="flex items-center gap-1.5">Warranty @RenderSortIcon("Warranty")</div>
            </th>
            <th scope="col" class="relative py-2 pl-3 pr-6 lg:pr-9"><span class="sr-only">Open</span></th>
        </HeaderContent>
        <RowTemplate Context="device">
            <th scope="row" class="py-2 pl-6 pr-3 text-left lg:pl-9">
                <a href="/device/@device.Id" class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 rounded"><AssetManagement.Web.Components.Shared.AssetIdentityCell Device="device" Class="group-hover:opacity-80 transition-opacity" /></a>
            </th>
            <td class="px-3 py-3">
                <AssetManagement.Web.Components.Shared.AssetTypeBadge Device="device" />
            </td>
            <td class="px-3 py-3">
                <span class="block text-sm text-txt-hi">@(string.IsNullOrEmpty(device.ProcessorFamily) ? "—" : $"{device.ProcessorFamily} {device.Ram} {device.Ssd}")</span>
                <span class="block text-xs text-txt-mid truncate max-w-[200px]" title="@device.Note">@device.Note</span>
            </td>
            <td class="px-3 py-3">
                <StatusBadge Status="device.Status" />
            </td>
            <td class="px-3 py-3 text-txt-mid text-sm">
                @(string.IsNullOrEmpty(device.UserName) ? "IT inventory" : device.UserName)
            </td>
            <td class="tnum whitespace-nowrap px-3 py-3 text-xs">
                @if (device.WarrantyEndDate.HasValue)
                {
                    if (device.WarrantyEndDate.Value < DateTime.Now)
                    {
                        <span class="text-danger-400 font-medium">Expired <span class="font-normal">@device.WarrantyEndDate.Value.ToString("d MMM yyyy")</span></span>
                    }
                    else
                    {
                        <span class="text-warn-400 font-medium">Expiring <span class="font-normal">@device.WarrantyEndDate.Value.ToString("d MMM yyyy")</span></span>
                    }
                }
                else
                {
                    <span class="text-txt-lo">No warranty</span>
                }
            </td>
            <td class="py-3 pl-3 pr-6 text-right lg:pr-9">
                <a href="/device/@device.Id" class="inline-flex text-txt-lo hover:text-txt-hi">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
                </a>
            </td>
        </RowTemplate>
    </AppTable>
</section>

@if (showScrapModal)
{
    <ScrapDeviceModal OnClose="CloseScrapModal" OnSaved="OnDeviceScrapped" />
}

@code {
    private List<Device> obsoleteItems = new();
    private double writtenOffValue = 0;
    
    private bool showScrapModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var allDevices = await DeviceService.GetDevicesAsync();
        obsoleteItems = allDevices.Where(d => d.Status == DeviceStatus.WrittenOff).ToList();
        writtenOffValue = obsoleteItems.Sum(d => (double)(d.AssetAmount ?? 0));
    }

    private void ShowScrapModal() => showScrapModal = true;
    
    private void CloseScrapModal() => showScrapModal = false;

    private async Task OnDeviceScrapped()
    {
        showScrapModal = false;
        await LoadData();
    }

    private string SortColumn { get; set; } = "Asset";
    private bool SortAscending { get; set; } = true;

    private List<Device> sortedObsoleteItems
    {
        get
        {
            var result = obsoleteItems.AsEnumerable();
            return (SortColumn switch
            {
                "Asset" => SortAscending 
                    ? result.OrderBy(d => d.AssetTag ?? d.Id).ThenBy(d => d.Brand) 
                    : result.OrderByDescending(d => d.AssetTag ?? d.Id).ThenByDescending(d => d.Brand),
                "Type" => SortAscending 
                    ? result.OrderBy(d => d.Category).ThenBy(d => d.IsComponent) 
                    : result.OrderByDescending(d => d.Category).ThenByDescending(d => d.IsComponent),
                "Specification" => SortAscending 
                    ? result.OrderBy(d => d.Processor).ThenBy(d => d.Ram) 
                    : result.OrderByDescending(d => d.Processor).ThenByDescending(d => d.Ram),
                "Status" => SortAscending 
                    ? result.OrderBy(d => d.Status.ToString()) 
                    : result.OrderByDescending(d => d.Status.ToString()),
                "User" => SortAscending 
                    ? result.OrderBy(d => d.UserName ?? string.Empty).ThenBy(d => d.EmployeeId ?? string.Empty) 
                    : result.OrderByDescending(d => d.UserName ?? string.Empty).ThenByDescending(d => d.EmployeeId ?? string.Empty),
                "Warranty" => SortAscending 
                    ? result.OrderBy(d => d.HasWarranty ? 0 : 1).ThenBy(d => d.WarrantyEndDate) 
                    : result.OrderByDescending(d => d.HasWarranty ? 0 : 1).ThenByDescending(d => d.WarrantyEndDate),
                _ => result
            }).ToList();
        }
    }

    private void SortBy(string column)
    {
        if (SortColumn == column) SortAscending = !SortAscending;
        else { SortColumn = column; SortAscending = true; }
    }

    private RenderFragment RenderSortIcon(string column) => __builder =>
    {
        if (SortColumn == column)
        {
            if (SortAscending)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m5 15 7-7 7 7"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m19 9-7 7-7-7"/></svg>
            }
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-line-strong opacity-40 group-hover:opacity-100 transition-opacity"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
        }
    };
}




