                        <select @bind="editingReq.Status" class="w-full rounded-lg border border-line bg-elevated px-3 py-2 text-sm text-txt-hi focus:border-accent-border focus:outline-none">
                            <option value="Pending">Pending</option>
                            <option value="Done">Done</option>
