                        <input type="date" @bind="editReqReceivedDate" class="w-full rounded-lg border border-line bg-elevated px-3 py-2 text-sm text-txt-hi focus:border-accent-border focus:outline-none" />
                    </div>

                    @* Requested By *@
                    <div class="col-span-2 sm:col-span-1">
                        <label class="mb-1.5 block text-xs font-semibold text-txt-mid">Requested By <span class="text-rose-500">*</span></label>
                        <SearchableSelect Value="@editEmployeeId"
                                          ValueChanged="OnEditEmployeeSelected"
                                          Options="@employeeOptions"
                                          Placeholder="Select employee..."
                                          AllowClear="true" />
                    </div>

                    @* Project Manager *@
                    <div class="col-span-2 sm:col-span-1">
                        <label class="mb-1.5 block text-xs font-semibold text-txt-mid">Project Manager</label>
                        <SearchableSelect @bind-Value="editingReq.ProjectManagerName"
                                          Options="@managerOptions"
                                          Placeholder="Select PM..."
                                          AllowClear="true" />
                    </div>

                    @* Priority *@
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-txt-mid">Priority</label>
                        <SearchableSelect @bind-Value="editingReq.Priority"
                                          Options="@priorityOptions"
                                          Placeholder="Select priority..."
                                          AllowClear="false"
                                          AllowCustomValues="false" />
                    </div>

                    @* Quantity *@
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-txt-mid">Quantity</label>
                        <input type="number" @bind="editingReq.Quantity" min="1" max="99" class="w-full rounded-lg border border-line bg-elevated px-3 py-2 text-sm text-txt-hi focus:border-accent-border focus:outline-none" />
                    </div>

                    @* Asset Category *@
                    <div>
                        <label class="mb-1.5 block text-xs font-semibold text-txt-mid">Asset Category <span class="text-rose-500">*</span></label>
                        <SearchableSelect Value="@editingReq.AssetCategory"
                                          ValueChanged="OnEditCategorySelected"
