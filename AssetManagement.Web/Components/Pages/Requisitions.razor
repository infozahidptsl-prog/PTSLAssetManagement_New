                                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-txt-lo group-hover:text-txt-hi transition-colors"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                    <span class="text-xs text-txt-mid">Click, drop, or <kbd class="px-1 py-0.5 border border-line-soft rounded text-[10px] bg-elevated font-mono">Ctrl+V</kbd> to paste <span class="font-medium text-txt-hi">image/email</span></span>
                                    <span class="text-[11px] text-txt-lo">JPG, PNG, PDF, EML, MSG</span>
                                </div>
                            }
