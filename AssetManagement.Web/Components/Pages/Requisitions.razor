            </div>
            <div class="flex justify-end gap-2 border-t border-line-soft px-6 py-4 shrink-0">
                <button type="button" @onclick="CloseModals" class="rounded-lg border border-line bg-elevated px-4 py-2 text-sm font-medium text-txt-mid hover:text-txt-hi transition-colors">Cancel</button>
                <button type="button" @onclick="SubmitNewRequisition" disabled="@isSaving"
                        class="inline-flex items-center gap-2 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-white hover:bg-accent-600 transition-colors disabled:opacity-60">
                    @if (isSaving) { <span>Saving&#x2026;</span> } else { <span>Submit Requisition</span> }
                </button>
            </div>
        </div>
