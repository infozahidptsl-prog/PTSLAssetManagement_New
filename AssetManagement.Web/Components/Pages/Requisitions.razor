}

@* ==================== EDIT REQUISITION MODAL ==================== *@
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm" @onclick="CloseModals">
        <div class="relative w-full max-w-2xl rounded-2xl bg-surface shadow-2xl border border-line max-h-[90vh] flex flex-col" @onclick:stopPropagation="true">
            <div class="flex items-center justify-between border-b border-line-soft px-6 py-4 shrink-0">
                <div>
                    <h2 class="text-base font-semibold text-txt-hi">Edit Requisition</h2>
                    <span class="font-mono text-xs text-txt-lo">@editingReq.RequisitionNumber</span>
                </div>
                <button type="button" @onclick="CloseModals" class="rounded-lg p-1.5 text-txt-lo hover:bg-elevated hover:text-txt-hi transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
            </div>
            <div class="px-6 py-5 space-y-4 overflow-y-auto">
                <div class="grid grid-cols-2 gap-4">

                    @* Status *@
                    <div class="col-span-2 sm:col-span-1">
                        <label class="mb-1.5 block text-xs font-medium text-txt-mid">Status</label>
                        <select @bind="editingReq.Status" class="w-full rounded-lg border border-line bg-elevated px-3 py-2 text-sm text-txt-hi focus:border-accent-border focus:outline-none">
                            <option value="Pending">Pending</option>
                            <option value="Done">Done</option>
                        </select>
                    </div>

                    @* Requisition Received Date *@
                    <div class="col-span-2 sm:col-span-1">
