                            <h2 class="text-base font-bold text-txt-hi">Edit Requisition</h2>
                            <span class="font-mono text-xs font-semibold px-2 py-0.5 rounded bg-elevated border border-line text-txt-mid">@editingReq.RequisitionNumber</span>
                        </div>
                        <p class="text-[11px] text-txt-lo">Update requisition details or change attached screenshot</p>
                    </div>
                </div>
                <button type="button" @onclick="CloseModals" class="rounded-lg p-1.5 text-txt-mid hover:bg-elevated hover:text-txt-hi transition-colors border border-line-soft">
