</style>

@code {
    private string reportType = "summary";
    private List<Device> allDevices = new();
    private List<Employee> allEmployees = new();
    private List<Handover> allHandovers = new();
    private List<Handover> activeHandovers = new();
    private List<RepairRecord> allRepairs = new();

    // Summary Stats
    private int totalAssetsCount;
    private double totalCapitalValue;
    private int issuedAssetsCount;
    private double issuedValue;
    private int inStockAssetsCount;
    private double inStockValue;
    private int obsoleteCount;
    private double obsoleteValue;
    private int inRepairCount;
    private double inRepairValue;
    private int installedCount;
    private double installedValue;

    private int systemCount;
    private double systemValue;
    private int componentCount;
    private double componentValue;
    private int peripheralCount;
    private double peripheralValue;

    // Warranty Stats
    private int inWarrantyCount;
    private int warrantyExpiringCount;
    private int expiredWarrantyCount;
    private int noCoverCount;

    // Repair Stats
    private int completedRepairsCount;
    private decimal totalRepairSpend;

    // Rows
    private List<DepartmentSummaryRow> departmentSummaryRows = new();
    private List<AllocationRow> allocationRows = new();
    private List<WarrantyRow> warrantyRows = new();
    private List<RepairRow> repairRows = new();
    private List<ObsoleteRow> obsoleteRows = new();
    private List<MovementRow> movementRows = new();
    private List<ComponentRow> componentRows = new();

    protected override async Task OnInitializedAsync()
    {
        allDevices = await DeviceService.GetDevicesAsync();
        
        allEmployees = await EmployeeService.GetEmployeesAsync(false);
        var actEmps = await EmployeeService.GetEmployeesAsync(true);
        allEmployees.AddRange(actEmps);
        allEmployees = allEmployees.GroupBy(e => e.Id).Select(g => g.First()).ToList();

        allHandovers = await HandoverService.GetHandoversAsync();
        activeHandovers = allHandovers.Where(h => string.IsNullOrEmpty(h.ReturnDate)).ToList();

        allRepairs = await RepairService.GetRepairsAsync();
        
        CalculateSummaryStats();
        BuildDepartmentSummaryRows();
        BuildAllocationRows();
        BuildWarrantyRows();
        BuildRepairAndObsoleteRows();
        BuildMovementRows();
        BuildComponentRows();
    }

    private void CalculateSummaryStats()
    {
        var activeDevices = allDevices.Where(d => d.Status != DeviceStatus.WrittenOff).ToList();
        
        totalAssetsCount = activeDevices.Count;
        totalCapitalValue = activeDevices.Sum(d => (double)(d.AssetAmount ?? 0));
        
        var issued = allDevices.Where(d => d.Status == DeviceStatus.InUse).ToList();
        issuedAssetsCount = issued.Count;
        issuedValue = issued.Sum(d => (double)(d.AssetAmount ?? 0));
        
        var inStock = allDevices.Where(d => d.Status == DeviceStatus.InStore).ToList();
        inStockAssetsCount = inStock.Count;
        inStockValue = inStock.Sum(d => (double)(d.AssetAmount ?? 0));
        
        var repairs = allDevices.Where(d => d.Status == DeviceStatus.Faulty || d.Status == DeviceStatus.InRepair).ToList();
        inRepairCount = repairs.Count;
        inRepairValue = repairs.Sum(d => (double)(d.AssetAmount ?? 0));
        
        var obsolete = allDevices.Where(d => d.Status == DeviceStatus.WrittenOff).ToList();
        obsoleteCount = obsolete.Count;
        obsoleteValue = obsolete.Sum(d => (double)(d.AssetAmount ?? 0));
        
        installedCount = allDevices.Count(d => d.ParentDeviceId != null);
        installedValue = allDevices.Where(d => d.ParentDeviceId != null).Sum(d => (double)(d.AssetAmount ?? 0));

        warrantyExpiringCount = activeDevices.Count(d => d.HasWarranty && d.WarrantyEndDate.HasValue && (d.WarrantyEndDate.Value - DateTime.Now).TotalDays >= 0 && (d.WarrantyEndDate.Value - DateTime.Now).TotalDays <= 90);
        inWarrantyCount = activeDevices.Count(d => d.HasWarranty && d.WarrantyEndDate.HasValue && (d.WarrantyEndDate.Value - DateTime.Now).TotalDays > 90);
        expiredWarrantyCount = activeDevices.Count(d => d.HasWarranty && d.WarrantyEndDate.HasValue && (d.WarrantyEndDate.Value - DateTime.Now).TotalDays < 0);
        noCoverCount = activeDevices.Count(d => !d.HasWarranty);

        var systems = activeDevices.Where(d => IsSystem(d.Category)).ToList();
        systemCount = systems.Count;
        systemValue = systems.Sum(d => (double)(d.AssetAmount ?? 0));

        var components = activeDevices.Where(d => d.IsComponent).ToList();
        componentCount = components.Count;
        componentValue = components.Sum(d => (double)(d.AssetAmount ?? 0));

        var peripherals = activeDevices.Where(d => !IsSystem(d.Category) && !d.IsComponent).ToList();
        peripheralCount = peripherals.Count;
        peripheralValue = peripherals.Sum(d => (double)(d.AssetAmount ?? 0));

        completedRepairsCount = allRepairs.Count(r => r.Status == "Completed" || r.Status == "Repaired");
        totalRepairSpend = allRepairs.Sum(r => r.Cost ?? 0m);
    }

    private void BuildDepartmentSummaryRows()
    {
        departmentSummaryRows.Clear();
        var empDeptMap = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var emp in allEmployees.Where(e => !string.IsNullOrEmpty(e.Department) && !string.IsNullOrEmpty(e.Name)))
        {
            empDeptMap[emp.Name] = emp.Department!;
        }

        var deptGroups = new Dictionary<string, (int staff, int assets, double value)>(StringComparer.OrdinalIgnoreCase);

        foreach (var dev in allDevices.Where(d => d.Status != DeviceStatus.WrittenOff))
        {
            string dept = "In Reserve / Unassigned";
            if (dev.Status == DeviceStatus.InUse)
            {
                var empName = dev.UserName;
                if (!string.IsNullOrEmpty(empName) && empDeptMap.TryGetValue(empName, out var dName))
                {
                    dept = dName;
                }
                else
                {
                    dept = "General Administration";
                }
            }

            if (!deptGroups.ContainsKey(dept))
            {
                deptGroups[dept] = (0, 0, 0);
            }

            var current = deptGroups[dept];
            deptGroups[dept] = (current.staff, current.assets + 1, current.value + (double)(dev.AssetAmount ?? 0));
        }

        // Count staff per dept
        foreach (var emp in allEmployees.Where(e => !string.IsNullOrEmpty(e.Department)))
        {
            if (deptGroups.ContainsKey(emp.Department!))
            {
                var c = deptGroups[emp.Department!];
                deptGroups[emp.Department!] = (c.staff + 1, c.assets, c.value);
            }
        }

        foreach (var kvp in deptGroups.OrderByDescending(g => g.Value.assets))
        {
            departmentSummaryRows.Add(new DepartmentSummaryRow
            {
                DepartmentName = kvp.Key,
                StaffCount = Math.Max(1, kvp.Value.staff),
                AssetCount = kvp.Value.assets,
                TotalValue = kvp.Value.value
            });
        }
    }

    private void BuildAllocationRows()
    {
        allocationRows.Clear();
        foreach (var dev in allDevices.Where(d => d.Status == DeviceStatus.InUse))
        {
            var handover = activeHandovers.OrderByDescending(h => h.Id).FirstOrDefault(h => h.DeviceId == dev.Id);
            var empName = handover?.To ?? dev.UserName ?? "Unassigned";
            var emp = allEmployees.FirstOrDefault(e => string.Equals(e.Name, empName, StringComparison.OrdinalIgnoreCase));
            
            var specs = new List<string>();
            if (!string.IsNullOrEmpty(dev.Processor)) specs.Add(dev.Processor);
            if (!string.IsNullOrEmpty(dev.Ram)) specs.Add(dev.Ram);
            if (!string.IsNullOrEmpty(dev.Ssd)) specs.Add(dev.Ssd);
            if (!string.IsNullOrEmpty(dev.Hdd)) specs.Add(dev.Hdd);

            allocationRows.Add(new AllocationRow
            {
                EmployeeName = empName,
                EmployeeId = emp?.EmployeeId ?? (!string.IsNullOrEmpty(dev.EmployeeId) ? dev.EmployeeId : "-"),
                Designation = emp?.Designation ?? (!string.IsNullOrEmpty(dev.Designation) ? dev.Designation : "Employee"),
                AssetId = string.IsNullOrEmpty(dev.AssetTag) ? dev.Id.Substring(0, Math.Min(8, dev.Id.Length)) : dev.AssetTag,
                ItemName = $"{dev.Brand} {dev.DeviceName}",
                Serial = !string.IsNullOrEmpty(dev.Serial) ? dev.Serial : "—",
                Type = dev.IsComponent ? "Component" : dev.DeviceTypeDisplay == "System" ? $"System · {dev.Category}" : $"Peripheral · {dev.Category}",
                Specification = specs.Any() ? string.Join(" · ", specs) : "—",
                IssuedOn = handover != null && DateTime.TryParse(handover.Released, out var rd) ? rd.ToString("d MMM yyyy") : (!string.IsNullOrEmpty(dev.Released) ? dev.Released : "Active"),
                WarrantyStatus = GetWarrantyBadgeText(dev)
            });
        }
        allocationRows = allocationRows.OrderBy(r => r.EmployeeName).ToList();
    }

    private void BuildWarrantyRows()
    {
        warrantyRows.Clear();
        foreach (var dev in allDevices.Where(d => d.Status != DeviceStatus.WrittenOff))
        {
            warrantyRows.Add(new WarrantyRow
            {
                AssetId = string.IsNullOrEmpty(dev.AssetTag) ? dev.Id.Substring(0, Math.Min(8, dev.Id.Length)) : dev.AssetTag,
                ItemName = $"{dev.Brand} {dev.DeviceName}",
                Type = dev.IsComponent ? "Component" : dev.DeviceTypeDisplay == "System" ? $"System · {dev.Category}" : $"Peripheral · {dev.Category}",
                Serial = !string.IsNullOrEmpty(dev.Serial) ? dev.Serial : "—",
                Supplier = !string.IsNullOrEmpty(dev.From) ? dev.From : "Authorized Vendor",
                PurchasedOn = dev.ProcurementDate?.ToString("d MMM yyyy") ?? (!string.IsNullOrEmpty(dev.ReceivedDate) ? dev.ReceivedDate : "—"),
                WarrantyDuration = dev.WarrantyMonths > 0 ? $"{dev.WarrantyMonths} mos" : "—",
                EndsOn = dev.WarrantyEndDate?.ToString("d MMM yyyy") ?? "—",
                HeldBy = dev.Status == DeviceStatus.InUse 
                    ? (!string.IsNullOrEmpty(dev.UserName) 
                        ? (!string.IsNullOrEmpty(dev.EmployeeId) ? $"{dev.UserName} ({dev.EmployeeId})" : dev.UserName) 
                        : (!string.IsNullOrEmpty(dev.EmployeeId) ? dev.EmployeeId : "Assigned")) 
                    : dev.Status == DeviceStatus.InStore ? "IT Reserve" : dev.Status == DeviceStatus.Faulty ? "In Repair" : "—",
                DaysRemaining = dev.WarrantyEndDate.HasValue ? (dev.WarrantyEndDate.Value - DateTime.Now).TotalDays : int.MaxValue
            });
        }
        warrantyRows = warrantyRows.OrderBy(r => r.DaysRemaining).ToList();
    }

    private void BuildRepairAndObsoleteRows()
    {
        repairRows.Clear();
        foreach (var rep in allRepairs)
        {
            var dev = rep.Device ?? allDevices.FirstOrDefault(d => d.Id == rep.DeviceId);
            repairRows.Add(new RepairRow
            {
                AssetId = dev != null && !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : rep.DeviceId.Substring(0, Math.Min(8, rep.DeviceId.Length)),
                DeviceName = dev != null ? $"{dev.Brand} {dev.DeviceName}" : "Hardware Unit",
                Serial = dev?.Serial ?? "—",
                Vendor = !string.IsNullOrEmpty(rep.VendorName) ? rep.VendorName : "Authorized Service Partner",
                Issue = rep.IssueDescription,
                SentDate = !string.IsNullOrEmpty(rep.SentDate) ? rep.SentDate : "—",
                ReturnDate = !string.IsNullOrEmpty(rep.ActualReturnDate) ? rep.ActualReturnDate : rep.ExpectedReturnDate,
                Cost = rep.Cost ?? 0m,
                Status = rep.Status
            });
        }

        // Add any faulty devices currently in repair status
        foreach (var dev in allDevices.Where(d => (d.Status == DeviceStatus.Faulty || d.Status == DeviceStatus.InRepair) && !repairRows.Any(r => r.AssetId == d.AssetTag || r.AssetId == d.Id)))
        {
            repairRows.Add(new RepairRow
            {
                AssetId = !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : dev.Id.Substring(0, Math.Min(8, dev.Id.Length)),
                DeviceName = $"{dev.Brand} {dev.DeviceName}",
                Serial = dev.Serial ?? "—",
                Vendor = "IT Repair Center",
                Issue = !string.IsNullOrEmpty(dev.Note) ? dev.Note : "Hardware diagnostic check",
                SentDate = dev.ReceivedDate ?? "Recent",
                ReturnDate = "In progress",
                Cost = 0m,
                Status = "In Repair"
            });
        }

        obsoleteRows.Clear();
        foreach (var dev in allDevices.Where(d => d.Status == DeviceStatus.WrittenOff))
        {
            obsoleteRows.Add(new ObsoleteRow
            {
                AssetId = !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : dev.Id.Substring(0, Math.Min(8, dev.Id.Length)),
                ItemName = $"{dev.Brand} {dev.DeviceName}",
                Category = dev.Category,
                Serial = dev.Serial ?? "—",
                ScrapDate = dev.ReturnDate ?? dev.ReceivedDate ?? "Decommissioned",
                Reason = !string.IsNullOrEmpty(dev.Condition) ? dev.Condition : (!string.IsNullOrEmpty(dev.Note) ? dev.Note : "End of lifecycle"),
                OriginalCost = (double)(dev.AssetAmount ?? 0)
            });
        }
    }

    private void BuildMovementRows()
    {
        movementRows.Clear();
        foreach (var h in allHandovers)
        {
            var dev = h.Device ?? allDevices.FirstOrDefault(d => d.Id == h.DeviceId);
            string mType = !string.IsNullOrEmpty(h.ReturnDate) ? "Returned to Store" : "Staff Issue";
            string dateStr = !string.IsNullOrEmpty(h.Released) ? h.Released : "Recorded";

            movementRows.Add(new MovementRow
            {
                Date = dateStr,
                MovementType = mType,
                AssetId = dev != null && !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : h.DeviceId.Substring(0, Math.Min(8, h.DeviceId.Length)),
                ItemName = dev != null ? $"{dev.Brand} {dev.DeviceName}" : "Asset Device",
                Serial = dev?.Serial ?? "—",
                From = !string.IsNullOrEmpty(h.From) ? h.From : "IT Store Room",
                To = !string.IsNullOrEmpty(h.To) ? h.To : "Assigned Staff",
                Condition = !string.IsNullOrEmpty(h.Condition) ? h.Condition : "Operational"
            });
        }

        // Add repair records as movement items
        foreach (var rep in allRepairs)
        {
            var dev = rep.Device ?? allDevices.FirstOrDefault(d => d.Id == rep.DeviceId);
            movementRows.Add(new MovementRow
            {
                Date = !string.IsNullOrEmpty(rep.SentDate) ? rep.SentDate : "Recorded",
                MovementType = "Sent for Repair",
                AssetId = dev != null && !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : rep.DeviceId.Substring(0, Math.Min(8, rep.DeviceId.Length)),
                ItemName = dev != null ? $"{dev.Brand} {dev.DeviceName}" : "Hardware Unit",
                Serial = dev?.Serial ?? "—",
                From = "IT Department",
                To = !string.IsNullOrEmpty(rep.VendorName) ? rep.VendorName : "Repair Vendor",
                Condition = rep.IssueDescription
            });
        }

        movementRows = movementRows.OrderByDescending(m => m.Date).ToList();
    }

    private void BuildComponentRows()
    {
        componentRows.Clear();
        foreach (var dev in allDevices.Where(d => d.IsComponent || !IsSystem(d.Category)))
        {
            var parent = dev.ParentDevice ?? (dev.ParentDeviceId != null ? allDevices.FirstOrDefault(d => d.Id == dev.ParentDeviceId) : null);
            componentRows.Add(new ComponentRow
            {
                AssetId = !string.IsNullOrEmpty(dev.AssetTag) ? dev.AssetTag : dev.Id.Substring(0, Math.Min(8, dev.Id.Length)),
                ItemName = $"{dev.Brand} {dev.DeviceName}",
                Category = dev.Category,
                Serial = !string.IsNullOrEmpty(dev.Serial) ? dev.Serial : "—",
                IsInstalled = dev.ParentDeviceId != null,
                HostSystemName = parent != null ? (!string.IsNullOrEmpty(parent.AssetTag) ? $"{parent.AssetTag} ({parent.DeviceName})" : parent.DeviceName) : "Standalone Unit",
                Location = !string.IsNullOrEmpty(dev.Location) ? dev.Location : "Head Office",
                Condition = !string.IsNullOrEmpty(dev.Condition) ? dev.Condition : "Good",
                Status = dev.Status.ToString(),
                WarrantyStatus = GetWarrantyBadgeText(dev)
            });
        }
    }

    private string GetWarrantyBadgeText(Device dev)
    {
        if (!dev.HasWarranty || !dev.WarrantyEndDate.HasValue) return "No cover";
        var days = (dev.WarrantyEndDate.Value - DateTime.Now).TotalDays;
        if (days < 0) return $"Expired {(int)Math.Abs(days)}d";
        return $"{(int)days}d left";
    }

    private bool IsSystem(string category)
    {
        var sys = category?.ToLower() ?? "";
        return sys.Contains("laptop") || sys.Contains("desktop") || sys.Contains("server") || sys.Contains("macbook") || sys.Contains("mobile") || sys.Contains("phone") || sys.Contains("tablet");
    }

    private void SetReport(string type)
    {
        reportType = type;
    }

    private string GetReportTitle() => reportType switch
    {
        "summary" => "Inventory Summary",
        "held" => "Allocation Register",
        "warranty" => "Warranty Status Register",
        "repair" => "Repair & Obsolete Equipment",
        "movements" => "Movement Audit Trail",
        "components" => "Component & Peripheral Ledger",
        _ => "Management Report"
    };

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task OpenReportInNewTab()
    {
        await JSRuntime.InvokeVoidAsync("eval", @"
            var target = document.getElementById('report-print-target');
            if (target) {
                var w = window.open('', '_blank');
                w.document.write('<!DOCTYPE html><html><head><title>' + document.title + '</title>');
                w.document.write('<link rel=""stylesheet"" href=""/app.css"">');
                w.document.write('<style>body { padding: 24px; background: #fff; font-family: system-ui, sans-serif; } table { width:100%; border-collapse: collapse; } th, td { border: 1px solid #e2e8f0; padding: 6px 10px; font-size: 11px; }</style>');
                w.document.write('</head><body>' + target.outerHTML + '</body></html>');
                w.document.close();
            }
        ");
    }

    private async Task DownloadHtmlReport()
    {
        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html>");
        sb.AppendLine("<html lang=\"en\">");
        sb.AppendLine("<head>");
        sb.AppendLine($"<title>{GetReportTitle()} - PrimeTech Asset Manager</title>");
        sb.AppendLine("<meta charset=\"utf-8\">");
        sb.AppendLine("<style>");
        sb.AppendLine("body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f8fafc; color: #0f172a; margin: 0; padding: 24px; }");
        sb.AppendLine(".report-card { max-width: 1200px; margin: 0 auto; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; padding: 36px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }");
        sb.AppendLine(".grid-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin: 24px 0; }");
        sb.AppendLine(".stat-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; }");
        sb.AppendLine(".stat-val { font-size: 22px; font-weight: 700; color: #0f172a; margin: 4px 0; }");
        sb.AppendLine("table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 12px; }");
        sb.AppendLine("th { background: #f1f5f9; padding: 8px 12px; text-align: left; font-weight: 600; font-size: 11px; text-transform: uppercase; border-bottom: 2px solid #cbd5e1; }");
        sb.AppendLine("td { padding: 8px 12px; border-bottom: 1px solid #e2e8f0; }");
        sb.AppendLine(".badge { display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 10px; font-weight: 600; }");
        sb.AppendLine(".badge-green { background: #dcfce7; color: #15803d; }");
        sb.AppendLine(".badge-red { background: #fee2e2; color: #b91c1c; }");
        sb.AppendLine(".badge-gray { background: #f1f5f9; color: #475569; }");
        sb.AppendLine("</style>");
        sb.AppendLine("</head>");
        sb.AppendLine("<body>");
        sb.AppendLine("<div class=\"report-card\">");
        sb.AppendLine($"<h1>{GetReportTitle()}</h1>");
        sb.AppendLine($"<p>PrimeTech Solutions Ltd. — Generated on {DateTime.Now:dd MMM yyyy, hh:mm tt}</p>");
        sb.AppendLine("</div>");
        sb.AppendLine("</body>");
        sb.AppendLine("</html>");

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        using var stream = new MemoryStream(bytes);
        using var streamRef = new DotNetStreamReference(stream);
        string filename = $"report-{reportType}-{DateTime.Now:yyyyMMdd-HHmm}.html";
        await JSRuntime.InvokeVoidAsync("downloadFileFromStream", filename, streamRef);
    }

