                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Serial Number</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Host System / Status</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Location</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Condition</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap text-right">Warranty Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft align-middle">
                                        @if (componentRows.Any())
                                        {
                                            @foreach (var row in componentRows)
                                            {
                                                <tr class="hover:bg-canvas/50">
                                                    <td class="py-3 px-3 font-mono font-medium text-txt-hi whitespace-nowrap">@row.AssetId</td>
                                                    <td class="py-3 px-3 font-medium text-txt-hi whitespace-nowrap">@row.ItemName</td>
                                                    <td class="py-3 px-3 text-txt-mid whitespace-nowrap">@row.Category</td>
                                                    <td class="py-3 px-3 font-mono text-[11px] text-txt-mid whitespace-nowrap">@row.Serial</td>
                                                    <td class="py-3 px-3 whitespace-nowrap">
                                                        @if (row.IsInstalled)
                                                        {
                                                            <span class="inline-flex items-center gap-1.5 text-success-600 font-medium">
                                                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                                @row.HostSystemName
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center rounded-md bg-accent-soft px-2 py-0.5 text-[10px] font-medium text-accent-700">Spare in Store</span>
                                                        }
                                                    </td>
                                                    <td class="py-3 px-3 text-txt-mid whitespace-nowrap">@row.Location</td>
                                                    <td class="py-3 px-3 text-txt-mid whitespace-nowrap">@row.Condition</td>
                                                    <td class="py-3 px-3 text-right whitespace-nowrap">
                                                        @if (row.WarrantyStatus == "No cover")
                                                        {
                                                            <span class="inline-flex items-center rounded-md bg-elevated px-2 py-0.5 text-[10px] font-medium text-txt-mid">No cover</span>
                                                        }
                                                        else if (row.WarrantyStatus.StartsWith("Expired"))
                                                        {
                                                            <span class="inline-flex items-center rounded-md bg-danger-soft px-2 py-0.5 text-[10px] font-medium text-danger-600">@row.WarrantyStatus</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center rounded-md bg-success-soft px-2 py-0.5 text-[10px] font-medium text-success-600">@row.WarrantyStatus</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="8" class="py-8 text-center text-txt-mid">No component or peripheral assets tracked yet.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
</div>

<style>
