@page "/reports"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = AssetManagement.Core.Security.Permissions.Reports.View)]
@using System.IO
@using System.Text
@using AssetManagement.Core.Entities
@using AssetManagement.Core.Enums
@using AssetManagement.Infrastructure.Services
@inject DeviceService DeviceService
@inject HandoverService HandoverService
@inject EmployeeService EmployeeService
@inject RepairService RepairService
@inject IJSRuntime JSRuntime

<PageTitle>Management reports - PrimeTech Asset Manager</PageTitle>

<PageHeader Title="Management reports">
    <Actions>
        <button type="button" @onclick="DownloadHtmlReport" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-txt-hi transition-colors duration-150 hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 border border-line-soft bg-surface cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            Download HTML
        </button>
        <button type="button" @onclick="OpenReportInNewTab" class="inline-flex items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-txt-hi transition-colors duration-150 hover:bg-elevated focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 border border-line-soft bg-surface cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
            Open in new tab
        </button>
        <button type="button" @onclick="PrintReport" class="inline-flex items-center justify-center gap-2 rounded-lg bg-accent-500 px-4 py-2 text-sm font-semibold text-accent-on shadow-sm transition-colors duration-150 hover:bg-accent-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>
            Print / Save PDF
        </button>
    </Actions>
</PageHeader>

<div class="grid gap-6 px-6 py-6 lg:grid-cols-[20rem_minmax(0,1fr)] lg:px-9 h-[calc(100vh-8.5rem)]">
    <!-- Sidebar -->
    <div class="no-print overflow-y-auto pr-2 pb-10 custom-scrollbar">
        <h2 class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">
            Report
        </h2>
        <ul class="mt-3 space-y-2">
            <li>
                <button type="button" @onclick='() => SetReport("summary")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "summary" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Inventory summary</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">Management Review</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Headline counts, capital value and stock position across systems, components and peripherals.</span>
                </button>
            </li>
            <li>
                <button type="button" @onclick='() => SetReport("held")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "held" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Allocation register</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">Audit / HR Handover</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Who holds which asset, with employee ID, designation, issue date and serial numbers.</span>
                </button>
            </li>
            <li>
                <button type="button" @onclick='() => SetReport("warranty")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "warranty" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Warranty status</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">Procurement Planning</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Warranty position of every asset, expiring items first, with end dates and days remaining.</span>
                </button>
            </li>
            <li>
                <button type="button" @onclick='() => SetReport("repair")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "repair" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Repair & obsolete</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">Cost Control</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Current repair queue, repair outcomes and every asset written off with reasons and cost.</span>
                </button>
            </li>
            <li>
                <button type="button" @onclick='() => SetReport("movements")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "movements" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Movement audit trail</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">Internal Audit</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Every in, out, return, repair, install and write-off movement for the selected period.</span>
                </button>
            </li>
            <li>
                <button type="button" @onclick='() => SetReport("components")' class="w-full rounded-2xl border p-4 text-left transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 @(reportType == "components" ? "border-accent-border bg-accent-soft" : "border-line-soft bg-surface hover:border-line")">
                    <span class="flex items-baseline justify-between gap-3">
                        <span class="text-sm font-semibold text-txt-hi">Component & peripheral ledger</span>
                        <span class="text-[10px] font-medium uppercase tracking-widest text-txt-lo">IT Asset Control</span>
                    </span>
                    <span class="mt-1.5 block text-[13px] leading-relaxed text-txt-mid">Each RAM, drive, power supply, mouse, keyboard, headset and licence with its host system and warranty.</span>
                </button>
            </li>
        </ul>
    </div>

    <!-- Preview Pane -->
    <section aria-label="Preview" class="min-w-0 flex flex-col overflow-hidden h-full">
        <div class="no-print flex flex-wrap items-baseline justify-between gap-3 mb-2">
            <h2 class="text-[11px] font-medium uppercase tracking-widest text-txt-lo">
                Preview — @GetReportTitle()
            </h2>
            <p class="text-xs text-txt-lo">
                Standalone HTML · print-ready A4 landscape
            </p>
        </div>
        
        <!-- A4 Page Container (Landscape proportions for wide tables) -->
        <div class="mt-1 flex-1 overflow-y-auto bg-surface-soft p-4 md:p-6 custom-scrollbar print:p-0 print:overflow-visible">
            <div id="report-print-target" class="mx-auto w-full max-w-[297mm] min-h-[210mm] bg-surface rounded-2xl shadow-sm border border-line-soft p-8 lg:p-12 print:shadow-none print:border-none print:m-0 print:w-full print:p-0">
                
                <!-- Report Header -->
                <div class="flex items-start justify-between border-b border-line pb-6 mb-8">
                    <div class="flex h-12 shrink-0 items-center">
                        <img src="/assets/Blacklogo.png?v=5" class="h-full object-contain" alt="PrimeTech Solutions Ltd. Logo" />
                    </div>
                    <div class="text-right">
                        <p class="text-xs text-txt-mid">Report generated</p>
                        <p class="text-sm font-medium text-txt-hi">@DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")</p>
                        <p class="text-[10px] font-medium uppercase tracking-wider text-txt-lo mt-0.5">PrimeTech Asset Management System</p>
                    </div>
                </div>

                @if (reportType == "summary")
                {
                    <div>
                        <h2 class="text-2xl font-bold text-txt-hi tracking-tight">Inventory summary</h2>
                        <p class="mt-2 text-sm text-txt-mid">Headline position of every tracked system, component and peripheral across the organization.</p>
                        <p class="text-xs italic text-txt-lo mt-1 mb-8">Prepared by IT Operations — Confidential — for executive management review</p>

                        <!-- Top Stats -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Assets in circulation</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@totalAssetsCount</p>
                                <p class="mt-1 text-xs text-txt-mid">@(totalAssetsCount + obsoleteCount) on record incl. written off</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Capital value at cost</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">BDT @totalCapitalValue.ToString("N0")</p>
                                <p class="mt-1 text-xs text-txt-mid">Excludes obsolete assets</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Issued to staff</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@issuedAssetsCount</p>
                                <p class="mt-1 text-xs text-txt-mid">@inStockAssetsCount available in reserve stock</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Needs attention</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@(inRepairCount + warrantyExpiringCount)</p>
                                <p class="mt-1 text-xs text-txt-mid">@inRepairCount in repair · @warrantyExpiringCount expiring warranty</p>
                            </div>
                        </div>

                        <!-- Data Table 1: Status Position -->
                        <div class="mb-10">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-txt-hi mb-4 border-b border-line pb-2">Position by operational status</h3>
                            <div class="overflow-x-auto w-full rounded-xl border border-line-soft custom-scrollbar">
                                <table class="w-full text-xs text-left min-w-[600px]">
                                    <thead>
                                        <tr class="text-[11px] uppercase tracking-widest text-txt-mid bg-canvas border-b border-line">
                                            <th class="py-2.5 px-4 font-semibold">Status</th>
                                            <th class="py-2.5 px-4 font-semibold">Items</th>
                                            <th class="py-2.5 px-4 font-semibold">Share of Fleet</th>
                                            <th class="py-2.5 px-4 font-semibold text-right">Value at Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft">
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-success-500"></span>
                                                Issued &amp; Active
                                            </td>
                                            <td class="py-3 px-4">@issuedAssetsCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (issuedAssetsCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @issuedValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-accent-500"></span>
                                                In Reserve Inventory
                                            </td>
                                            <td class="py-3 px-4">@inStockAssetsCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (inStockAssetsCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @inStockValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-primary-500"></span>
                                                Installed Components
                                            </td>
                                            <td class="py-3 px-4">@installedCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (installedCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @installedValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-warning-500"></span>
                                                Repair Shop / Faulty
                                            </td>
                                            <td class="py-3 px-4">@inRepairCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (inRepairCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @inRepairValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi flex items-center gap-2">
                                                <span class="w-2 h-2 rounded-full bg-danger-500"></span>
                                                Obsolete / Written-Off
                                            </td>
                                            <td class="py-3 px-4">@obsoleteCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (obsoleteCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @obsoleteValue.ToString("N0")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Data Table 2: Asset Kind -->
                        <div class="mb-10">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-txt-hi mb-4 border-b border-line pb-2">Position by asset classification</h3>
                            <div class="overflow-x-auto w-full rounded-xl border border-line-soft custom-scrollbar">
                                <table class="w-full text-xs text-left min-w-[600px]">
                                    <thead>
                                        <tr class="text-[11px] uppercase tracking-widest text-txt-mid bg-canvas border-b border-line">
                                            <th class="py-2.5 px-4 font-semibold">Classification</th>
                                            <th class="py-2.5 px-4 font-semibold">Total Units</th>
                                            <th class="py-2.5 px-4 font-semibold">Share of Assets</th>
                                            <th class="py-2.5 px-4 font-semibold text-right">Value at Cost</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft">
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi">Complete Systems (Laptops, Desktops, Servers)</td>
                                            <td class="py-3 px-4">@systemCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (systemCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @systemValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi">Hardware Components (RAM, Storage, Parts)</td>
                                            <td class="py-3 px-4">@componentCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (componentCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @componentValue.ToString("N0")</td>
                                        </tr>
                                        <tr class="hover:bg-canvas/50">
                                            <td class="py-3 px-4 font-medium text-txt-hi">Peripherals &amp; Accessories (Displays, Keyboards, Mice)</td>
                                            <td class="py-3 px-4">@peripheralCount</td>
                                            <td class="py-3 px-4 text-txt-mid">@(totalAssetsCount > 0 ? (peripheralCount * 100 / totalAssetsCount) : 0)%</td>
                                            <td class="py-3 px-4 text-right font-mono">BDT @peripheralValue.ToString("N0")</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Data Table 3: Department Breakdown -->
                        <div class="mb-10">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-txt-hi mb-4 border-b border-line pb-2">Department deployment summary</h3>
                            <div class="overflow-x-auto w-full rounded-xl border border-line-soft custom-scrollbar">
                                <table class="w-full text-xs text-left min-w-[600px]">
                                    <thead>
                                        <tr class="text-[11px] uppercase tracking-widest text-txt-mid bg-canvas border-b border-line">
                                            <th class="py-2.5 px-4 font-semibold">Department</th>
                                            <th class="py-2.5 px-4 font-semibold">Assigned Staff</th>
                                            <th class="py-2.5 px-4 font-semibold">Hardware Count</th>
                                            <th class="py-2.5 px-4 font-semibold text-right">Estimated Capital</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft">
                                        @foreach (var dept in departmentSummaryRows)
                                        {
                                            <tr class="hover:bg-canvas/50">
                                                <td class="py-3 px-4 font-medium text-txt-hi">@dept.DepartmentName</td>
                                                <td class="py-3 px-4">@dept.StaffCount</td>
                                                <td class="py-3 px-4">@dept.AssetCount</td>
                                                <td class="py-3 px-4 text-right font-mono">BDT @dept.TotalValue.ToString("N0")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else if (reportType == "held")
                {
                    <div>
                        <h2 class="text-2xl font-bold text-txt-hi tracking-tight">Allocation register</h2>
                        <p class="mt-2 text-sm text-txt-mid">Every asset currently issued to personnel, with designations, serial numbers and warranty coverage.</p>
                        <p class="text-xs italic text-txt-lo mt-1 mb-8">Prepared by IT Operations — Confidential — for HR and internal audit review</p>

                        <!-- Top Stats -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Assets issued</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@issuedAssetsCount</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Staff holding assets</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@allocationRows.Select(r => r.EmployeeName).Distinct().Count()</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Available in stock</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">@inStockAssetsCount</p>
                            </div>
                            <div class="rounded-xl border border-line bg-canvas p-4">
                                <h3 class="text-[10px] font-medium uppercase tracking-widest text-txt-mid">Value issued at cost</h3>
                                <p class="mt-2 text-2xl font-semibold text-txt-hi">BDT @issuedValue.ToString("N0")</p>
                            </div>
                        </div>

                        <!-- Data Table with Horizontal Scroll Support -->
                        <div class="mb-10">
                            <h3 class="text-xs font-bold uppercase tracking-widest text-txt-hi mb-4 border-b border-line pb-2">Active personnel allocation register</h3>
                            <div class="overflow-x-auto w-full rounded-xl border border-line-soft custom-scrollbar">
                                <table class="w-full text-xs text-left min-w-[950px]">
                                    <thead>
                                        <tr class="text-[11px] uppercase tracking-widest text-txt-mid bg-canvas border-b border-line">
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Employee</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">ID</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Designation</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Asset ID</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Item &amp; Model</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Serial</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Classification</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Specification</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap">Issued On</th>
                                            <th class="py-2.5 px-3 font-semibold whitespace-nowrap text-right">Warranty</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-line-soft align-middle">
                                        @foreach (var row in allocationRows)
                                        {
                                            <tr class="hover:bg-canvas/50">
                                                <td class="py-3 px-3 font-semibold text-txt-hi whitespace-nowrap">@row.EmployeeName</td>
                                                <td class="py-3 px-3 text-txt-mid font-mono text-[11px] whitespace-nowrap">@row.EmployeeId</td>
                                                <td class="py-3 px-3 text-txt-mid whitespace-nowrap">@row.Designation</td>
                                                <td class="py-3 px-3 font-mono font-medium text-txt-hi whitespace-nowrap">@row.AssetId</td>
                                                <td class="py-3 px-3 font-medium text-txt-hi whitespace-nowrap">@row.ItemName</td>
                                                <td class="py-3 px-3 font-mono text-[11px] text-txt-mid whitespace-nowrap">@row.Serial</td>
                                                <td class="py-3 px-3 text-txt-mid whitespace-nowrap">@row.Type</td>
                                                <td class="py-3 px-3 text-txt-mid whitespace-nowrap max-w-[200px] truncate" title="@row.Specification">@row.Specification</td>
