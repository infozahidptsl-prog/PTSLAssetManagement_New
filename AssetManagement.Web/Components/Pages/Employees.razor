@code {
    private List<Employee> allEmployees = new();
    private List<Device> allDevices = new();
    
    private class EmployeeAssets
    {
        public int Systems { get; set; }
        public int Components { get; set; }
        public int Peripherals { get; set; }
        public int Total => Systems + Components + Peripherals;
    }
    private Dictionary<string, EmployeeAssets> employeeAssets = new();
    
    [SupplyParameterFromQuery(Name = "search")]
    public string? Search { get; set; }

    private string searchTerm = "";
    private string selectedDepartment = "";
    private string selectedLocation = "";
    private string employeeStatusFilter = "Active";
    private string assetCustodyFilter = "All";
    private string activeCardFilter = "All";
    private string sortSelection = "name-asc";

    private string SortSelection
    {
        get => sortSelection;
        set
        {
            sortSelection = value;
            switch (value)
            {
                case "name-asc": SortColumn = "Employee"; SortAscending = true; break;
                case "name-desc": SortColumn = "Employee"; SortAscending = false; break;
                case "assets-desc": SortColumn = "Assets"; SortAscending = false; break;
                case "assets-asc": SortColumn = "Assets"; SortAscending = true; break;
                case "systems-desc": SortColumn = "Systems"; SortAscending = false; break;
                case "empid-asc": SortColumn = "EmployeeId"; SortAscending = true; break;
                case "dept-asc": SortColumn = "Department"; SortAscending = true; break;
            }
        }
    }

    protected override void OnParametersSet()
    {
        if (searchTerm != (Search ?? ""))
        {
            searchTerm = Search ?? "";
        }
    }

    // Modal state
    private bool showAddEditModal = false;
    private bool isEdit = false;
    private Employee editModel = new();
    private bool showDeleteModal = false;
    private Employee? deleteTarget = null;

    private string SortColumn { get; set; } = "Employee";
    private bool SortAscending { get; set; } = true;

    private void SortBy(string column)
    {
        if (SortColumn == column)
        {
            SortAscending = !SortAscending;
        }
        else
        {
            SortColumn = column;
            SortAscending = (column != "Assets" && column != "Systems");
        }

        sortSelection = SortColumn switch
        {
            "Employee" => SortAscending ? "name-asc" : "name-desc",
            "Assets" => SortAscending ? "assets-asc" : "assets-desc",
            "Systems" => "systems-desc",
            "EmployeeId" => "empid-asc",
            "Department" => "dept-asc",
            _ => "name-asc"
        };
    }

    private void ToggleSortMostAssets()
    {
        activeCardFilter = "All";
        SortColumn = "Assets";
        SortAscending = false;
        sortSelection = "assets-desc";
    }

    private RenderFragment RenderSortIcon(string column) => __builder =>
    {
        if (SortColumn == column)
        {
            if (SortAscending)
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m5 15 7-7 7 7"/></svg>
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m19 9-7 7-7-7"/></svg>
            }
        }
        else
        {
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-line-strong opacity-40 group-hover:opacity-100 transition-opacity"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
        }
    };

    private int totalEmployeesCount => allEmployees.Count(e => e.IsActive && !e.IsTeamAccount);
    private int activeEmployeesCount => allEmployees.Count(e => e.IsActive && !e.IsTeamAccount);
    private int totalTeamsCount => allEmployees.Count(e => e.IsTeamAccount);
    private int employeesWithAssetsCount => allEmployees.Count(e => e.IsActive && !e.IsTeamAccount && employeeAssets.TryGetValue(e.Id, out var a) && a.Total > 0);
    private int employeesWithoutAssetsCount => allEmployees.Count(e => e.IsActive && !e.IsTeamAccount && (!employeeAssets.TryGetValue(e.Id, out var a) || a.Total == 0));
    private int totalAssignedEquipmentCount => employeeAssets.Values.Sum(a => a.Total);
    private int totalAssignedSystemsCount => employeeAssets.Values.Sum(a => a.Systems);
    private int totalAssignedPeripheralsCount => employeeAssets.Values.Sum(a => a.Peripherals);

    private List<string> availableDepartments => allEmployees
        .Where(e => !string.IsNullOrWhiteSpace(e.Department))
        .Select(e => e.Department!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(d => d)
        .ToList();

    private List<string> availableLocations => allEmployees
        .Where(e => !string.IsNullOrWhiteSpace(e.Location))
        .Select(e => e.Location!.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(l => l)
        .ToList();

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrEmpty(selectedDepartment) ||
        !string.IsNullOrEmpty(selectedLocation) ||
        employeeStatusFilter != "Active" ||
        assetCustodyFilter != "All" ||
        activeCardFilter != "All";

    private void ClearFilters()
    {
        searchTerm = "";
        selectedDepartment = "";
        selectedLocation = "";
        employeeStatusFilter = "Active";
        assetCustodyFilter = "All";
        activeCardFilter = "All";
    }

    private void SetCardFilter(string filter)
    {
        if (activeCardFilter == filter)
        {
            activeCardFilter = "All";
        }
        else
        {
            activeCardFilter = filter;
            if (filter == "Teams")
            {
                employeeStatusFilter = "Teams";
            }
            else if (employeeStatusFilter == "Teams")
            {
                employeeStatusFilter = "Active";
            }
        }
    }

    private void SetPillFilter(string pill)
    {
        if (pill == "All")
        {
            activeCardFilter = "All";
            assetCustodyFilter = "All";
            employeeStatusFilter = "Active";
        }
        else if (pill == "WithAssets")
        {
            activeCardFilter = "WithAssets";
            assetCustodyFilter = "WithAssets";
            employeeStatusFilter = "Active";
        }
        else if (pill == "WithoutAssets")
        {
            activeCardFilter = "WithoutAssets";
            assetCustodyFilter = "WithoutAssets";
            employeeStatusFilter = "Active";
        }
        else if (pill == "Systems")
        {
            activeCardFilter = "All";
            assetCustodyFilter = "Systems";
            employeeStatusFilter = "Active";
        }
        else if (pill == "Peripherals")
        {
            activeCardFilter = "All";
            assetCustodyFilter = "Peripherals";
            employeeStatusFilter = "Active";
        }
        else if (pill == "Teams")
        {
            activeCardFilter = "Teams";
            assetCustodyFilter = "All";
            employeeStatusFilter = "Teams";
        }
    }

    private List<Employee> filteredEmployees
    {
        get
        {
            var q = allEmployees.AsEnumerable();

            // Status filter
            if (activeCardFilter == "Teams" || employeeStatusFilter == "Teams")
            {
                q = q.Where(e => e.IsTeamAccount);
            }
            else if (employeeStatusFilter == "Active")
            {
                q = q.Where(e => e.IsActive && !e.IsTeamAccount);
            }
            else if (employeeStatusFilter == "Inactive")
            {
                q = q.Where(e => !e.IsActive && !e.IsTeamAccount);
            }
            else if (employeeStatusFilter == "All")
            {
                q = q.Where(e => !e.IsTeamAccount);
            }

            // Card filter
            if (activeCardFilter == "WithAssets")
            {
                q = q.Where(e => employeeAssets.TryGetValue(e.Id, out var a) && a.Total > 0);
            }
            else if (activeCardFilter == "WithoutAssets")
            {
                q = q.Where(e => !employeeAssets.TryGetValue(e.Id, out var a) || a.Total == 0);
            }

            // Custody filter
            if (assetCustodyFilter == "WithAssets")
            {
                q = q.Where(e => employeeAssets.TryGetValue(e.Id, out var a) && a.Total > 0);
            }
            else if (assetCustodyFilter == "WithoutAssets")
            {
                q = q.Where(e => !employeeAssets.TryGetValue(e.Id, out var a) || a.Total == 0);
            }
            else if (assetCustodyFilter == "Systems")
            {
                q = q.Where(e => employeeAssets.TryGetValue(e.Id, out var a) && a.Systems > 0);
            }
            else if (assetCustodyFilter == "Peripherals")
            {
                q = q.Where(e => employeeAssets.TryGetValue(e.Id, out var a) && a.Peripherals > 0);
            }

            // Department filter
            if (!string.IsNullOrWhiteSpace(selectedDepartment))
            {
                q = q.Where(e => string.Equals(e.Department?.Trim(), selectedDepartment.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            // Location filter
            if (!string.IsNullOrWhiteSpace(selectedLocation))
            {
                q = q.Where(e => string.Equals(e.Location?.Trim(), selectedLocation.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            // Search text
            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim();
                q = q.Where(e =>
                    e.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (e.EmployeeId != null && e.EmployeeId.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.Designation != null && e.Designation.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.Department != null && e.Department.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.Location != null && e.Location.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.Email != null && e.Email.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }

            return (SortColumn switch
            {
                "Employee" => SortAscending ? q.OrderBy(e => e.Name) : q.OrderByDescending(e => e.Name),
                "Email" => SortAscending ? q.OrderBy(e => e.Email ?? string.Empty) : q.OrderByDescending(e => e.Email ?? string.Empty),
                "Department" => SortAscending ? q.OrderBy(e => e.Department ?? string.Empty) : q.OrderByDescending(e => e.Department ?? string.Empty),
                "EmployeeId" => SortAscending ? q.OrderBy(e => e.EmployeeId ?? e.Id) : q.OrderByDescending(e => e.EmployeeId ?? e.Id),
                "Systems" => SortAscending 
                    ? q.OrderBy(e => employeeAssets.GetValueOrDefault(e.Id, new EmployeeAssets()).Systems) 
                    : q.OrderByDescending(e => employeeAssets.GetValueOrDefault(e.Id, new EmployeeAssets()).Systems),
                "Assets" => SortAscending 
                    ? q.OrderBy(e => employeeAssets.GetValueOrDefault(e.Id, new EmployeeAssets()).Total) 
                    : q.OrderByDescending(e => employeeAssets.GetValueOrDefault(e.Id, new EmployeeAssets()).Total),
                _ => q.OrderBy(e => e.Name)
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        allDevices = await DeviceService.GetDevicesAsync();
        allEmployees = await EmployeeService.GetEmployeesAsync(false);
        var activeEmployees = await EmployeeService.GetEmployeesAsync(true);
        allEmployees.AddRange(activeEmployees);
        allEmployees = allEmployees.GroupBy(e => e.Id).Select(g => g.First()).ToList();

        ComputeEmployeeAssets();
    }

    private void ComputeEmployeeAssets()
    {
        employeeAssets.Clear();
        foreach (var device in allDevices)
        {
            if (device.Status != AssetManagement.Core.Enums.DeviceStatus.InUse) continue;
            if (string.IsNullOrEmpty(device.UserName) && string.IsNullOrEmpty(device.EmployeeId)) continue;
            
            var emp = allEmployees.FirstOrDefault(e => 
                (!string.IsNullOrEmpty(device.EmployeeId) && string.Equals(e.EmployeeId, device.EmployeeId, StringComparison.OrdinalIgnoreCase)) || 
                (!string.IsNullOrEmpty(device.UserName) && string.Equals(e.Name, device.UserName, StringComparison.OrdinalIgnoreCase))
            );
            if (emp == null) continue;

            var key = emp.Id;
            
            if (!employeeAssets.ContainsKey(key))
            {
                employeeAssets[key] = new EmployeeAssets();
            }
            
            if (device.IsComponent)
            {
                employeeAssets[key].Components++;
            }
            else
            {
                var type = CategoryTypeRegistry.GetType(device.Category);
                if (string.Equals(type, "System", StringComparison.OrdinalIgnoreCase))
                {
                    employeeAssets[key].Systems++;
                }
                else if (string.Equals(type, "Component", StringComparison.OrdinalIgnoreCase))
                {
                    employeeAssets[key].Components++;
                }
                else
                {
                    employeeAssets[key].Peripherals++;
                }
            }
        }
    }

    private async Task OpenAddModal()
    {
        var nextId = await EmployeeService.GetNextEmployeeIdAsync();
        editModel = new Employee { EmployeeId = nextId, IsActive = true, Department = "Engineering", JoiningDate = null, About = "" };
        isEdit = false;
        showAddEditModal = true;
    }

    private void OpenEditModal(Employee emp)
    {
        editModel = new Employee
        {
            Id = emp.Id,
            Name = emp.Name,
            EmployeeId = emp.EmployeeId,
            Email = emp.Email,
            Contact = emp.Contact,
            Designation = emp.Designation,
            Department = emp.Department,
            JoiningDate = emp.JoiningDate.HasValue && emp.JoiningDate.Value.Year > 1900 ? emp.JoiningDate : null,
            IsActive = emp.IsActive,
            IsTeamAccount = emp.IsTeamAccount,
            Location = emp.Location,
            Team = emp.Team,
            Manager = emp.Manager,
            BloodGroup = emp.BloodGroup,
            ProfileImageUrl = emp.ProfileImageUrl,
            LinkedInUrl = emp.LinkedInUrl,
            About = emp.About
        };
        isEdit = true;
        showAddEditModal = true;
    }

    private void CloseModal() => showAddEditModal = false;

    private async Task SaveEmployee(Employee model)
    {
        try
        {
            if (model.JoiningDate.HasValue && model.JoiningDate.Value.Year <= 1900)
            {
                model.JoiningDate = null;
            }

            if (isEdit)
            {
                await EmployeeService.UpdateEmployeeAsync(model);
                Notifications.ShowSuccess("Staff details updated successfully.");
            }
            else
            {
                await EmployeeService.AddEmployeeAsync(model);
                Notifications.ShowSuccess($"Staff member '{model.Name}' added successfully.");
            }
            showAddEditModal = false;
            await RefreshData();
        }
        catch (Exception ex)
        {
            Notifications.ShowError($"Failed to save employee: {ex.Message}");
        }
    }

    private void OpenDeleteModal(Employee emp)
    {
        deleteTarget = emp;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        deleteTarget = null;
    }

    private async Task ConfirmDelete()
    {
        if (deleteTarget == null) return;
        
        var name = deleteTarget.Name;
        var result = await EmployeeService.DeleteEmployeeAsync(deleteTarget.Id);
        if (result)
        {
            Notifications.ShowSuccess($"'{name}' has been deleted.");
        }
        else
        {
            Notifications.ShowError("Could not delete this record. Check if devices are still assigned.");
        }
        CloseDeleteModal();
        await RefreshData();
    }

    private List<Device> GetHeldAssets(Employee emp)
    {
        return allDevices.Where(d =>
            d.Status == AssetManagement.Core.Enums.DeviceStatus.InUse &&
            ((!string.IsNullOrEmpty(emp.EmployeeId) && d.EmployeeId == emp.EmployeeId) ||
             (!string.IsNullOrEmpty(emp.Name) && d.UserName == emp.Name))
        ).ToList();
    }

    private async Task RefreshData()
    {
        allDevices = await DeviceService.GetDevicesAsync();
        allEmployees = await EmployeeService.GetEmployeesAsync(false);
        var inactive = await EmployeeService.GetEmployeesAsync(true);
        allEmployees.AddRange(inactive);
        allEmployees = allEmployees.GroupBy(e => e.Id).Select(g => g.First()).ToList();
        ComputeEmployeeAssets();
    }

    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "??";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList();
        
        var prefixesToRemove = new[] { "md.", "md", "mohammad", "mohammed", "mr.", "mrs.", "ms.", "syed" };
        while (parts.Count > 1 && prefixesToRemove.Contains(parts[0].ToLowerInvariant()))
        {
            parts.RemoveAt(0);
        }

        if (parts.Count == 0) return "??";
        if (parts.Count == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private void NavigateToEmployee(string id)
    {
        Navigation.NavigateTo($"/employee/{id}");
    }

    private async Task ExportToExcel()
    {
        var itemsToExport = filteredEmployees;

        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Employees vs Assets");
        worksheet.TabColor = XLColor.FromHtml("#059669");

        var headers = new[]
        {
            "SL",
            "Employee Name",
            "Employee ID",
            "Designation",
            "Department",
            "Office Location",
            "Official Email",
            "Status",
            "Account Type",
            "Total Assets",
            "Systems Count",
            "Components Count",
            "Peripherals Count",
            "Assigned Asset IDs"
        };

        for (int col = 0; col < headers.Length; col++)
        {
            var cell = worksheet.Cell(1, col + 1);
            cell.Value = headers[col];
            cell.Style.Font.Bold = true;
            cell.Style.Font.FontColor = XLColor.White;
            cell.Style.Fill.BackgroundColor = XLColor.FromHtml("#1E293B");
            cell.Style.Alignment.Horizontal = XLAlignmentHorizontalValues.Center;
            cell.Style.Alignment.Vertical = XLAlignmentVerticalValues.Center;
        }
        worksheet.Row(1).Height = 26;

        int row = 2;
        int sl = 1;
        foreach (var emp in itemsToExport)
        {
            employeeAssets.TryGetValue(emp.Id, out var counts);
            counts ??= new EmployeeAssets();

            var heldAssets = GetHeldAssets(emp);
            var assetTags = heldAssets.Select(a => !string.IsNullOrEmpty(a.AssetTag) ? a.AssetTag : a.Id);
            var assetTagsJoined = string.Join(", ", assetTags);

            worksheet.Cell(row, 1).SetValue(sl++);
            worksheet.Cell(row, 2).SetValue(emp.Name);
            worksheet.Cell(row, 3).SetValue(emp.EmployeeId ?? "-");
            worksheet.Cell(row, 4).SetValue(emp.Designation ?? "-");
            worksheet.Cell(row, 5).SetValue(emp.Department ?? "-");
            worksheet.Cell(row, 6).SetValue(emp.Location ?? "-");
            worksheet.Cell(row, 7).SetValue(emp.Email ?? "-");
            worksheet.Cell(row, 8).SetValue(emp.IsActive ? "Active" : "Inactive");
            worksheet.Cell(row, 9).SetValue(emp.IsTeamAccount ? "Team Account" : "Individual");
            worksheet.Cell(row, 10).SetValue(counts.Total);
            worksheet.Cell(row, 11).SetValue(counts.Systems);
            worksheet.Cell(row, 12).SetValue(counts.Components);
            worksheet.Cell(row, 13).SetValue(counts.Peripherals);
            worksheet.Cell(row, 14).SetValue(string.IsNullOrEmpty(assetTagsJoined) ? "-" : assetTagsJoined);

            var rowRange = worksheet.Range(row, 1, row, headers.Length);
            if (row % 2 == 1)
            {
                rowRange.Style.Fill.BackgroundColor = XLColor.FromHtml("#F8FAFC");
            }
            rowRange.Style.Border.OutsideBorder = XLBorderStyleValues.Thin;
            rowRange.Style.Border.OutsideBorderColor = XLColor.FromHtml("#E2E8F0");
            rowRange.Style.Border.InsideBorder = XLBorderStyleValues.Thin;
            rowRange.Style.Border.InsideBorderColor = XLColor.FromHtml("#E2E8F0");

            row++;
        }

        worksheet.RangeUsed()?.SetAutoFilter();
        worksheet.SheetView.FreezeRows(1);
        worksheet.Columns().AdjustToContents();

        using var memoryStream = new MemoryStream();
        workbook.SaveAs(memoryStream);
        memoryStream.Position = 0;

        using var streamRef = new DotNetStreamReference(stream: memoryStream);
        var filename = $"PrimeTech_Employees_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
        await JS.InvokeVoidAsync("downloadFileFromStream", filename, streamRef);
    }
}
