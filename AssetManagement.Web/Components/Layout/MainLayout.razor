@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="flex min-h-screen w-full bg-surface text-txt-hi">
    <NavMenu @bind-IsCollapsed="isSidebarCollapsed" @bind-IsMobileOpen="isMobileMenuOpen" />

    <div class="flex min-w-0 flex-1 flex-col">
        <header class="no-print sticky top-0 z-20 flex h-14 items-center gap-3 border-b border-line-soft bg-surface px-4 lg:pl-5 lg:pr-9">

            <button type="button" @onclick="ToggleDesktopSidebar" class="hidden lg:flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line-soft bg-canvas text-txt-mid transition-colors hover:bg-elevated hover:text-txt-hi" title="Toggle Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" x2="21" y1="6" y2="6"/>
                    <line x1="3" x2="21" y1="12" y2="12"/>
                    <line x1="3" x2="21" y1="18" y2="18"/>
                </svg>
            </button>
            <button type="button" @onclick="ToggleMobileMenu" class="flex lg:hidden h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-line-soft bg-canvas text-txt-mid transition-colors hover:bg-elevated hover:text-txt-hi" title="Toggle Mobile Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" x2="21" y1="6" y2="6"/>
                    <line x1="3" x2="21" y1="12" y2="12"/>
                    <line x1="3" x2="21" y1="18" y2="18"/>
                </svg>
            </button>

            <form class="relative max-w-md flex-1" @onsubmit:preventDefault="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-txt-lo"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" @bind="GlobalSearchTerm" @bind:event="oninput" placeholder="Search device, serial, employee ID, mail..." aria-label="Search the register" class="w-full rounded-lg border border-line bg-elevated py-2 pl-9 pr-3 text-sm text-txt-hi placeholder:text-txt-lo transition-colors duration-150 hover:border-line-strong focus:border-accent-border focus:outline-none focus-visible:ring-2 focus-visible:ring-accent-500" />
            </form>

            <div class="ml-auto flex items-center gap-2">
                <!-- Theme toggle removed to enforce light mode exclusively -->
            </div>
        </header>

        <main class="min-w-0 flex-1 flex flex-col p-6 lg:p-8">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet class="hidden">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">ðŸ—™</span>
</div>

@code {
    private bool isSidebarCollapsed = false;
    private bool isMobileMenuOpen = false;
    private string globalSearchTerm = "";
    private System.Timers.Timer? searchDebounceTimer;

    public string GlobalSearchTerm
    {
        get => globalSearchTerm;
        set
        {
            if (globalSearchTerm != value)
            {
                globalSearchTerm = value;
                
                if (searchDebounceTimer != null)
                {
                    searchDebounceTimer.Stop();
                    searchDebounceTimer.Start();
                }
                else
                {
                    searchDebounceTimer = new System.Timers.Timer(400);
                    searchDebounceTimer.AutoReset = false;
                    searchDebounceTimer.Elapsed += (s, e) =>
                    {
                        InvokeAsync(PerformGlobalSearch);
                    };
                    searchDebounceTimer.Start();
                }
            }
        }
    }

    private void ToggleDesktopSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void PerformGlobalSearch()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var path = uri.AbsolutePath.ToLowerInvariant();
        
        string targetPath;
        if (path == "/devices" || path == "/inventory-out")
        {
            targetPath = path;
        }
        else if (path == "/employees" || path == "/staff" || path.StartsWith("/employee/"))
        {
            targetPath = "/employees";
        }
        else
        {
            targetPath = "/devices";
        }

        bool isSamePage = path == targetPath;
        string targetUrl = string.IsNullOrWhiteSpace(globalSearchTerm) 
            ? targetPath 
            : $"{targetPath}?search={Uri.EscapeDataString(globalSearchTerm)}";

        NavigationManager.NavigateTo(targetUrl, forceLoad: false, replace: isSamePage);
    }

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
        SyncSearchTermFromUrl();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SyncSearchTermFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSearchTermFromUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("search", out var searchValues))
        {
            // Do not trigger the setter here to avoid infinite loops
            globalSearchTerm = searchValues.ToString();
        }
        else
        {
            globalSearchTerm = "";
        }
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        searchDebounceTimer?.Dispose();
    }
}




